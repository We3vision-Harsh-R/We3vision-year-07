generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// One row per editable website page. `draft` is what the editor works on,
// `published` is what visitors see. Both hold { sections: [...] } JSON.
model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  seoTitle       String        @default("")
  seoDescription String        @default("")
  draft          Json?
  published      Json?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       PageVersion[]
}

// Snapshot taken on every publish (we keep the latest 10 per page).
model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

// Key/value JSON store for site-wide settings (key "site" = logo text, contact, nav, footer).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// An uploaded picture (the admin panel resizes it to a light .webp before uploading). Served by /media/<id>; the id never changes
// content, a replaced picture gets a new id, so the browser may keep it for a year.
model Media {
  id        String   @id @default(cuid())
  name      String   @default("")
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// One portfolio project (a client work). The pictures are links (/media/<id> for uploaded ones). \`group\` says where it is shown:
// "brand" = the sliding arches of the Brand Design page; every published project is also on the Portfolio page.
model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String   @default("")
  summary   String   @default("")
  content   String   @default("")
  cover     String   @default("")
  images    Json     @default("[]")
  group     String   @default("brand")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, sortOrder])
}
