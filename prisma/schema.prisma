generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  aiConnections AiConnection[]
}

// One row per editable website page. `draft` is what the editor works on,
// `published` is what visitors see. Both hold { sections: [...] } JSON.
model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  seoTitle       String        @default("")
  seoDescription String        @default("")
  draft          Json?
  published      Json?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       PageVersion[]
}

// Snapshot taken on every publish (we keep the latest 10 per page).
model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

// Key/value JSON store for site-wide settings (key "site" = logo text, contact, nav, footer).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// An uploaded picture (the admin panel resizes it to a light .webp before uploading). Served by /media/<id>; the id never changes
// content, a replaced picture gets a new id, so the browser may keep it for a year.
model Media {
  id        String   @id @default(cuid())
  name      String   @default("")
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// One portfolio project (a client work). The pictures are links (/media/<id> for uploaded ones). \`group\` says where it is shown:
// "brand" = the sliding arches of the Brand Design page; every published project is also on the Portfolio page.
model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String   @default("")
  summary   String   @default("")
  content   String   @default("")
  cover     String   @default("")
  images    Json     @default("[]")
  group     String   @default("brand")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, sortOrder])
}

// One article of the blog (Blog in the admin panel). \`cover\` is a link (/media/<id> for an uploaded picture); \`tile\` is the shape of its picture
// on the Blog page (landscape, square, portrait or tall); \`content\` is the article in a light text markup (## heading, - point, empty line between
// paragraphs); \`faq\` is a list of { question, answer }; \`sortOrder\` is the place in the list of the Blog page (smaller = earlier).
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("")
  summary     String   @default("")
  cover       String   @default("")
  tile        String   @default("portrait")
  content     String   @default("")
  tags        Json     @default("[]")
  faq         Json     @default("[]")
  publishedAt DateTime @default(now())
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

// One person of the office on the Team page (Team in the admin panel). `dept` is the department (the people of one department sit in one
// corner of the office, in the order of `sortOrder`); `photo` is a link (/media/<id> for an uploaded picture); `girl` draws the avatar as a woman.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  dept      String   @default("Team")
  bio       String   @default("")
  photo     String   @default("")
  linkedin  String   @default("")
  girl      Boolean  @default(false)
  /// the seat in the office (-1 = automatic: in the order of the list); see lib/team-seats.ts
  seat      Int      @default(-1)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// The Careers page (Careers in the admin panel): the open positions a visitor can choose as the "destination" of the ticket, the extra
// questions of HR for the passenger details, and the tickets (applications) that visitors book. The city is the only thing that must be
// there when a seat is booked (stage "booked"); the passenger details come after it (stage "complete").
/// A job opening: shown in the list on the Careers page, has its own page (/careers/<slug>), and is a destination of the ticket.
model CareerRole {
  id               String   @id @default(cuid())
  title            String
  team             String   @default("")
  /// open (shown on the site) or closed
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  slug             String   @unique @default("")
  /// one or two lines for the card in the list
  summary          String   @default("")
  /// about the role: paragraphs separated by an empty line
  description      String   @default("")
  responsibilities Json     @default("[]")
  requirements     Json     @default("[]")
  perks            Json     @default("[]")
  location         String   @default("Surat, India")
  /// Full-time | Part-time | Internship | Contract
  workType         String   @default("Full-time")
  /// On-site | Hybrid | Remote
  workMode         String   @default("On-site")
  experience       String   @default("")
  openings         Int      @default(1)
  salary           String   @default("")
  /// yyyy-mm-dd or empty
  closesAt         String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
}

model CareerQuestion {
  id        String   @id @default(cuid())
  label     String
  /// text | textarea | select | yesno
  kind      String   @default("text")
  options   Json     @default("[]")
  required  Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model CareerApplication {
  id            String   @id @default(cuid())
  city          String
  currentStatus String   @default("")
  roleId        String   @default("")
  roleTitle     String   @default("")
  joinDate      String   @default("")
  noticePeriod  String   @default("")
  callSlot      String   @default("")
  resume        String   @default("")
  name          String   @default("")
  email         String   @default("")
  phone         String   @default("")
  linkedin      String   @default("")
  skills        String   @default("")
  experience    String   @default("")
  answers       Json     @default("[]")
  /// booked (seat booked, city known) | complete (passenger details given)
  stage         String   @default("booked")
  /// ticket (the ticket office) | job (the apply form of a job page)
  source        String   @default("ticket")
  /// new | contacted | interview | hired | rejected
  status        String   @default("new")
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([roleId])
}

// ---------------------------------------------------------------------------------------------------------------------------------
// AI integration (Admin > AI Integrations, Admin > AI Submissions). An AI tool (Claude, Cursor, ChatGPT …) connects to /api/mcp with a
// connection and can ONLY create submissions that wait for approval. See brain/20-ai-integration.md and docs/MCP_SETUP.md.
// ---------------------------------------------------------------------------------------------------------------------------------

/// One connection of an AI tool = one admin's grant. `kind` is "token" (a personal access token the admin copied) or "oauth" (the tool
/// signed in through the consent screen). Tokens are stored only as SHA-256 hashes. Revoking (revokedAt) works at once.
model AiConnection {
  id              String              @id @default(cuid())
  name            String
  kind            String              @default("token")
  adminId         String
  admin           AdminUser           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// SHA-256 of the access token
  tokenHash       String              @unique
  /// the first characters of the token, to recognise it in the list
  tokenHint       String              @default("")
  /// oauth only: SHA-256 of the refresh token
  refreshHash     String?             @unique
  /// oauth only: when the access token stops working (the tool then refreshes it)
  accessExpiresAt DateTime?
  /// space separated: content:submit content:read
  scopes          String              @default("content:submit content:read")
  /// oauth only: the client that was registered by the tool
  clientId        String              @default("")
  /// the whole connection stops working at this time (empty = until revoked)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime            @default(now())
  submissions     ContentSubmission[]

  @@index([adminId])
}

/// A client that registered itself (OAuth dynamic client registration). Public clients only: PKCE is required.
model OauthClient {
  id           String   @id
  name         String
  redirectUris Json     @default("[]")
  createdAt    DateTime @default(now())
}

/// A one-time authorization code (10 minutes), stored as a hash.
model OauthCode {
  codeHash      String    @id
  clientId      String
  adminId       String
  redirectUri   String
  codeChallenge String
  scopes        String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

/// A piece of content an AI tool sent. `data` is the validated draft (fields of src/lib/ai-content/registry.ts). Status:
/// pending_review | approved | rejected | draft (approved by an admin but saved hidden). Nothing is live until an admin approves.
model ContentSubmission {
  id             String            @id @default(cuid())
  contentType    String
  title          String            @default("")
  data           Json
  status         String            @default("pending_review")
  connectionId   String?
  connection     AiConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// name of the connection at the time (stays when the connection is deleted)
  connectionName String            @default("")
  reviewedBy     String            @default("")
  reviewedAt     DateTime?
  rejectReason   String            @default("")
  /// the live item made on approval (BlogPost / CareerRole id and its address)
  entityId       String            @default("")
  entitySlug     String            @default("")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  events         SubmissionEvent[]

  @@index([status, createdAt])
  @@index([connectionId])
}

/// The audit log of a submission: who did what and when (a connection by name, an admin by e-mail).
model SubmissionEvent {
  id           String            @id @default(cuid())
  submissionId String
  submission   ContentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// submitted | edited | approved | saved_draft | rejected
  action       String
  actor        String
  note         String            @default("")
  at           DateTime          @default(now())

  @@index([submissionId, at])
}
