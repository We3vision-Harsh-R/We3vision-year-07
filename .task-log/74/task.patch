+"use client";
+
+import { useState } from "react";
+import { GlowEdge } from "../glow-edge";
+import { Reveal } from "../reveal";
+import { VHead, two, useCycle } from "./variant-kit";
+
+// The questions in six more designs (the first one is faq-split.tsx), one for every service page. All of them tell Google about the questions
+// (FAQPage). The look is in globals.css (.vf-*).
+
+type Q = { question: string; answer: string };
+type P = { chip: string; heading: string; intro?: string; items: Q[] };
+
+function Json({ items }: { items: Q[] }) {
+  const json = {
+    "@context": "https://schema.org",
+    "@type": "FAQPage",
+    mainEntity: items.map((q) => ({ "@type": "Question", name: q.question, acceptedAnswer: { "@type": "Answer", text: q.answer } })),
+  };
+  return <script type="application/ld+json" dangerouslySetInnerHTML={{ __html: JSON.stringify(json).replace(/</g, "\\u003c") }} />;
+}
+
+/** 1: a stack of wide bars, one open at a time */
+function Stack({ chip, heading, intro, items }: P) {
+  const [open, setOpen] = useState<number | null>(0);
+  return (
+    <div className="md vf vf-stack">
+      <Json items={items} />
+      <VHead chip={chip} heading={heading} intro={intro} center />
+      <div className="vf-sk-list">
+        {items.map((q, i) => (
+          <div key={i} className="vf-sk-item" data-open={open === i}>
+            <button type="button" aria-expanded={open === i} onClick={() => setOpen(open === i ? null : i)}>
+              <span>{two(i + 1)}</span>
+              <b>{q.question}</b>
+              <i aria-hidden />
+            </button>
+            <div className="vf-sk-body">
+              <p>{q.answer}</p>
+            </div>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+/** 2: every question is a card and every answer is open, in two columns */
+function Cards({ chip, heading, intro, items }: P) {
+  return (
+    <div className="md vf vf-cards">
+      <Json items={items} />
+      <VHead chip={chip} heading={heading} intro={intro} center />
+      <div className="vf-cd-grid">
+        {items.map((q, i) => (
+          <Reveal key={i} delay={(i % 2) * 70}>
+            <article className="vf-cd bglow">
+              <GlowEdge />
+              <span className="vf-cd-q" aria-hidden>
+                Q
+              </span>
+              <h3>{q.question}</h3>
+              <p>{q.answer}</p>
+            </article>
+          </Reveal>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+/** 3: a chat: the visitor picks a question and the answer is written back, with the three dots of someone who is typing */
+function Chat({ chip, heading, intro, items }: P) {
+  const { active, pick, ref } = useCycle(items.length, 7200);
+  const q = items[active];
+  return (
+    <div ref={ref} className="md vf vf-chat">
+      <Json items={items} />
+      <VHead chip={chip} heading={heading} intro={intro} />
+      <div className="vf-ch-grid">
+        <ul className="vf-ch-list" role="tablist" aria-label={chip}>
+          {items.map((it, i) => (
+            <li key={i}>
+              <button
+                type="button"
+                role="tab"
+                aria-selected={i === active}
+                data-on={i === active}
+                onClick={() => pick(i)}
+              >
+                {it.question}
+              </button>
+            </li>
+          ))}
+        </ul>
+        <div className="vf-ch-win" role="tabpanel">
+          <div className="vf-ch-top" aria-hidden>
+            <i />
+            <b>We3vision</b>
+            <small>usually answers at once</small>
+          </div>
+          <div key={active} className="vf-ch-body">
+            <p className="vf-ch-msg vf-ch-you">{q.question}</p>
+            {/* the three dots of someone who is writing show for a moment, then the answer comes in (both are in CSS) */}
+            <p className="vf-ch-msg vf-ch-bot vf-ch-dots" aria-hidden>
+              <i />
+              <i />
+              <i />
+            </p>
+            <p className="vf-ch-msg vf-ch-bot vf-ch-ans">{q.answer}</p>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/** 4: the questions in a list, the answer of the open one as a large panel */
+function TabsFaq({ chip, heading, intro, items }: P) {
+  const { active, pick, ref } = useCycle(items.length, 8000);
+  const q = items[active];
+  return (
+    <div ref={ref} className="md vf vf-tabs">
+      <Json items={items} />
+      <div className="vf-tb-list">
+        <VHead chip={chip} heading={heading} intro={intro} />
+        <ol role="tablist" aria-label={chip}>
+          {items.map((it, i) => (
+            <li key={i}>
+              <button type="button" role="tab" aria-selected={i === active} data-on={i === active} onClick={() => pick(i)}>
+                {it.question}
+              </button>
+            </li>
+          ))}
+        </ol>
+      </div>
+      <div key={active} className="vf-tb-panel bglow" role="tabpanel">
+        <GlowEdge />
+        <span className="vf-tb-mark" aria-hidden>
+          “
+        </span>
+        <span className="vf-tb-no">
+          {two(active + 1)} / {two(items.length)}
+        </span>
+        <h3>{q.question}</h3>
+        <p>{q.answer}</p>
+      </div>
+    </div>
+  );
+}
+
+/** 5: cards that turn over: the question in front, the answer behind */
+function Flip({ chip, heading, intro, items }: P) {
+  const [on, setOn] = useState<Record<number, boolean>>({});
+  return (
+    <div className="md vf vf-flip">
+      <Json items={items} />
+      <VHead chip={chip} heading={heading} intro={intro} center />
+      <p className="vf-fl-hint">Tap a card to turn it over</p>
+      <ul className="vf-fl-grid">
+        {items.map((q, i) => (
+          <li key={i}>
+            <button type="button" aria-pressed={!!on[i]} data-flip={!!on[i]} onClick={() => setOn((o) => ({ ...o, [i]: !o[i] }))}>
+              <span className="vf-fl-in">
+                <span className="vf-fl-face vf-fl-front">
+                  <em>{two(i + 1)}</em>
+                  <b>{q.question}</b>
+                </span>
+                <span className="vf-fl-face vf-fl-back">
+                  <small>Answer</small>
+                  <span>{q.answer}</span>
+                </span>
+              </span>
+            </button>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
+
+/** 6: like a magazine: the number, the question and the answer in three columns, all of it open */
+function Editorial({ chip, heading, intro, items }: P) {
+  return (
+    <div className="md vf vf-ed">
+      <Json items={items} />
+      <VHead chip={chip} heading={heading} intro={intro} />
+      <div className="vf-ed-list">
+        {items.map((q, i) => (
+          <Reveal key={i} delay={40}>
+            <div className="vf-ed-row">
+              <span aria-hidden>{two(i + 1)}</span>
+              <h3>{q.question}</h3>
+              <p>{q.answer}</p>
+            </div>
+          </Reveal>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+/** the design of the page: 1..6 (0 is faq-split.tsx) */
+export function FaqVariant({ variant, ...p }: P & { variant: number }) {
+  if (p.items.length === 0) return null;
+  switch (variant) {
+    case 1:
+      return <Stack {...p} />;
+    case 2:
+      return <Cards {...p} />;
+    case 3:
+      return <Chat {...p} />;
+    case 4:
+      return <TabsFaq {...p} />;
+    case 5:
+      return <Flip {...p} />;
+    default:
+      return <Editorial {...p} />;
+  }
+}
diff --git a/b/src/components/site/modern/process-variants.tsx b/b/src/components/site/modern/process-variants.tsx
new file mode 100644
index 0000000..6a6eff7
--- /dev/null
+++ b/b/src/components/site/modern/process-variants.tsx
@@ -0,0 +1,278 @@
+"use client";
+
+import { GlowEdge } from "../glow-edge";
+import { Reveal } from "../reveal";
+import { VHead, lines, two, useCycle } from "./variant-kit";
+
+// "How we work" in seven more designs (the first one is process-rail.tsx), one for every service page, so that no two pages show their steps the
+// same way. All of them get the same steps: a title, a text and (when there are) points. The look is in globals.css (.vp-*).
+
+type Step = { title: string; text: string; points?: string };
+type P = { chip: string; heading: string; intro?: string; items: Step[] };
+
+const plain = (s: string) => s.replace(/\s*\n\s*/g, " ");
+
+function Points({ s }: { s: Step }) {
+  const pts = lines(s.points);
+  if (!pts.length) return null;
+  return (
+    <ul className="vp-pts">
+      {pts.map((t) => (
+        <li key={t}>{t}</li>
+      ))}
+    </ul>
+  );
+}
+
+/** 1: a row of numbered steps on a line that fills, the open step is read in a panel under it */
+function Stepper({ chip, heading, intro, items }: P) {
+  const n = items.length;
+  const { active, pick, ref, run } = useCycle(n, 5600);
+  const s = items[active];
+  return (
+    <div ref={ref} className="md vp vp-stepper">
+      <VHead chip={chip} heading={heading} intro={intro} center />
+      <ol className="vp-st-track" style={{ "--n": n, "--i": active } as React.CSSProperties}>
+        <span className="vp-st-line" aria-hidden>
+          <i data-run={run} />
+        </span>
+        {items.map((it, i) => (
+          <li key={i} data-on={i === active} data-done={i < active}>
+            <button type="button" onClick={() => pick(i)} aria-label={`Step ${i + 1}: ${plain(it.title)}`}>
+              <span>{two(i + 1)}</span>
+            </button>
+            <b>{plain(it.title)}</b>
+          </li>
+        ))}
+      </ol>
+      <div key={active} className="vp-st-panel bglow">
+        <GlowEdge />
+        <span className="vp-st-no">Step {two(active + 1)}</span>
+        <h3>{plain(s.title)}</h3>
+        <p>{s.text}</p>
+        <Points s={s} />
+      </div>
+    </div>
+  );
+}
+
+/** 2: a line in the middle, the steps come out of it to the left and to the right, one after the other */
+function Zigzag({ chip, heading, intro, items }: P) {
+  return (
+    <div className="md vp vp-zz">
+      <VHead chip={chip} heading={heading} intro={intro} center />
+      <ol className="vp-zz-list">
+        {items.map((it, i) => (
+          <li key={i} data-side={i % 2 ? "r" : "l"}>
+            <span className="vp-zz-dot" aria-hidden>
+              {two(i + 1)}
+            </span>
+            <Reveal delay={60}>
+              <article className="vp-zz-card bglow">
+                <GlowEdge />
+                <h3>{plain(it.title)}</h3>
+                <p>{it.text}</p>
+                <Points s={it} />
+              </article>
+            </Reveal>
+          </li>
+        ))}
+      </ol>
+    </div>
+  );
+}
+
+/** 3: the steps go down like a staircase, every one a step to the right of the one before it */
+function Stairs({ chip, heading, intro, items }: P) {
+  const n = items.length;
+  return (
+    <div className="md vp vp-stairs" style={{ "--n": n } as React.CSSProperties}>
+      <VHead chip={chip} heading={heading} intro={intro} />
+      <ol className="vp-ss-list">
+        {items.map((it, i) => (
+          <li key={i} style={{ "--i": i } as React.CSSProperties}>
+            <Reveal delay={40}>
+              <article className="vp-ss-card bglow">
+                <GlowEdge />
+                <span className="vp-ss-no" aria-hidden>
+                  {two(i + 1)}
+                </span>
+                <div>
+                  <h3>{plain(it.title)}</h3>
+                  <p>{it.text}</p>
+                  <Points s={it} />
+                </div>
+              </article>
+            </Reveal>
+          </li>
+        ))}
+      </ol>
+    </div>
+  );
+}
+
+/** 4: big rows with the number and the name; the open one shows its text and its points side by side */
+function Rows({ chip, heading, intro, items }: P) {
+  const { active, pick, ref } = useCycle(items.length, 6200);
+  return (
+    <div ref={ref} className="md vp vp-rows">
+      <aside>
+        <VHead chip={chip} heading={heading} intro={intro} />
+      </aside>
+      <ol className="vp-rw-list">
+        {items.map((it, i) => (
+          <li key={i} data-on={i === active}>
+            <button type="button" aria-expanded={i === active} onClick={() => pick(i)}>
+              <span className="vp-rw-no">{two(i + 1)}</span>
+              <span className="vp-rw-t">{plain(it.title)}</span>
+              <span className="vp-rw-plus" aria-hidden />
+            </button>
+            <div className="vp-rw-body" data-open={i === active}>
+              <div className="vp-rw-in">
+                <p>{it.text}</p>
+                <Points s={it} />
+              </div>
+            </div>
+          </li>
+        ))}
+      </ol>
+    </div>
+  );
+}
+
+/** 5: the steps are the points of a ring; the open one is explained next to it */
+function Ring({ chip, heading, intro, items }: P) {
+  const n = items.length;
+  const { active, pick, ref } = useCycle(n, 4800);
+  const s = items[active];
+  return (
+    <div ref={ref} className="md vp vp-ring">
+      <VHead chip={chip} heading={heading} intro={intro} center />
+      <div className="vp-rg-grid">
+        <div className="vp-rg-wheel" role="tablist" aria-label={chip}>
+          <span className="vp-rg-orbit" aria-hidden />
+          <span className="vp-rg-core" aria-hidden>
+            <b>{two(active + 1)}</b>
+            <small>of {two(n)}</small>
+          </span>
+          {items.map((it, i) => {
+            const a = (i / n) * Math.PI * 2 - Math.PI / 2;
+            return (
+              <button
+                key={i}
+                type="button"
+                role="tab"
+                aria-selected={i === active}
+                data-on={i === active}
+                data-done={i < active}
+                aria-label={plain(it.title)}
+                style={{ left: `${50 + Math.cos(a) * 42}%`, top: `${50 + Math.sin(a) * 42}%` }}
+                onClick={() => pick(i)}
+              >
+                {two(i + 1)}
+              </button>
+            );
+          })}
+        </div>
+        <div key={active} className="vp-rg-panel bglow" role="tabpanel">
+          <GlowEdge />
+          <h3>{plain(s.title)}</h3>
+          <p>{s.text}</p>
+          <Points s={s} />
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/** 6: a list of steps on the left with a bar that fills, the open step as a large panel on the right */
+function TabsSteps({ chip, heading, intro, items }: P) {
+  const n = items.length;
+  const { active, pick, ref, run } = useCycle(n, 6000);
+  const s = items[active];
+  return (
+    <div ref={ref} className="md vp vp-tabs">
+      <div className="vp-tb-side">
+        <VHead chip={chip} heading={heading} intro={intro} />
+        <ol className="vp-tb-list" role="tablist" aria-label={chip}>
+          {items.map((it, i) => (
+            <li key={i}>
+              <button type="button" role="tab" aria-selected={i === active} data-on={i === active} onClick={() => pick(i)}>
+                <span>{two(i + 1)}</span>
+                {plain(it.title)}
+                <i aria-hidden data-run={run && i === active} />
+              </button>
+            </li>
+          ))}
+        </ol>
+      </div>
+      <div key={active} className="vp-tb-panel bglow" role="tabpanel">
+        <GlowEdge />
+        <span className="vp-tb-mark" aria-hidden>
+          {two(active + 1)}
+        </span>
+        <h3>{plain(s.title)}</h3>
+        <p>{s.text}</p>
+        <Points s={s} />
+      </div>
+    </div>
+  );
+}
+
+/** 7: a board: a pipeline of the steps on top, under it a column for every step with its points as cards */
+function Board({ chip, heading, intro, items }: P) {
+  return (
+    <div className="md vp vp-board">
+      <VHead chip={chip} heading={heading} intro={intro} center />
+      <ol className="vp-bd-pipe" aria-hidden>
+        {items.map((it, i) => (
+          <li key={i}>{plain(it.title)}</li>
+        ))}
+      </ol>
+      <div className="vp-bd-cols" style={{ "--n": items.length } as React.CSSProperties}>
+        {items.map((it, i) => (
+          <Reveal key={i} delay={(i % 3) * 70}>
+            <section className="vp-bd-col">
+              <header>
+                <span>{two(i + 1)}</span>
+                <h3>{plain(it.title)}</h3>
+              </header>
+              <p>{it.text}</p>
+              {lines(it.points).length > 0 && (
+                <ul className="vp-bd-cards">
+                  {lines(it.points).map((t) => (
+                    <li key={t}>{t}</li>
+                  ))}
+                </ul>
+              )}
+              <div className="vp-bd-bar" aria-hidden>
+                <i style={{ width: `${Math.round(((i + 1) / items.length) * 100)}%` }} />
+              </div>
+            </section>
+          </Reveal>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+/** the design of the page: 1..7 (0 is the rail, process-rail.tsx) */
+export function ProcessVariant({ variant, ...p }: P & { variant: number }) {
+  if (p.items.length === 0) return null;
+  switch (variant) {
+    case 1:
+      return <Stepper {...p} />;
+    case 2:
+      return <Zigzag {...p} />;
+    case 3:
+      return <Stairs {...p} />;
+    case 4:
+      return <Rows {...p} />;
+    case 5:
+      return <Ring {...p} />;
+    case 6:
+      return <TabsSteps {...p} />;
+    default:
+      return <Board {...p} />;
+  }
+}
