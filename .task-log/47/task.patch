+                  Remove
+                </button>
+              </div>
+              <label className={labelClass}>
+                Name
+                <input className={inputClass} value={current.name} maxLength={60} onChange={(e) => patch(current.id, { name: e.target.value })} />
+              </label>
+              <div className="grid gap-4 sm:grid-cols-2">
+                <label className={labelClass}>
+                  Role
