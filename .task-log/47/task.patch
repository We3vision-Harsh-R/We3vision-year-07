+          <p role="status" className={`rounded-lg px-3 py-2 text-sm ${result.ok ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-700"}`}>
+            {result.ok ? result.message : result.error}
+          </p>
+        )}
+      </div>
+    </div>
+  );
+}
