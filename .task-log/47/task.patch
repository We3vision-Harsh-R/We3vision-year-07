+                </label>
+                <label className={labelClass}>
+                  Department
+                  <input className={inputClass} list="team-depts" value={current.dept} maxLength={30} onChange={(e) => patch(current.id, { dept: e.target.value })} />
+                  <datalist id="team-depts">
+                    {depts.map((d) => (
+                      <option key={d} value={d} />
+                    ))}
+                  </datalist>
+                </label>
+              </div>
+              <p className="-mt-2 text-xs text-zinc-400">People with the same department sit in the same corner. Type a new name to open a new corner.</p>
+              <label className={labelClass}>
+                A few words about the person
+                <textarea className={`${inputClass} min-h-24`} value={current.bio} maxLength={260} onChange={(e) => patch(current.id, { bio: e.target.value })} />
