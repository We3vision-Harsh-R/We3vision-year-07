index 6278514..4f6a220 100644
--- a/a/src/app/globals.css
+++ b/b/src/app/globals.css
@@ -16674,3 +16674,178 @@ a.md-rel-card:hover .md-rel-go {
     height: 70px;
   }
 }
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The street of the panda on the home page (home-street.tsx): a pavement, a lamp at every service whose light has the colour of the service
+   and falls on the panda (the script sets --lit on the lamps and --plit on the panda), and between the services bamboo, trees, benches,
+   flowers and fireflies. All of it stands on the rail and comes in together with it. */
+.st {
+  --u: 1;
+  position: absolute;
+  top: 0;
+  right: 0;
+  left: 0;
+  height: 0;
+  pointer-events: none;
+}
+.st > i,
+.st b {
+  display: block;
+  font-style: normal;
+  font-weight: normal;
+}
+.st-walk {
+  position: absolute;
+  top: 1px;
+  right: 2%;
+  left: 2%;
+  height: 17px;
+  border-radius: 0 0 9px 9px;
+  background:
+    repeating-linear-gradient(90deg, transparent 0 51px, rgba(255, 255, 255, 0.07) 51px 52px),
+    linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.015));
+  -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
+  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
+}
+.st-item {
+  position: absolute;
+  bottom: -1px;
+  left: calc((100% - (var(--n, 7) - 1) * 8px) / var(--n, 7) * (var(--i) + 0.5) + var(--i) * 8px + var(--dx, 0px));
+  line-height: 0;
+  opacity: 0.94;
+  transform: translateX(-50%) scale(var(--u));
+  transform-origin: 50% 100%;
+}
+.st-item[data-k="bench"],
+.st-item[data-k="flowers"],
+.st-item[data-k="bush"] {
+  opacity: 1;
+}
+.st-lamp {
+  position: absolute;
+  bottom: -1px;
+  left: calc((100% - (var(--n, 7) - 1) * 8px) / var(--n, 7) * (var(--i) + 0.5) + var(--i) * 8px + 19px);
+  width: 70px;
+  height: 120px;
+  line-height: 0;
+  transform: scale(var(--u));
+  transform-origin: 50% 100%;
+}
+.st-lamp svg {
+  position: relative;
+  display: block;
+}
+/* the glow round the lantern, the cone of light and the pool of light on the ground (their strength is --lit) */
+.st-lamp::before {
+  content: "";
+  position: absolute;
+  top: -8px;
+  left: -16px;
+  width: 60px;
+  height: 60px;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, var(--lc), transparent);
+  opacity: calc(0.25 + 0.6 * var(--lit));
+}
+.st-cone {
+  position: absolute;
+  top: 24px;
+  left: -60px;
+  width: 140px;
+  height: 94px;
+  background: linear-gradient(180deg, color-mix(in srgb, var(--lc) 78%, transparent), transparent 96%);
+  clip-path: polygon(47% 0, 59% 0, 100% 100%, 0 100%);
+  filter: blur(1.5px);
+  mix-blend-mode: screen;
+  opacity: calc(0.1 + 0.72 * var(--lit));
+}
+.st-pool {
+  position: absolute;
+  bottom: -8px;
+  left: -64px;
+  width: 150px;
+  height: 18px;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, var(--lc), transparent);
+  opacity: calc(0.08 + 0.55 * var(--lit));
+}
+.st-bulb {
+  animation: st-bulb 2.6s ease-in-out infinite;
+  animation-delay: calc(var(--b) * -0.4s);
+}
+@keyframes st-bulb {
+  0%,
+  100% {
+    opacity: 0.35;
+  }
+  50% {
+    opacity: 1;
+  }
+}
+.st-fly {
+  position: absolute;
+  bottom: calc(22px + var(--f) * 8px);
+  left: calc(4% + var(--f) * 11%);
+  width: 4px;
+  height: 4px;
+  border-radius: 50%;
+  background: var(--lc);
+  box-shadow: 0 0 9px 2px var(--lc);
+  opacity: 0;
+  animation: st-fly 7s ease-in-out infinite;
+  animation-delay: calc(var(--f) * -0.9s);
+}
+@keyframes st-fly {
+  0%,
+  100% {
+    opacity: 0;
+    transform: translate(0, 0);
+  }
+  20% {
+    opacity: 0.95;
+  }
+  50% {
+    opacity: 0.5;
+    transform: translate(16px, -12px);
+  }
+  80% {
+    opacity: 0.95;
+    transform: translate(-6px, -4px);
+  }
+}
+/* the light of the lamp on the panda */
+.pw-lit {
+  opacity: var(--plit, 0.5);
+  mix-blend-mode: screen;
+}
+.pw-tail {
+  transform-box: fill-box;
+  transform-origin: 100% 50%;
+  animation: pw-flutter 0.34s ease-in-out infinite alternate paused;
+}
+.hub-av[data-state="walk"] .pw-tail {
+  animation-play-state: running;
+}
+@keyframes pw-flutter {
+  from {
+    transform: rotate(-9deg);
+  }
+  to {
+    transform: rotate(9deg);
+  }
+}
+@media (min-width: 700px) and (max-height: 720px) {
+  .st {
+    --u: 0.74;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .st-bulb,
+  .st-fly,
+  .pw-tail {
+    animation: none;
+  }
+  .st-fly {
+    opacity: 0.6;
+  }
+}
