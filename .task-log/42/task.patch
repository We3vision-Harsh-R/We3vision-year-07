@@ -17625,3 +17625,107 @@ a.md-rel-card:hover .md-rel-go {
     font-size: 1.05rem;
   }
 }
+
+/* the button of the global reach card: a clear, bright call to action with an arrow that moves on hover */
+.rp-cta {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  height: 56px;
+  padding: 0 30px 0 32px;
+  border-radius: 999px;
+  background: linear-gradient(135deg, hsl(calc(var(--th) + 76) calc(81% * var(--ts)) 87%), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%) 70%);
+  box-shadow:
+    0 12px 34px -10px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.7),
+    inset 0 1px 0 rgba(255, 255, 255, 0.5);
+  color: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 12%);
+  font-size: 1.0625rem;
+  font-weight: 600;
+  text-decoration: none;
+  transition:
+    transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+    box-shadow 0.3s,
+    filter 0.3s;
+}
+.rp-cta svg {
+  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.rp-cta:hover {
+  transform: translateY(-2px);
+  filter: brightness(1.06);
+  box-shadow:
+    0 18px 40px -10px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.85),
+    inset 0 1px 0 rgba(255, 255, 255, 0.6);
+}
+.rp-cta:hover svg {
+  transform: translateX(4px);
+}
+.rp-cta:focus-visible {
+  outline: 2px solid #fff;
+  outline-offset: 3px;
+}
+.rp-label {
+  margin: 0;
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84%);
+  font-size: 0.875rem;
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   "Why We3vision" as wide as the screen: the list on the left and the reasons on the right use the whole width (a gutter at both sides), and the
+   words and the numbers grow with the screen, so that a big monitor is not left with an empty space round a narrow block. */
+@media (min-width: 1024px) {
+  .rs {
+    max-width: none;
+    padding-inline: clamp(1.5rem, 5vw, 7rem);
+    grid-template-columns: clamp(23rem, 24vw, 36rem) minmax(0, 1fr);
+    gap: clamp(3rem, 5vw, 8rem);
+  }
+  .rs-title {
+    font-size: clamp(3rem, 4.4vw, 5.6rem);
+  }
+  .rs-card h3 {
+    font-size: clamp(2rem, 3vw, 3.8rem);
+  }
+  .rs-card p {
+    max-width: min(46rem, 90%);
+    font-size: clamp(1.125rem, 1.25vw, 1.6rem);
+  }
+  .rs-no {
+    font-size: clamp(11rem, 12vw, 20rem);
+  }
+}
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .rs {
+    padding-inline: 0;
+  }
+  .rs-pin {
+    max-width: none;
+    grid-template-columns: clamp(23rem, 24vw, 36rem) minmax(0, 1fr);
+    gap: clamp(3rem, 5vw, 8rem);
+    padding-inline: clamp(1.5rem, 5vw, 7rem);
+  }
+}
+
+/* the global reach section has no box any more: a big soft light behind the globe blends it into the background */
+.rp-glow {
+  position: absolute;
+  top: 50%;
+  right: 4%;
+  width: min(75vw, 900px);
+  aspect-ratio: 1;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.22), hsl(calc(var(--th) + 350) calc(80% * var(--ts)) 40% / 0.1) 55%, transparent 100%);
+  pointer-events: none;
+  transform: translateY(-50%);
+}
+@media (max-width: 767px) {
+  .rp-glow {
+    top: auto;
+    right: 50%;
+    bottom: 0;
+    width: 120vw;
+    transform: translate(50%, 20%);
+  }
+}
