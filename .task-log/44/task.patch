+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Big screens: "Why We3vision" keeps the size it has on a laptop (a block of at most 1440 px, in the middle, with small gutters), it does not
+   grow with a wide monitor. On a laptop it uses the whole width. */
+@media (min-width: 1024px) {
+  .rs {
+    max-width: 1440px;
+    padding-inline: clamp(1.5rem, 3vw, 3rem);
+  }
+}
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .rs {
+    max-width: none;
+    padding-inline: 0;
+  }
+  .rs-pin {
+    max-width: 1440px;
+    padding-inline: clamp(1.5rem, 3vw, 3rem);
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The contact section as a short conversation (contact-flow.tsx): no box. Tiles you pick, chips, three fields and a brief that fills in. */
+.cf {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.88);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.18);
+  display: grid;
+  gap: 2.4rem;
+}
+@media (min-width: 900px) {
+  .cf {
+    grid-template-columns: minmax(0, 1fr) 17rem;
+    gap: 3.4rem;
+  }
+}
+.cf-progress {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 8px;
+}
+.cf-progress span {
+  height: 4px;
+  border-radius: 4px;
+  background: var(--hair);
+  transition: background 0.5s, box-shadow 0.5s;
+}
+.cf-progress span[data-on="true"] {
+  background: linear-gradient(90deg, var(--a), hsl(calc(var(--th) + 330) calc(80% * var(--ts)) 66%));
+  box-shadow: 0 0 14px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.6);
+}
+.cf-step {
+  margin: 0.9rem 0 0;
+  color: var(--a);
+  font-size: 0.9rem;
+  font-weight: 600;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+.cf-pane {
+  animation: cf-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+@keyframes cf-in {
+  from {
+    opacity: 0;
+    transform: translateX(26px);
+  }
+}
+.cf-q {
+  margin: 1.4rem 0 0;
+  color: #fff;
+  font-size: clamp(1.7rem, 3.4vw, 2.5rem);
+  font-weight: 600;
+  letter-spacing: -0.03em;
+  line-height: 1.15;
+}
+.cf-hint {
+  margin: 0.5rem 0 0;
+  color: var(--soft);
+  font-size: 1.0625rem;
+}
+.cf-tiles {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+  margin-top: 1.6rem;
+}
+@media (min-width: 640px) {
+  .cf-tiles {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+  }
+}
+.cf-tile {
+  --rx: 0deg;
+  --ry: 0deg;
+  position: relative;
+  display: grid;
+  gap: 12px;
+  justify-items: start;
+  padding: 1.1rem 1rem 1.15rem;
+  border: 1px solid var(--hair);
+  border-radius: 20px;
+  background: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 11% / 0.55);
+  color: #fff;
+  font: inherit;
+  font-size: 1.0625rem;
+  font-weight: 500;
+  text-align: left;
+  cursor: pointer;
+  transform: perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));
+  transition:
+    transform 0.25s ease-out,
+    border-color 0.3s,
+    background 0.3s,
+    box-shadow 0.3s;
+}
+.cf-tile:hover {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.5);
+}
+.cf-ic {
+  width: 30px;
+  height: 30px;
+  fill: none;
+  stroke: var(--a);
+  stroke-width: 1.7;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.cf-tile:hover .cf-ic {
+  transform: translateY(-3px) scale(1.08);
+}
+.cf-tick {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+  width: 20px;
+  height: 20px;
+  border: 1.5px solid var(--hair);
+  border-radius: 50%;
+  transition: background 0.3s, border-color 0.3s, transform 0.3s;
+}
+.cf-tile[aria-pressed="true"] {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82% / 0.85);
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.34), hsl(calc(var(--th) + 340) calc(70% * var(--ts)) 40% / 0.26));
+  box-shadow: 0 0 28px -4px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.55);
+}
+.cf-tile[aria-pressed="true"] .cf-tick {
+  border-color: #fff;
+  background: #fff;
+  transform: scale(1.1);
+}
+.cf-tile[aria-pressed="true"] .cf-tick::after {
+  content: "";
+  position: absolute;
+  top: 3px;
+  left: 6px;
+  width: 5px;
+  height: 9px;
+  border: solid hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 14%);
+  border-width: 0 2px 2px 0;
+  transform: rotate(40deg);
+}
+.cf-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin-top: 1.6rem;
+}
+.cf-chip {
+  padding: 0.85rem 1.4rem;
+  border: 1px solid var(--hair);
+  border-radius: 999px;
+  background: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 11% / 0.55);
+  color: #fff;
+  font: inherit;
+  font-size: 1.0625rem;
+  cursor: pointer;
+  transition: background 0.3s, border-color 0.3s, box-shadow 0.3s, transform 0.3s;
+}
+.cf-chip:hover {
+  transform: translateY(-2px);
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.5);
+}
+.cf-chip[aria-pressed="true"] {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82% / 0.85);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.3);
+  box-shadow: 0 0 24px -4px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.55);
+}
+.cf-fields {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+  margin-top: 1.6rem;
+}
+.cf-wide {
+  grid-column: 1 / -1;
+}
+@media (max-width: 639px) {
+  .cf-fields {
+    grid-template-columns: 1fr;
+  }
+}
+.cf-in {
+  width: 100%;
+  padding: 0.95rem 1.1rem;
+  border: 1px solid var(--hair);
+  border-radius: 14px;
+  background: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 10% / 0.7);
+  color: #fff;
+  font: inherit;
+  font-size: 1.0625rem;
+  outline: none;
+  resize: vertical;
+  transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
+}
+.cf-in::placeholder {
+  color: hsl(calc(var(--th) + 352) calc(40% * var(--ts)) 78% / 0.7);
+}
+.cf-in:focus {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.7);
+  box-shadow: 0 0 22px -6px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.6);
+}
+.cf-nav {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin-top: 1.8rem;
+}
+.cf-back {
+  padding: 0.6rem 0.2rem;
+  border: 0;
+  background: none;
+  color: var(--soft);
+  font: inherit;
+  font-size: 1.0625rem;
+  cursor: pointer;
+}
+.cf-back:hover {
+  color: #fff;
+}
+.cf-err {
+  margin: 1rem 0 0;
+  color: hsl(350 90% 80%);
+  font-size: 1rem;
+}
+.cf .rp-cta[disabled] {
+  opacity: 0.6;
+  cursor: wait;
+}
+/* the brief on the side */
+.cf-brief {
+  align-self: start;
+  padding: 1.4rem 1.3rem;
+  border-left: 1px solid var(--hair);
+  background: linear-gradient(90deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.06), transparent);
+}
+@media (max-width: 899px) {
+  .cf-brief {
+    border-top: 1px solid var(--hair);
+    border-left: 0;
+    padding: 1.2rem 0 0;
+    background: none;
+  }
+}
+.cf-brief-t {
+  margin: 0;
+  color: var(--a);
+  font-size: 0.9rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.cf-brief-row {
+  margin-top: 1.1rem;
+}
+.cf-brief-row > span {
+  display: block;
+  color: var(--soft);
+  font-size: 0.9375rem;
+}
+.cf-brief-row > div {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-top: 0.5rem;
+}
+.cf-brief-row em {
+  color: hsl(calc(var(--th) + 352) calc(40% * var(--ts)) 78% / 0.6);
+  font-size: 1rem;
+}
+.cf-pill {
+  padding: 4px 12px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.5);
+  border-radius: 999px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.16);
+  color: #fff;
+  font-size: 0.9375rem;
+  font-weight: 500;
+  animation: cf-pop 0.4s cubic-bezier(0.22, 1.4, 0.36, 1) both;
+}
+@keyframes cf-pop {
+  from {
+    opacity: 0;
+    transform: scale(0.7);
+  }
+}
+.cf-brief-note {
+  margin: 1.4rem 0 0;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  line-height: 1.55;
+}
+/* sent */
+.cf-done {
+  display: grid;
+  justify-items: center;
+  gap: 0.6rem;
+  max-width: 560px;
+  margin: 0 auto;
+  padding: 2rem 1rem;
+  text-align: center;
+}
+.cf-check {
+  width: 84px;
+  height: 84px;
+  fill: none;
+  stroke: var(--a, #fff);
+  stroke-width: 2.6;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.cf-check circle {
+  stroke-dasharray: 150;
+  stroke-dashoffset: 150;
+  animation: cf-draw 0.9s ease-out 0.1s forwards;
+}
+.cf-check path {
+  stroke-dasharray: 40;
+  stroke-dashoffset: 40;
+  animation: cf-draw 0.5s ease-out 0.8s forwards;
+}
+@keyframes cf-draw {
+  to {
+    stroke-dashoffset: 0;
+  }
+}
+.cf-done-t {
+  margin: 0.8rem 0 0;
+  color: #fff;
+  font-size: 2.2rem;
+  font-weight: 600;
+  letter-spacing: -0.03em;
+}
+.cf-done-p {
+  margin: 0;
+  color: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 90%);
+  font-size: 1.125rem;
+}
+@media (prefers-reduced-motion: reduce) {
+  .cf-pane,
+  .cf-pill,
+  .cf-check circle,
+  .cf-check path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+  .cf-tile {
+    transform: none;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The footer (footer.tsx, footer-word.tsx): a big sentence with a button, the offices as cards, numbered link columns whose links slide on
+   hover, and the big name that lights up where the mouse is. At most the width of a laptop (1440 px), in the middle. */
+.ft {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.82);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.16);
+  position: relative;
+  padding: 6rem 0 7rem;
+  overflow: hidden;
+}
+.ft-in {
+  width: 100%;
+  max-width: 1440px;
+  margin: 0 auto;
+  padding-inline: clamp(1.25rem, 3vw, 3rem);
+}
+.ft-top-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 2rem;
+  padding-bottom: 3.5rem;
+  border-bottom: 1px solid var(--hair);
+}
+.ft-kicker {
+  margin: 0;
+  color: var(--a);
+  font-size: 0.9375rem;
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+.ft-big {
+  margin: 1rem 0 0;
+  color: #fff;
+  font-size: clamp(2.6rem, 6.4vw, 5.6rem);
+  font-weight: 600;
+  letter-spacing: -0.045em;
+  line-height: 1.02;
+}
+.ft-big span {
+  background: linear-gradient(90deg, var(--a), hsl(calc(var(--th) + 330) calc(80% * var(--ts)) 68%));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.ft-cards {
+  display: grid;
+  gap: 14px;
+  margin-top: 3rem;
+}
+@media (min-width: 768px) {
+  .ft-cards {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+.ft-card {
+  padding: 1.4rem 1.5rem;
+  border: 1px solid var(--hair);
+  border-radius: 20px;
+  background: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 11% / 0.4);
+  color: var(--soft);
+  font-size: 1rem;
+  font-style: normal;
+  line-height: 1.6;
+  transition: border-color 0.3s, background 0.3s, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.ft-card:hover {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.45);
+  background: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 13% / 0.6);
+  transform: translateY(-3px);
+}
+.ft-card p {
+  margin: 0;
+}
+.ft-card-t {
+  margin-bottom: 0.5rem !important;
+  color: #fff;
+  font-size: 1.1875rem;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+.ft-card a {
+  color: inherit;
+  text-decoration: none;
+  transition: color 0.2s;
+}
+.ft-card a:hover {
+  color: #fff;
+}
+.ft-grid {
+  display: grid;
+  gap: 2.6rem;
+  margin-top: 4rem;
+}
+@media (min-width: 900px) {
+  .ft-grid {
+    grid-template-columns: 1.3fr 1fr 1.2fr 0.9fr;
+    gap: 3rem;
+  }
+}
+.ft-brand-n {
+  margin: 1rem 0 0;
+  color: #fff;
+  font-size: 1.4rem;
+  font-weight: 600;
+  letter-spacing: -0.02em;
+}
+.ft-brand-t {
+  margin: 0.7rem 0 0;
+  max-width: 24rem;
+  color: var(--soft);
+  font-size: 1rem;
+  line-height: 1.65;
+}
+.ft-socs {
+  display: flex;
+  gap: 10px;
+  margin-top: 1.4rem;
+}
+.ft-soc {
+  display: grid;
+  width: 42px;
+  height: 42px;
+  place-items: center;
+  border: 1px solid var(--hair);
+  border-radius: 50%;
+  color: var(--soft);
+  transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.3s;
+}
+.ft-soc:hover {
+  border-color: var(--a);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.18);
+  color: #fff;
+  transform: translateY(-3px);
+}
+.ft-col-t {
+  display: flex;
+  align-items: baseline;
+  gap: 0.6rem;
+  margin: 0 0 1.2rem;
+  color: #fff;
+  font-size: 0.9375rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.ft-col-t i {
+  color: var(--a);
+  font-size: 0.8125rem;
+  font-style: normal;
+}
+.ft-col ul {
+  display: grid;
+  gap: 0.2rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.ft-link {
+  position: relative;
+  display: block;
+  padding: 0.38rem 0;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.35;
+  text-decoration: none;
+  transition: color 0.25s, padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.ft-link::before {
+  content: "";
+  position: absolute;
+  top: 50%;
+  left: 0;
+  width: 0;
+  height: 1px;
+  background: var(--a);
+  transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.ft-link:hover {
+  padding-left: 1.6rem;
+  color: #fff;
+}
+.ft-link:hover::before {
+  width: 1.1rem;
+}
+.ft-note {
+  margin: 1.2rem 0 0;
+  max-width: 17rem;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  line-height: 1.6;
+  opacity: 0.8;
+}
+/* the big name: an outline, filled with light where the mouse is */
+.ft-word {
+  --mx: 50%;
+  --my: 50%;
+  position: relative;
+  margin-top: 4.5rem;
+  overflow: hidden;
+  font-size: clamp(3.4rem, 15.5vw, 15rem);
+  font-weight: 700;
+  letter-spacing: -0.06em;
+  line-height: 0.92;
+  text-align: center;
+  user-select: none;
+}
+.ft-word-o,
+.ft-word-f {
+  display: block;
+  padding-bottom: 0.05em;
+  white-space: nowrap;
+}
+.ft-word-o {
+  color: transparent;
+  -webkit-text-stroke: 1.5px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.3);
+}
+.ft-word-f {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(180deg, #fff 10%, var(--a) 70%, hsl(calc(var(--th) + 330) calc(80% * var(--ts)) 55%));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  -webkit-mask-image: radial-gradient(circle 22vw at var(--mx) var(--my), #000 0, transparent 100%);
+  mask-image: radial-gradient(circle 22vw at var(--mx) var(--my), #000 0, transparent 100%);
+  opacity: 0;
+  transition: opacity 0.5s;
+}
+.ft-word[data-live="true"] .ft-word-f {
+  opacity: 1;
+}
+/* without a mouse a light goes along the word by itself */
+@media (hover: none) {
+  .ft-word-f {
+    opacity: 1;
+    animation: ft-sweep 7s ease-in-out infinite alternate;
+  }
+}
+@keyframes ft-sweep {
+  from {
+    --mx: 10%;
+  }
+  to {
+    --mx: 90%;
+  }
+}
+.ft-bottom {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  margin-top: 2.2rem;
+  padding-top: 1.4rem;
+  border-top: 1px solid var(--hair);
+}
+.ft-bottom p {
+  margin: 0;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  opacity: 0.8;
+}
+.ft-top {
+  display: inline-flex;
+  align-items: center;
