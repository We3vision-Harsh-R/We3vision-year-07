index 7f000e0..9686a39 100644
--- a/a/src/app/globals.css
+++ b/b/src/app/globals.css
@@ -26316,3 +26316,39 @@ a.rt-row:hover {
   display: flex;
   gap: 10px;
 }
+
+/* ---- the end of the line: the track fades away and a buffer stop stands there ---- */
+.rl-hz-a {
+  fill: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 12%);
+}
+.rl-hz-b {
+  fill: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+}
+.rl-bs-sh {
+  fill: rgba(0, 0, 0, 0.5);
+  filter: blur(5px);
+}
+.rl-bs-post {
+  fill: hsl(calc(var(--th) + 354) calc(34% * var(--ts)) 34%);
+  stroke: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 86% / 0.6);
+  stroke-width: 1.4;
+}
+.rl-bs-bar {
+  fill: url(#rl-hazard);
+}
+.rl-bs-bar-ln {
+  fill: none;
+  stroke: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 90% / 0.7);
+  stroke-width: 1.5;
+}
+.rl-bs-plate {
+  fill: hsl(calc(var(--th) + 347) calc(56% * var(--ts)) 6% / 0.96);
+  stroke: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82% / 0.75);
+  stroke-width: 1.4;
+}
+.rl-bs-t {
+  fill: #fff;
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: 0.16em;
+}
