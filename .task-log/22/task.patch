index e94da4d..6c4c1c5 100644
--- a/a/src/app/globals.css
+++ b/b/src/app/globals.css
@@ -17121,3 +17121,72 @@ a.md-rel-card:hover .md-rel-go {
     grid-column: 1 / -1;
   }
 }
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The industries city of the home page (industries-road.tsx with "dof"): the distance is out of focus, like with a lens focused on the
+   car: four layers of blur on the top part of the stage (the far end of the road), each a little stronger and covering a little less;
+   and a haze that hides the end of the infinite road. */
+.cm-dof {
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  pointer-events: none;
+}
+.cm-dof i {
+  position: absolute;
+  inset: 0;
+  -webkit-backdrop-filter: blur(var(--b));
+  backdrop-filter: blur(var(--b));
+  -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 var(--s), transparent var(--e));
+  mask-image: linear-gradient(to bottom, #000 0, #000 var(--s), transparent var(--e));
+}
+.cm-dof i:nth-child(1) {
+  --b: 1.2px;
+  --s: 30%;
+  --e: 56%;
+}
+.cm-dof i:nth-child(2) {
+  --b: 2.6px;
+  --s: 20%;
+  --e: 40%;
+}
+.cm-dof i:nth-child(3) {
+  --b: 5px;
+  --s: 10%;
+  --e: 27%;
+}
+.cm-dof i:nth-child(4) {
+  --b: 9px;
+  --s: 3%;
+  --e: 16%;
+}
+.cm-dof::after {
+  content: "";
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 42%;
+  background: linear-gradient(to bottom, hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9% / 0.92), hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9% / 0.45) 45%, transparent);
+}
+
+/* the bird's-eye version (home): the road runs up the middle of the screen so that the districts on both sides can be seen; the list of the
+   industries stays on the left and the reading panel moves down to the middle of the bottom (where the picture fades out anyway) */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-world {
+    left: 50%;
+    top: 37%; /* the car stands above the reading panel */
+  }
+  .cm-bird .cm-ui {
+    grid-template-columns: 17.5rem minmax(0, 1fr) 17.5rem;
+    align-items: end;
+    padding-bottom: clamp(1rem, 4.5vh, 2.6rem);
+  }
+  .cm-bird .cm-rail {
+    align-self: center;
+  }
+  .cm-bird .cm-panel {
+    grid-column: 2;
+    justify-self: center;
+    width: min(100%, 36rem);
+    padding: 1.2rem 1.6rem 1rem;
+  }
+}
