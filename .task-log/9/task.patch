+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Split headings (modern/split-heading.tsx) and the magnet buttons (modern/magnet.tsx). */
+.sh {
+  --sh-a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%);
+  white-space: normal;
+}
+.sh-center {
+  text-align: center;
+}
+.sh-line {
+  display: block;
+}
+.sh-word {
+  display: inline-block;
+  margin-right: 0.26em;
+  background: linear-gradient(180deg, #fff 8%, color-mix(in srgb, #fff 45%, var(--sh-a)));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.sh-line[data-l="b"] .sh-word {
+  background-image: linear-gradient(180deg, color-mix(in srgb, #fff 40%, var(--sh-a)), var(--sh-a));
+}
+.sh[data-sh="wait"] .sh-word {
+  opacity: 0;
+  transform: translateY(0.55em) rotate(2.5deg);
+  filter: blur(8px);
+}
+.sh[data-sh="in"] .sh-word {
+  opacity: 1;
+  transform: none;
+  filter: blur(0);
+  transition:
+    opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
+    transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
+    filter 0.7s cubic-bezier(0.22, 1, 0.36, 1);
+  transition-delay: calc(var(--i) * 70ms);
+}
+.mg {
+  display: inline-block;
+  transition: translate 0.25s cubic-bezier(0.22, 1, 0.36, 1);
+}
+@media (prefers-reduced-motion: reduce) {
+  .sh[data-sh] .sh-word {
+    opacity: 1;
+    transform: none;
+    filter: none;
+    transition: none;
+  }
+  .mg {
+    transition: none;
+  }
+}
