diff --git a/a/src/app/globals.css b/b/src/app/globals.css
index 4f6a220..1581ccb 100644
--- a/a/src/app/globals.css
+++ b/b/src/app/globals.css
@@ -16849,3 +16849,148 @@ a.md-rel-card:hover .md-rel-go {
     opacity: 0.6;
   }
 }
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The panda and its street in 3D (the earlier rules above are overridden here). The panda is smaller (68 px) and turns round in 3D (a real
+   turn on its own axis, not a flat flip); its shadow stays on the ground. The street has depth: the trees, the lamps and the benches stand
+   at the back of the pavement, the panda walks in front of them on the pavement, which is a floor in perspective. */
+@media (min-width: 700px) {
+  .hub-stage {
+    --gap: clamp(106px, 13.5vh, 120px);
+  }
+}
+.hub-av::before {
+  bottom: -22px;
+  left: -42px;
+  width: 84px;
+  height: 14px;
+  opacity: 0.85;
+}
+.hub-av::after {
+  content: "";
+  position: absolute;
+  bottom: -20px;
+  left: -24px;
+  width: 48px;
+  height: 9px;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, rgba(0, 0, 0, 0.6), transparent);
+}
+.hub-av-body {
+  bottom: -17px;
+  left: -34px;
+  width: 68px;
+  height: 68px;
+  transform: none;
+  transition: none;
+  perspective: 460px;
+  perspective-origin: 50% 55%;
+  transform-style: preserve-3d;
+}
+.hub-av[data-face="left"] .hub-av-body {
+  transform: none;
+}
+.hub-av-body .hub-sp {
+  opacity: 0;
+  transform-origin: 50% 100%;
+  transition:
+    transform 0.46s cubic-bezier(0.45, 0, 0.25, 1),
+    opacity 0s linear 0.23s;
+}
+/* standing: the front; setting off: the panda turns on its axis to the side (the front turns away, the side turns in, at the half of the turn the two swap) */
+.hub-av[data-state="idle"] .hub-sp-idle {
+  opacity: 1;
+  transform: rotateY(0deg);
+}
+.hub-av[data-state="idle"] .hub-sp-walk {
+  opacity: 0;
+  transform: rotateY(90deg);
+}
+.hub-av[data-state="idle"][data-face="left"] .hub-sp-walk {
+  transform: rotateY(270deg);
+}
+.hub-av[data-state="walk"] .hub-sp-idle {
+  opacity: 0;
+  transform: rotateY(-90deg);
+}
+.hub-av[data-state="walk"][data-face="left"] .hub-sp-idle {
+  transform: rotateY(90deg);
+}
+.hub-av[data-state="walk"] .hub-sp-walk {
+  opacity: 1;
+  transform: rotateY(-15deg);
+}
+.hub-av[data-state="walk"][data-face="left"] .hub-sp-walk {
+  transform: rotateY(195deg);
+}
+.st {
+  --u: 0.85;
+}
+/* the pavement: a floor in perspective, the kerb at the back */
+.st-walk {
+  top: 0;
+  height: 40px;
+  border-radius: 0;
+  transform: perspective(210px) rotateX(58deg);
+  transform-origin: 50% 0;
+  background:
+    repeating-linear-gradient(90deg, transparent 0 59px, rgba(255, 255, 255, 0.09) 59px 60px),
+    repeating-linear-gradient(180deg, transparent 0 19px, rgba(255, 255, 255, 0.07) 19px 20px),
+    linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03));
+  box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.22);
+}
+/* things at the back of the pavement are a little further away, and they have a shadow on the ground */
+.st-item {
+  bottom: 0;
+  transform: translateX(-50%) scale(calc(var(--u) * 0.94));
+}
+.st-item::after {
+  content: "";
+  position: absolute;
+  right: 8%;
+  bottom: -3px;
+  left: 8%;
+  height: 7px;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, rgba(0, 0, 0, 0.5), transparent);
+  z-index: -1;
+}
+.st-lamp {
+  bottom: 0;
+}
+.st-cone {
+  height: 112px;
+}
+.st-pool {
+  bottom: -16px;
+  height: 22px;
+}
+@media (min-width: 700px) and (max-height: 720px) {
+  .hub-stage {
+    --gap: 84px;
+  }
+  .hub-av-body {
+    bottom: -14px;
+    left: -28px;
+    width: 56px;
+    height: 56px;
+  }
+  .hub-av::before {
+    bottom: -18px;
+    left: -34px;
+    width: 68px;
+  }
+  .hub-av::after {
+    bottom: -16px;
+    left: -19px;
+    width: 38px;
+  }
+  .st {
+    --u: 0.66;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hub-av-body .hub-sp {
+    transition: none;
+  }
+}
