+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The menu at the bottom (floating-nav.tsx). The "Menu" button has the same space (8 px) to the top, the bottom and the right edge of the pill.
+   Hover: a gradient sweeps in from the left, the button lifts and glows, the three lines of the icon shift one after the other; when the big menu is
+   open the icon is a cross. The links of the pill get a light dot under them that pops in. */
+.fn-list {
+  padding-left: 1rem;
+  padding-right: 7px;
+}
+.fn-ham {
+  position: relative;
+  display: block;
+  width: 18px;
+  height: 18px;
+  color: var(--color-violet);
+}
+.fn-ham i {
