-  border-color: var(--a);
-  color: #fff;
-  transform: translateY(-2px);
+.al-nav button:hover,
+.al-nav button:focus-visible {
+  border-color: #fff;
+  background: hsl(0 0% 100% / 0.14);
+  outline: none;
+}
+.al-nav button:active {
+  transform: scale(0.94);
+}
+@keyframes al-swap {
+  from {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
 }
 @media (prefers-reduced-motion: reduce) {
-  .ft-word-f {
+  .al-quote blockquote,
+  .al-who > div:first-child {
     animation: none;
   }
 }
 
-@property --mx {
-  syntax: "<length-percentage>";
-  inherits: true;
-  initial-value: 50%;
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The iOS look of the text fields (like the fields on an iPhone): a soft grey fill without a border, rounded corners, 17px text, a grey
+   placeholder, a caret in the colour of the theme, and big round dots in a password field. Used by the admin login (.al), the contact form
+   (.cf-in; only on the inner pages, the Home page keeps its own look) and the "type your name" field of the guide scenes (.gs-field). */
+.al input[type="email"],
+.al input[type="password"],
+.al input[type="text"],
+.ios-in,
+.gs-field input {
+  --ios-fill: hsl(calc(var(--th) + 350) calc(26% * var(--ts)) 82% / 0.13);
+  --ios-fill-solid: hsl(calc(var(--th) + 349) calc(20% * var(--ts)) 17%);
+  --ios-tint: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  border: 0;
+  border-radius: 12px;
+  background: var(--ios-fill);
+  box-shadow: none;
+  color: #fff;
+  caret-color: var(--ios-tint);
+  font: inherit;
+  font-size: 1.0625rem;
+  letter-spacing: 0;
+  outline: none;
+  -webkit-appearance: none;
+  appearance: none;
+  transition:
+    background-color 0.2s,
+    box-shadow 0.2s;
+}
+.cf-in.ios-in {
+  padding: 0.95rem 1rem;
+  border: 0;
+  border-radius: 12px;
+  background: var(--ios-fill);
+  box-shadow: none;
+}
+.al input::placeholder,
+.ios-in::placeholder,
+.gs-field input::placeholder {
+  color: hsl(calc(var(--th) + 352) calc(14% * var(--ts)) 92% / 0.52);
+  font-family: var(--font-sans);
+  font-size: 1.0625rem;
+  letter-spacing: 0;
+  opacity: 1;
+}
+.al input:focus,
+.ios-in:focus,
+.cf-in.ios-in:focus,
+.gs-field input:focus {
+  border: 0;
+  background: hsl(calc(var(--th) + 350) calc(26% * var(--ts)) 82% / 0.18);
+  box-shadow: 0 0 0 2px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.5);
+}
+.al input:focus-visible {
+  border: 0;
+  box-shadow: 0 0 0 2px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.5);
+}
+/* the browser's own yellow / blue autofill colour is replaced by the same fill */
+.al input:-webkit-autofill,
+.ios-in:-webkit-autofill,
+.gs-field input:-webkit-autofill {
+  -webkit-text-fill-color: #fff;
+  caret-color: var(--ios-tint);
+  box-shadow: 0 0 0 100px var(--ios-fill-solid) inset;
+  transition: background-color 9999s ease-out;
+}
+/* the dots of a password: big and round like the dots of an iPhone */
+.al input[type="password"]:not(:placeholder-shown) {
+  font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
+  font-size: 1.5rem;
+  letter-spacing: 0.12em;
 }
