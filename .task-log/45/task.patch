+    min-height: 0;
+    flex: 1;
+    flex-direction: column;
+  }
+  .ts-hint {
+    margin-top: 0.6rem;
+  }
+  .ts-stage {
+    width: 100%;
+    min-height: 22rem;
+    flex: 1;
+    height: auto;
+    margin-top: 0.4rem;
+  }
+}
+.ts-orbit {
+  border-color: rgba(255, 255, 255, 0.2);
+  box-shadow:
+    0 0 18px rgba(255, 255, 255, 0.05),
+    inset 0 0 18px rgba(255, 255, 255, 0.03);
+  transition: border-color 0.35s, box-shadow 0.35s;
+}
