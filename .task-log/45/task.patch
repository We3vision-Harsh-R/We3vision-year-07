index 9fe4489..b876fd5 100644
--- a/a/src/app/globals.css
+++ b/b/src/app/globals.css
@@ -118,16 +118,16 @@ section[id] {
 
 /* ---- Public site theme ---- */
 
-/* Headings: dim at the top, bright violet at the bottom */
+/* Headings: a little softer at the top, bright violet at the bottom (the top line must stay easy to read: it is never darker than 62% lightness) */
 .text-vfade {
-  background-image: linear-gradient(0deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%) 0%, hsl(calc(var(--th) + 351.38) calc(40.21% * var(--ts)) 19.02%) 100%);
+  background-image: linear-gradient(0deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%) 0%, hsl(calc(var(--th) + 352) calc(58% * var(--ts)) 62%) 100%);
   -webkit-background-clip: text;
   background-clip: text;
   color: transparent;
 }
 /* Hero title: the opposite way round */
 .text-hero {
-  background-image: linear-gradient(180deg, hsl(calc(var(--th) + 354) calc(46.15% * var(--ts)) 25.49%) 0%, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%) 100%);
+  background-image: linear-gradient(180deg, hsl(calc(var(--th) + 354) calc(58% * var(--ts)) 62%) 0%, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 78%) 100%);
   -webkit-background-clip: text;
   background-clip: text;
   color: transparent;
@@ -290,12 +290,10 @@ html.theme-anim {
   color: #fff;
   transform: translateY(-2px);
 }
-/* while a service is open the other boxes go out of focus the further they are from it (--d = how many places away):
