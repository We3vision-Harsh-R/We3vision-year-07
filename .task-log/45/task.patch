+}
+.go-ic {
+  display: block;
+  width: 28px;
+  height: 28px;
+  fill: none;
+  stroke: var(--a);
+  stroke-width: 1.6;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.go-card .go-num {
+  display: block;
+  margin-top: 0.9rem;
+  color: #fff;
+  font-size: clamp(2.2rem, 3.2vw, 2.9rem);
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  line-height: 1.05;
+  font-variant-numeric: tabular-nums;
+}
+.go-label {
+  display: block;
+  margin-top: 0.35rem;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.4;
+}
+/* the line from a card back to the ring (a real element: the pseudo-elements of the card are used by the border glow) */
+.go-line {
+  display: none;
+}
+@media (min-width: 900px) {
+  .go-line {
+    display: block;
+    position: absolute;
+    top: 50%;
+    width: clamp(2.6rem, 4.5vw, 4.4rem);
+    height: 1px;
+    background: linear-gradient(90deg, var(--hair), var(--a));
+    transform-origin: left;
+  }
+  .go-card[data-side="l"] .go-line {
+    left: 100%;
+  }
+  .go-card[data-side="r"] .go-line {
+    right: 100%;
+    background: linear-gradient(270deg, var(--hair), var(--a));
+    transform-origin: right;
+  }
