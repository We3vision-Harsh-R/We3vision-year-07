+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The text section "about this service" (sections/story.tsx) in four looks (duo, lead, rail, chips): every page of the site has its own, so that they do
+   not all show the same narrow column between two lines. Cards have the soft coloured light of the site (two round gradients) under dark glass. */
+.sy {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.86);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.16);
+}
+.sy-wrap {
+  width: 100%;
+  max-width: 1180px;
+  margin-inline: auto;
+  padding-inline: 1rem;
+}
+.sy-p {
+  margin: 0;
+  color: var(--soft);
+  font-size: 1.1875rem;
+  line-height: 1.7;
+}
+.sy-p .text-violet {
+  font-weight: 500;
+}
+/* duo */
+.sy-duo {
+  display: grid;
+  gap: 1.2rem;
+}
+@media (min-width: 860px) {
+  .sy-duo[data-n="2"] {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+.sy-card {
+  position: relative;
+  padding: 1.8rem 1.8rem 2rem;
+  border: 1px solid var(--hair);
+  border-radius: 26px;
+  background:
+    radial-gradient(130% 100% at 0% 0%, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.22), transparent 62%),
+    radial-gradient(120% 100% at 100% 100%, hsl(calc(var(--th) + 326) calc(85% * var(--ts)) 56% / 0.18), transparent 64%),
+    hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 10% / 0.86);
+}
+.sy-card-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 1.4rem;
+}
+.sy-no {
+  -webkit-text-stroke: 1px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.4);
+  color: transparent;
+  font-size: 3.4rem;
+  font-weight: 700;
+  letter-spacing: -0.04em;
+  line-height: 1;
+}
+.sy-card .sy-p {
+  font-size: 1.25rem;
+  line-height: 1.65;
+}
+/* lead */
+.sy-lead-wrap {
+  max-width: 980px;
+  margin-inline: auto;
+}
+.sy-lead {
+  margin: 0;
+  background: linear-gradient(180deg, #fff 20%, hsl(calc(var(--th) + 354) calc(70% * var(--ts)) 84%));
