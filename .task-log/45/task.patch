+}
+.lm a:hover .lm-mark,
+.lm a:hover .lm-text {
+  filter: brightness(1.3);
+}
+/* no box: only a soft patch of blur behind the logo (the logo is a transparent picture, so the page behind it would show through the letters); the patch has no
+   edge: it fades out round the logo */
+.lm a {
+  outline: none;
