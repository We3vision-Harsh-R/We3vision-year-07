+  border-color: rgba(255, 255, 255, 0.08);
+  box-shadow: none;
+}
+.ts-stage .ts-orbit:has(.ts-planet:hover, .ts-planet[aria-expanded="true"]) {
+  border-color: rgba(255, 255, 255, 0.95);
+  box-shadow:
+    0 0 14px rgba(255, 255, 255, 0.55),
+    0 0 46px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.35),
+    inset 0 0 18px rgba(255, 255, 255, 0.12);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The end of the pinned city: when the industries are finished and the next section comes up, only the TITLE of the section ("Built for every
+   industry") goes out of focus and fades (--out from 0 to 1, set in industries-road.tsx while the city scrolls away). */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-head {
+    filter: blur(calc(var(--out, 0) * 18px));
+    opacity: calc(1 - var(--out, 0) * 0.85);
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Tech space: its title sticks at the top (at the same place where the title of the industries was) while the section goes by: the planets
+   scroll away under it (it has a soft background so that they do not run through the letters). Desktop only. */
+@media (min-width: 901px) {
+  .ts {
+    padding-top: 0;
+  }
+  .ts-head {
+    position: sticky;
+    top: 0;
+    z-index: 5;
+    padding: 3.4rem 1rem 1.6rem;
+    /* no coloured band behind the title any more (it showed as a dark stripe across the page): the planets that pass under it are only blurred, by the
+       layer below, which fades out at the top and at the bottom */
+    background: none;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The big menu (mega-menu.tsx) as a pop-up: it grows out of the menu at the bottom of the page (from the bottom up), opens when the mouse comes onto
+   any button of that menu, and has the AI chat at the very top, then who we are with the recognitions, and the links of all pages as lists whose items
+   are plain lists (services and technology side by side, the other pages under them). Everything inside rises in one after the other. */
+.mm {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.84);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.16);
+  --pop-bottom: 92px; /* above the round menu button */
