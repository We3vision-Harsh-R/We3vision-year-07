+/* ---------------------------------------------------------------------------------------------------------------------------------
+   "Ask the robot buddy" (ai-buddy.tsx): a chat window with a robot. The questions are buttons; the robot "types" (three dots) and writes the answer
+   letter by letter. Its eyes follow the pointer. */
+.bud {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.86);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.18);
+  --ex: 0px;
+  --ey: 0px;
+  display: grid;
+  overflow: hidden;
+  border: 1px solid var(--hair);
+  border-radius: 30px;
+  background:
+    radial-gradient(130% 100% at 0% 0%, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.24), transparent 62%),
+    radial-gradient(120% 100% at 100% 100%, hsl(calc(var(--th) + 326) calc(85% * var(--ts)) 56% / 0.2), transparent 64%),
+    hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 9% / 0.9);
+  box-shadow: 0 40px 80px -40px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 50% / 0.5);
+}
+@media (min-width: 760px) {
+  .bud {
+    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
+  }
+}
+.bud-side {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 1.4rem;
+  padding: 2.2rem 1.4rem;
+  border-bottom: 1px solid var(--hair);
+}
+@media (min-width: 760px) {
+  .bud-side {
+    border-right: 1px solid var(--hair);
+    border-bottom: 0;
+  }
+}
+.bud-robot {
+  position: relative;
+  display: grid;
+  width: 150px;
+  justify-items: center;
+  animation: bud-float 5s ease-in-out infinite;
+}
+@keyframes bud-float {
+  50% {
+    transform: translateY(-9px);
+  }
+}
+.bud-glow {
+  position: absolute;
+  inset: 10% -25% -30%;
