+  }
+}
+
+/* the show (only when the script has put it in the "wait" state: without it everything is simply there) */
+.go[data-go="wait"] .go-arc {
+  stroke-dashoffset: 100;
+}
+.go[data-go="wait"] .go-tick i {
+  opacity: 0;
+  scale: 0.3;
+}
+.go[data-go="wait"] .go-tick em,
+.go[data-go="wait"] .go-core span,
+.go[data-go="wait"] .go-core small,
+.go[data-go="wait"] .go-comet,
+.go[data-go="wait"] .go-track,
+.go[data-go="wait"] .go-dash {
