     ...projects.map((p) => ({ url: `${base}/portfolio/${p.slug}` })),
-    ...POSTS.map((post) => ({ url: `${base}/blog/${post.slug}`, lastModified: post.date })),
+    ...posts.map((post) => ({ url: `${base}/blog/${post.slug}`, lastModified: post.date })),
   ];
 }
