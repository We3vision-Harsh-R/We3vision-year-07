+@keyframes go-draw {
+  from {
+    stroke-dashoffset: 100;
+  }
+}
+.go[data-go="in"] .go-tick i {
+  animation: go-pop 0.6s cubic-bezier(0.22, 1.5, 0.36, 1) calc(0.45s + var(--i) * 0.27s) both;
