+/* ---------------------------------------------------------------------------------------------------------------------------------
+   "At a glance" of the home page as a small control room (glance-orbit.tsx): a ring that counts the years (one light for every year, a comet goes
+   round) with the other facts as glass cards around it. When it comes into view the ring draws, the lights come on one after the other, the
+   cards fly in from the ring with a line back to it, and every figure counts up. Max 1200 px wide, in the middle. */
+.go {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.84);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.2);
+  max-width: 1200px;
+  margin-inline: auto;
+  padding-inline: clamp(1rem, 3vw, 2rem);
+}
+.go-stage {
+  display: grid;
+  align-items: center;
+  gap: 1.6rem;
+  margin-top: clamp(2.4rem, 6vh, 4rem);
+}
+@media (min-width: 900px) {
+  .go-stage {
+    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+    gap: clamp(2.6rem, 4.5vw, 4.4rem);
+  }
+}
+.go-side {
+  display: grid;
+  gap: 1.3rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+@media (max-width: 899px) {
+  .go-stage {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .go-side {
+    display: contents;
+  }
+  .go-ring {
+    order: -1;
+    grid-column: 1 / -1;
+    margin-inline: auto;
+  }
+}
+@media (max-width: 520px) {
+  .go-stage {
+    grid-template-columns: 1fr;
+  }
+}
+@media (min-width: 900px) {
+  .go-side[data-side="l"] {
+    justify-items: end;
+  }
+  .go-side[data-side="r"] {
+    justify-items: start;
+  }
+}
+
+/* the ring */
+.go-ring {
+  position: relative;
+  width: clamp(290px, 36vw, 470px);
+  aspect-ratio: 1;
+}
+.go-ring svg {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.go-track {
+  fill: none;
+  stroke: var(--hair);
+  stroke-width: 2;
+}
+.go-dash {
+  fill: none;
+  stroke: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.28);
+  stroke-width: 1.5;
+  stroke-dasharray: 2 10;
+  stroke-linecap: round;
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: go-spin 90s linear infinite reverse;
+}
+.go-arc {
+  fill: none;
+  stroke: var(--a);
+  stroke-width: 4;
+  stroke-linecap: round;
+  stroke-dasharray: 100;
+  stroke-dashoffset: 0;
+  transform: rotate(-90deg);
+  transform-origin: 50% 50%;
+  filter: drop-shadow(0 0 8px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.8));
+}
+.go-comet {
+  position: absolute;
+  inset: 0;
+  animation: go-spin 14s linear infinite;
+}
+.go-comet::before {
+  content: "";
+  position: absolute;
+  top: calc(12.5% - 5px);
+  left: calc(50% - 5px);
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: #fff;
+  box-shadow: 0 0 14px 4px var(--a), 0 0 40px 10px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.45);
+}
+@keyframes go-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+.go-tick {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+.go-tick i {
+  position: absolute;
+  top: var(--y);
+  left: var(--x);
+  width: 16px;
+  height: 16px;
+  margin: -8px 0 0 -8px;
+  border: 2px solid var(--a);
+  border-radius: 50%;
+  background: var(--a);
+  box-shadow: 0 0 16px 2px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.8);
+}
+.go-tick em {
+  position: absolute;
+  top: var(--ly);
+  left: var(--lx);
+  translate: -50% -50%;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  font-style: normal;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: 0.04em;
+}
+.go-core {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+}
+.go-core .go-num {
+  background: linear-gradient(180deg, #fff 25%, var(--a));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  font-size: clamp(5rem, 10vw, 8.4rem);
+  font-weight: 600;
+  letter-spacing: -0.05em;
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+.go-core span {
+  margin-top: 0.5rem;
+  color: #fff;
+  font-size: 1.25rem;
+  font-weight: 500;
+}
+.go-core small {
+  margin-top: 0.3rem;
+  color: var(--soft);
+  font-size: 1rem;
+}
+
+/* the cards */
+.go-card {
+  --dir: 1;
+  position: relative;
+  width: min(100%, 330px);
+  overflow: hidden;
+  padding: 1.3rem 1.5rem 1.6rem;
+  border: 1px solid var(--hair);
+  border-radius: 22px;
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.1), hsl(calc(var(--th) + 346) calc(60% * var(--ts)) 9% / 0.82) 70%);
+  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s, box-shadow 0.4s;
+}
+.go-card[data-side="r"] {
+  --dir: -1;
+}
+@media (max-width: 899px) {
+  .go-card {
+    --dir: 0;
+    width: 100%;
+  }
+}
+.go-card:hover {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.5);
+  box-shadow: 0 24px 50px -26px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 60% / 0.6);
