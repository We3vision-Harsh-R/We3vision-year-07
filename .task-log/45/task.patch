+  inset: 0;
+  z-index: 48;
+  visibility: hidden;
+  pointer-events: none;
+  transition: visibility 0s 0.5s;
+}
+@media (min-width: 640px) {
+  .mm {
+    --pop-bottom: calc(3rem + 54px + 16px); /* above the pill */
+  }
+}
+.mm[data-open="true"] {
+  visibility: visible;
+  transition: none;
+}
+/* the page behind goes soft (it only catches clicks when the menu was opened with a click) */
+.mm-back {
+  position: absolute;
+  inset: 0;
+  background: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9% / 0.45);
+  -webkit-backdrop-filter: blur(9px);
+  backdrop-filter: blur(9px);
+  opacity: 0;
+  transition: opacity 0.45s;
+}
+.mm[data-open="true"] .mm-back {
+  opacity: 1;
+}
+.mm[data-sticky="true"] .mm-back {
+  pointer-events: auto;
+}
+.mm-pop {
+  position: absolute;
+  bottom: var(--pop-bottom);
+  right: 0;
+  left: 0;
+  display: flex;
+  width: min(1280px, calc(100vw - 24px));
+  max-height: calc(100svh - var(--pop-bottom) - 1.5rem);
+  margin-inline: auto;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.2);
+  border-radius: 30px;
+  background:
+    radial-gradient(70% 60% at 100% 0, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.16), transparent 70%),
+    hsl(calc(var(--th) + 347.58) calc(60% * var(--ts)) 7% / 0.9);
+  -webkit-backdrop-filter: blur(30px) saturate(1.4);
+  backdrop-filter: blur(30px) saturate(1.4);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 40px 90px -30px rgba(0, 0, 0, 0.85);
+  pointer-events: auto;
+  transform-origin: 50% 100%;
+  opacity: 0;
+  transform: translateY(60px) scale(0.82);
+  clip-path: inset(60% 14% 0 14% round 30px);
+  transition:
+    opacity 0.28s ease-in,
+    transform 0.4s cubic-bezier(0.5, 0, 0.75, 0),
+    clip-path 0.4s cubic-bezier(0.5, 0, 0.75, 0);
+}
+.mm[data-open="true"] .mm-pop {
+  opacity: 1;
+  transform: none;
+  clip-path: inset(0 0 0 0 round 30px);
+  transition:
+    opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
+    transform 0.85s cubic-bezier(0.22, 1.1, 0.36, 1),
+    clip-path 0.85s cubic-bezier(0.22, 1, 0.36, 1);
+}
+/* a bridge down to the menu, so that the mouse can go from the menu up to the pop-up without it closing */
+.mm-bridge {
+  position: absolute;
+  top: 100%;
+  right: 0;
+  left: 0;
+  height: 24px;
+}
+.mm-in {
+  width: 100%;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  padding: clamp(1.5rem, 2.6vw, 2.3rem);
