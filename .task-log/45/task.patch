+/* the AI chat at the very top: its window opens downwards over the pop-up */
+/* the chat lies above the rest of the pop-up (the lists and the text have their own layers because they rise in, so without this they would be painted over its window) */
+.mm-chat {
+  position: relative;
+  z-index: 20;
+}
+.mm-chat .pd {
+  --ph: min(42vh, 330px);
+  width: 100%;
+  max-width: none;
