diff --git a/a/src/app/globals.css b/b/src/app/globals.css
index 57a4bd3..be9fa69 100644
--- a/a/src/app/globals.css
+++ b/b/src/app/globals.css
@@ -17385,3 +17385,39 @@ a.md-rel-card:hover .md-rel-go {
     grid-template-columns: 15.5rem minmax(0, 1fr) 22rem;
   }
 }
+
+/* the list and the info card are not faded with the bottom of the picture: they are clear, so that you can read which industry it is
+   (only the city itself fades out at the top and the bottom) */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-stage {
+    -webkit-mask-image: none;
+    mask-image: none;
+  }
+  .cm-bird .cm-scene {
+    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 88%, transparent 100%);
+    mask-image: linear-gradient(to bottom, transparent 0, #000 10%, #000 88%, transparent 100%);
+  }
+  .cm-bird .cm-fade {
+    display: none;
+  }
+  .cm-bird .cm-rail ol {
+    padding: 0.5rem;
+    border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.18);
+    border-radius: 18px;
+    background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 9% / 0.82);
+    backdrop-filter: blur(10px);
+    -webkit-backdrop-filter: blur(10px);
+  }
+  .cm-bird .cm-rail {
+    padding-left: 0;
+  }
+  .cm-bird .cm-rail-bar {
+    display: none;
+  }
+  .cm-bird .cm-rail button {
+    color: hsl(calc(var(--th) + 354) calc(40% * var(--ts)) 86%);
+  }
+  .cm-bird .cm-panel {
+    background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 9% / 0.88);
+  }
+}
