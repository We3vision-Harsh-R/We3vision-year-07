+                  <p className="fg-p-t">Smart animate · Ease out · 300 ms</p>
+                </div>
+              )}
+            </aside>
+          </div>
+        </div>
+        <p className="fg-hint">Click a layer, drag it, change its colour, switch from wireframe to the final design.</p>
+      </div>
+    </section>
+  );
+}
