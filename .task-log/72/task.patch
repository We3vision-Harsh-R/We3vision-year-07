+  { id: "sub", label: "Body text", kind: "text", x: 36, y: 148, w: 206, h: 36, r: 0, hue: 0 },
+  { id: "cta", label: "Button / Primary", kind: "button", x: 36, y: 200, w: 116, h: 38, r: 19, hue: 0 },
