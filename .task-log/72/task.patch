+            <path d={`M0 ${e.h - 46}Q${e.w * 0.3} ${e.h - 86} ${e.w * 0.58} ${e.h - 50}T${e.w} ${e.h - 56}V${e.h - e.r}Q${e.w} ${e.h} ${e.w - e.r} ${e.h}H${e.r}Q0 ${e.h} 0 ${e.h - e.r}Z`} fill={fillOf(h - 20, 36, 0.95)} />
+          </>
