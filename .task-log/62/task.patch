        String   @id @default(cuid())\n  name      String   @default(\"\")\n  mime      String\n  size      Int\n  data      Bytes\n  createdAt DateTime @default(now())\n}\n\n// One portfolio project (a client work). The pictures are links (/media/<id> for uploaded ones). \\`group\\` says where it is shown:\n// \"brand\" = the sliding arches of the Brand Design page; every published project is also on the Portfolio page.\nmodel Project {\n  id        String   @id @default(cuid())\n  slug      String   @unique\n  title     String\n  category  String   @default(\"\")\n  summary   String   @default(\"\")\n  content   String   @default(\"\")\n  cover     String   @default(\"\")\n  images    Json     @default(\"[]\")\n  group     String   @default(\"brand\")\n  sortOrder Int      @default(0)\n  published Boolean  @default(true)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([group, sortOrder])\n}\n\n// One article of the blog (Blog in the admin panel). \\`cover\\` is a link (/media/<id> for an uploaded picture); \\`tile\\` is the shape of its picture\n// on the Blog page (landscape, square, portrait or tall); \\`content\\` is the article in a light text markup (## heading, - point, empty line between\n// paragraphs); \\`faq\\` is a list of { question, answer }; \\`sortOrder\\` is the place in the list of the Blog page (smaller = earlier).\nmodel BlogPost {\n  id          String   @id @default(cuid())\n  slug        String   @unique\n  title       String\n  category    String   @default(\"\")\n  summary     String   @default(\"\")\n  cover       String   @default(\"\")\n  tile        String   @default(\"portrait\")\n  content     String   @default(\"\")\n  tags        Json     @default(\"[]\")\n  faq         Json     @default(\"[]\")\n  publishedAt DateTime @default(now())\n  sortOrder   Int      @default(0)\n  published   Boolean  @default(true)\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  @@index([sortOrder])\n}\n\n// One person of the office on the Team page (Team in the admin panel). `dept` is the department (the people of one department sit in one\n// corner of the office, in the order of `sortOrder`); `photo` is a link (/media/<id> for an uploaded picture); `girl` draws the avatar as a woman.\nmodel TeamMember {\n  id        String   @id @default(cuid())\n  name      String\n  role      String   @default(\"\")\n  dept      String   @default(\"Team\")\n  bio       String   @default(\"\")\n  photo     String   @default(\"\")\n  linkedin  String   @default(\"\")\n  girl      Boolean  @default(false)\n  /// the seat in the office (-1 = automatic: in the order of the list); see lib/team-seats.ts\n  seat      Int      @default(-1)\n  sortOrder Int      @default(0)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([sortOrder])\n}\n\n// The Careers page (Careers in the admin panel): the open positions a visitor can choose as the \"destination\" of the ticket, the extra\n// questions of HR for the passenger details, and the tickets (applications) that visitors book. The city is the only thing that must be\n// there when a seat is booked (stage \"booked\"); the passenger details come after it (stage \"complete\").\n/// A job opening: shown in the list on the Careers page, has its own page (/careers/<slug>), and is a destination of the ticket.\nmodel CareerRole {\n  id               String   @id @default(cuid())\n  title            String\n  team             String   @default(\"\")\n  /// open (shown on the site) or closed\n  active           Boolean  @default(true)\n  sortOrder        Int      @default(0)\n  slug             String   @unique @default(\"\")\n  /// one or two lines for the card in the list\n  summary          String   @default(\"\")\n  /// about the role: paragraphs separated by an empty line\n  description      String   @default(\"\")\n  responsibilities Json     @default(\"[]\")\n  requirements     Json     @default(\"[]\")\n  perks            Json     @default(\"[]\")\n  location         String   @default(\"Surat, India\")\n  /// Full-time | Part-time | Internship | Contract\n  workType         String   @default(\"Full-time\")\n  /// On-site | Hybrid | Remote\n  workMode         String   @default(\"On-site\")\n  experience       String   @default(\"\")\n  openings         Int      @default(1)\n  salary           String   @default(\"\")\n  /// yyyy-mm-dd or empty\n  closesAt         String   @default(\"\")\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  @@index([sortOrder])\n}\n\nmodel CareerQuestion {\n  id        String   @id @default(cuid())\n  label     String\n  /// text | textarea | select | yesno\n  kind      String   @default(\"text\")\n  options   Json     @default(\"[]\")\n  required  Boolean  @default(false)\n  active    Boolean  @default(true)\n  sortOrder Int      @default(0)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([sortOrder])\n}\n\nmodel CareerApplication {\n  id            String   @id @default(cuid())\n  city          String\n  currentStatus String   @default(\"\")\n  roleId        String   @default(\"\")\n  roleTitle     String   @default(\"\")\n  joinDate      String   @default(\"\")\n  noticePeriod  String   @default(\"\")\n  callSlot      String   @default(\"\")\n  resume        String   @default(\"\")\n  name          String   @default(\"\")\n  email         String   @default(\"\")\n  phone         String   @default(\"\")\n  linkedin      String   @default(\"\")\n  skills        String   @default(\"\")\n  experience    String   @default(\"\")\n  answers       Json     @default(\"[]\")\n  /// booked (seat booked, city known) | complete (passenger details given)\n  stage         String   @default(\"booked\")\n  /// ticket (the ticket office) | job (the apply form of a job page)\n  source        String   @default(\"ticket\")\n  /// new | contacted | interview | hired | rejected\n  status        String   @default(\"new\")\n  note          String   @default(\"\")\n  createdAt     DateTime @default(now())\n  updatedAt     DateTime @updatedAt\n\n  @@index([createdAt])\n  @@index([roleId])\n}\n",
