+      last = now;
+      const c = getCareer();
+      // where the nose of the train wants to be
+      let target = -TRAIN_L - 400;
+      if (c.summoned) {
+        target = geo.sStop1;
+        if (c.stage !== "idle") {
+          const centreY = window.scrollY + window.innerHeight * 0.55 - top0;
