+/* the stage pinned while the page scrolls: the scroll opens the boxes (service-stage.tsx) */
+.sx-sticky {
+  position: relative;
+}
+.sx-track[data-pin="true"] .sx-sticky {
+  position: sticky;
+  top: 92px;
+}
+.sx[data-pin="true"] .sx-list {
+  grid-auto-rows: auto;
+  align-content: start;
+  gap: 10px;
+}
+.sx[data-pin="true"] .sx-tab {
+  padding: 14px 20px;
+  transition:
+    background 0.4s,
+    border-color 0.4s;
+}
+.sx[data-pin="true"] .sx-tab[data-on="false"] .sx-tab-t i {
+  -webkit-line-clamp: 1;
+}
+.sx[data-pin="true"] .sx-tab[data-on="true"] .sx-tab-t i {
+  display: block;
+  overflow: visible;
+  -webkit-line-clamp: unset;
+  animation: sx-open 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+.sx[data-pin="true"] .sx-tab[data-on="true"] .sx-tab-bar {
+  opacity: 1;
+  transform: scaleX(var(--q, 0));
+  animation: none;
+}
+@keyframes sx-open {
+  from {
+    opacity: 0;
+    transform: translateY(-4px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
