     height: 72px;
   }
 }
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   PANDA chat, smoother: no ring of light round the bar any more; the window above the bar and the blur behind it have the size of the OPEN chat
+   all the time (they only fade and grow in), so only the bar itself changes its width while it widens: nothing else has to be laid out
+   again in every frame. */
+.pd-ring {
+  display: none;
+}
+.pd[data-open="true"] .pd-ring {
+  animation: none;
+}
+.pd-panel {
+  right: auto;
+  left: 50%;
+  width: min(var(--wo), calc(100vw - 24px));
+  translate: -50% 0;
+}
+.pd-blur {
+  right: auto;
+  left: 50%;
+  width: min(calc(var(--wo) + 2 * (var(--ax) + var(--fx))), 100vw);
+  translate: -50% 0;
+}
+.pd {
+  transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
+}
