     animation-play-state: paused;
   }
 }
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Neon Reveal (components/site/modern/neon-reveal.tsx): a neon tube flickers on and its light uncovers the content under it. */
+@property --nr-reach {
+  syntax: "<percentage>";
+  inherits: false;
+  initial-value: 130%;
+}
+.nr {
+  --nr-c: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 78%);
+  --nr-glow: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 68%);
+  position: relative;
+  padding-top: 26px;
+}
+.nr-tube {
+  position: absolute;
+  top: 0;
+  left: 50%;
+  width: var(--nr-w, 72%);
+  height: 5px;
+  border-radius: 999px;
+  background: linear-gradient(90deg, transparent, var(--nr-c) 14%, #fff 50%, var(--nr-c) 86%, transparent);
+  box-shadow:
+    0 0 6px 1px var(--nr-c),
+    0 0 22px 4px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 68% / 0.7),
+    0 0 70px 14px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 60% / 0.38);
+  opacity: 1;
+  translate: -50% 0;
+  pointer-events: none;
+}
+.nr-spill {
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(ellipse 70% 80% at 50% 0, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.2), transparent 72%);
+  opacity: 1;
+  pointer-events: none;
+}
+.nr-body {
+  position: relative;
+  -webkit-mask-image: linear-gradient(180deg, #000 0, #000 var(--nr-reach), transparent calc(var(--nr-reach) + 24%));
+  mask-image: linear-gradient(180deg, #000 0, #000 var(--nr-reach), transparent calc(var(--nr-reach) + 24%));
+}
+/* waiting: dark, the tube is off */
+.nr[data-nr="wait"] .nr-tube,
+.nr[data-nr="wait"] .nr-spill {
+  opacity: 0;
+}
+.nr[data-nr="wait"] .nr-body {
+  --nr-reach: -30%;
+}
+/* playing: the tube flickers on, then the light goes down and uncovers the content */
+.nr[data-nr="on"] .nr-tube {
+  animation:
+    nr-ignite 1.1s steps(1, end) var(--nr-delay) both,
+    nr-hum 4.5s ease-in-out calc(var(--nr-delay) + 1.1s) infinite;
+}
+.nr[data-nr="on"] .nr-spill {
+  animation: nr-spill var(--nr-dur) ease-out calc(var(--nr-delay) + 0.9s) both;
+}
+.nr[data-nr="on"] .nr-body {
+  animation: nr-reveal var(--nr-dur) cubic-bezier(0.3, 0.1, 0.2, 1) calc(var(--nr-delay) + 0.9s) both;
+}
+@keyframes nr-ignite {
+  0% {
+    opacity: 0;
+  }
+  10% {
+    opacity: 0.9;
+  }
+  16% {
+    opacity: 0.1;
+  }
+  26% {
+    opacity: 1;
+  }
+  34% {
+    opacity: 0.25;
+  }
+  46% {
+    opacity: 1;
+  }
+  58% {
+    opacity: 0.6;
+  }
+  100% {
+    opacity: 1;
+  }
+}
+@keyframes nr-hum {
+  50% {
+    opacity: 0.86;
+  }
+}
+@keyframes nr-reveal {
+  from {
+    --nr-reach: -30%;
+  }
+  to {
+    --nr-reach: 130%;
+  }
+}
+@keyframes nr-spill {
+  from {
+    opacity: 0;
+  }
+  35% {
+    opacity: 1;
+  }
+  to {
+    opacity: 0.7;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .nr-tube,
+  .nr-spill,
+  .nr-body {
+    animation: none !important;
+  }
+}
diff --git a/b/src/components/site/modern/neon-reveal.tsx b/b/src/components/site/modern/neon-reveal.tsx
new file mode 100644
index 0000000..247fd5d
--- /dev/null
+++ b/b/src/components/site/modern/neon-reveal.tsx
@@ -0,0 +1,58 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+
+// "Neon Reveal": a neon tube that flickers on and lights up the content under it (the idea is the Neon Reveal of React Bits Pro, built
+// here without any library). When the block scrolls into view the tube ignites with a short flicker, then it hums quietly while its light
+// falls over the content and uncovers it from the tube downwards (the edge of the reveal is soft). Nothing is hidden when JavaScript does
+// not run or when the visitor prefers less motion: the content is simply there. The effect is plain CSS (a registered custom property that
+// is animated), so it costs nothing while it rests. The look is in globals.css (.nr-*).
+
+export function NeonReveal({
+  children,
+  className = "",
+  delay = 0,
+  duration = 1.8,
+  width = "72%",
+}: {
+  children: React.ReactNode;
+  className?: string;
+  /** seconds before the tube ignites once the block is in view */
+  delay?: number;
+  /** seconds the light needs to uncover the content */
+  duration?: number;
+  /** length of the tube (a CSS width) */
+  width?: string;
+}) {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+      el.dataset.nr = "on";
+      return;
+    }
+    // below the fold: wait; already on the screen: play at once
+    el.dataset.nr = "wait";
+    const io = new IntersectionObserver(
+      ([e]) => {
+        if (e.isIntersecting) {
+          el.dataset.nr = "on";
+          io.disconnect();
+        }
+      },
+      { threshold: 0.2 },
+    );
+    io.observe(el);
+    return () => io.disconnect();
+  }, []);
+
+  return (
+    <div ref={ref} className={`nr ${className}`} style={{ "--nr-delay": `${delay}s`, "--nr-dur": `${duration}s`, "--nr-w": width } as React.CSSProperties}>
+      <span className="nr-tube" aria-hidden />
+      <span className="nr-spill" aria-hidden />
+      <div className="nr-body">{children}</div>
+    </div>
+  );
+}
