+  transition:
+    opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
+    transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.ac-item[data-in="true"] {
+  opacity: 1;
+  transform: none;
+}
+.ac-dot {
+  position: absolute;
+  top: 30px;
+  left: -37px;
+  width: 14px;
+  height: 14px;
+  border: 2px solid var(--a);
+  border-radius: 50%;
+  background: hsl(calc(var(--th) + 347.58) calc(66% * var(--ts)) 6%);
+}
+.ac-item[data-in="true"] .ac-dot {
+  background: var(--a);
+}
+.ac-no {
+  color: var(--a);
+  font-size: 0.875rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+}
+.ac-item h3 {
+  margin: 8px 0 0;
+  color: #fff;
+  font-size: 1.4rem;
+  font-weight: 600;
+  letter-spacing: -0.02em;
+  line-height: 1.2;
+}
+.ac-item p {
+  margin: 10px 0 0;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+}
+.ac-meet {
+  position: relative;
+  display: grid;
+  gap: 26px;
+  align-items: center;
+  margin-top: 56px;
+  padding: 28px;
+  border: 1px solid var(--hair);
+  border-radius: 26px;
+  background: var(--card);
+}
+@media (min-width: 768px) {
+  .ac-meet {
+    grid-template-columns: 17rem minmax(0, 1fr);
+    gap: 40px;
+    padding: 36px 40px;
+  }
+}
+.ac-panda {
+  position: relative;
+  display: grid;
+  gap: 14px;
+  justify-items: center;
+}
+.ac-panda .pm {
+  width: 9.5rem;
+  height: auto;
+}
+.ac-bubble {
+  position: relative;
+  min-height: 3.4em;
+  margin: 0;
+  padding: 10px 16px;
+  border: 1px solid var(--hair);
+  border-radius: 16px;
+  background: hsl(calc(var(--th) + 347) calc(46% * var(--ts)) 8% / 0.9);
+  color: #fff;
+  font-size: 0.9375rem;
+  line-height: 1.45;
+  text-align: center;
+  animation: vq-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+.ac-meet-h {
+  margin: 14px 0 0;
+  color: #fff;
+  font-size: clamp(1.8rem, 3.4vw, 2.6rem);
+  font-weight: 600;
+  letter-spacing: -0.03em;
+  line-height: 1.1;
+  white-space: pre-line;
+}
+.ac-meet-p {
+  margin: 12px 0 0;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+}
+@media (prefers-reduced-motion: reduce) {
+  .ah-grid,
+  .ah-scroll span,
+  .ac-bubble {
+    animation: none;
+  }
+  .ac-item {
+    opacity: 1;
+    transform: none;
+  }
+}
