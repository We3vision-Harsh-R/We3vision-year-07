+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The About page, as words: the first screen with a grid floor in perspective (about/about-hero.tsx) and the story as chapters on a line
+   (about/about-chapters.tsx). */
+.ah {
+  position: relative;
+  display: flex;
+  min-height: 100svh;
+  align-items: center;
+  justify-content: center;
+  padding: 6rem 1rem 11rem;
+  overflow: hidden;
+  text-align: center;
+}
+.ah-floor {
+  position: absolute;
+  inset: auto 0 0 0;
+  height: 64%;
+  perspective: 700px;
+  perspective-origin: 50% 0;
+  pointer-events: none;
+  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 40%, #000 100%);
+  mask-image: linear-gradient(to bottom, transparent 0, #000 40%, #000 100%);
+}
+.ah-grid {
+  position: absolute;
+  inset: 0 -50% -30% -50%;
+  background-image:
+    linear-gradient(hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.2) 2px, transparent 2px),
+    linear-gradient(90deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.2) 2px, transparent 2px);
+  background-size: 110px 110px;
+  transform: rotateX(64deg);
+  transform-origin: 50% 0;
+  animation: ah-flow 9s linear infinite;
+}
+@keyframes ah-flow {
+  to {
+    background-position: 0 110px;
+  }
+}
+.ah-horizon {
+  position: absolute;
+  top: 0;
+  right: 0;
+  left: 0;
+  height: 70%;
+  background: radial-gradient(ellipse 60% 100% at 50% 0, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 66% / 0.26), transparent 72%);
+}
+.ah-in {
+  position: relative;
+  max-width: 900px;
+}
+.ah-h1 {
+  margin: 28px 0 0;
+  padding-bottom: 8px;
+  background: linear-gradient(180deg, #fff, hsl(calc(var(--th) + 352.8) calc(100% * var(--ts)) 85.29%));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  font-size: clamp(2.6rem, 6.4vw, 4.6rem);
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  line-height: 1.05;
+  white-space: pre-line;
+  filter: drop-shadow(0 6px 30px hsl(calc(var(--th) + 344) calc(71.43% * var(--ts)) 4.12% / 0.85));
+}
+.ah-p {
+  max-width: 640px;
+  margin: 24px auto 0;
+  color: #fff;
+  font-size: clamp(1rem, 1.5vw, 1.125rem);
+  line-height: 1.65;
+  text-shadow: 0 2px 18px hsl(calc(var(--th) + 344) calc(71.43% * var(--ts)) 4.12% / 0.95);
+}
+.ah-btns {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 16px;
+  margin-top: 40px;
+}
+@media (min-width: 640px) {
+  .ah-btns {
+    flex-direction: row;
+    gap: 20px;
+  }
+}
+.ah-scroll {
+  position: absolute;
+  bottom: 40px;
+  left: 50%;
+  display: block;
+  width: 26px;
+  height: 44px;
+  border: 2px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.4);
+  border-radius: 14px;
+  translate: -50% 0;
+}
+.ah-scroll span {
+  position: absolute;
+  top: 8px;
+  left: 50%;
+  width: 4px;
+  height: 8px;
+  margin-left: -2px;
+  border-radius: 2px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80%);
+  animation: ah-dot 1.8s ease-in-out infinite;
+}
+@keyframes ah-dot {
+  60% {
+    opacity: 0;
+    transform: translateY(14px);
+  }
+}
+
+.ac {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --ad: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 12%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.86);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.14);
+  --card: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 11% / 0.7);
