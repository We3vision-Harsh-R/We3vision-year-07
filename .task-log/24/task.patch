+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The layout of the cinematic city as it was drawn: the title at the top (a soft blur behind it), the list of the industries at the left
+   in the middle, the info of the industry at the right in the middle, and the map between them as a road that runs straight up the
+   middle and narrows towards the horizon (strong perspective). The camera looks at the floor from 45 degrees. */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-scene {
+    perspective: 1000px;
+    perspective-origin: 50% 60%;
+  }
+  .cm-bird .cm-world {
+    left: 50%;
+    top: 62%;
+  }
+  .cm-bird .cm-ui {
+    grid-template-columns: 17rem minmax(0, 1fr) 23rem;
+    align-items: center;
+    padding-right: calc(clamp(1.5rem, 4vw, 4.5rem) + 9vw);
+    padding-bottom: 5vh;
+    padding-left: calc(clamp(1.5rem, 4vw, 4.5rem) + 7vw);
+  }
+  .cm-bird .cm-rail {
+    align-self: center;
+  }
+  .cm-bird .cm-panel {
+    grid-column: 3;
+    justify-self: stretch;
+    width: auto;
+    padding: 1.4rem 1.5rem 1.1rem;
+  }
+}
+
+/* the big names of the districts are a little smaller on the small map (the small signs keep their size, they are the ones to read) */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-name span {
+    scale: 0.7;
+  }
+}
