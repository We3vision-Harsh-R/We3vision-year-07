@@ -26251,3 +26251,68 @@ a.rt-row:hover {
   height: 1px;
   pointer-events: none;
 }
+
+/* ---- the list of the open roles, in the left column of Surat Junction ---- */
+.cj-jobs h3 {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.cj-jobs-count {
+  min-width: 34px;
+  padding: 2px 11px;
+  border-radius: 999px;
+  background: var(--a);
+  color: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 6%);
+  font-size: 1rem;
+  font-weight: 700;
+  text-align: center;
+}
+.cj-roles {
+  display: grid;
+  gap: 12px;
+  margin: 24px 0 0;
+  padding: 0;
+  list-style: none;
+}
+.cj-role {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 18px;
+  padding: 16px 18px 16px 22px;
+  border: 1px solid var(--hair);
+  border-radius: 18px;
+  background: var(--card);
+  transition:
+    border-color 0.25s,
+    translate 0.3s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.cj-role:hover {
+  translate: 4px 0;
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.4);
+}
+.cj-role-main {
+  display: block;
+  min-width: 0;
+  text-decoration: none;
+}
+.cj-role-t {
+  display: block;
+  color: #fff;
+  font-size: 1.25rem;
+  font-weight: 600;
+  letter-spacing: -0.02em;
+  line-height: 1.25;
+}
+.cj-role-m {
+  display: block;
+  margin-top: 4px;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  line-height: 1.45;
+}
+.cj-role-act {
+  display: flex;
+  gap: 10px;
+}
