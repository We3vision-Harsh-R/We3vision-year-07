--- a/a/src/app/globals.css
+++ b/b/src/app/globals.css
@@ -22834,3 +22834,222 @@ a.md-rel-card:hover .md-rel-go {
   font-size: 1.5rem;
   letter-spacing: 0.12em;
 }
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The reading sections of the Team page (components/site/sections/team-story.tsx), for laptop and desktop screens:
+   .tm  common colours      .tm-grid / .tm-head / .tm-body   the text with a heading that stays in place
+   .tj  the steps of a project on a line      .tv  numbered values */
+.tm {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.88);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.14);
+  --card: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 11% / 0.7);
+}
+.tm-grid {
+  display: grid;
+  gap: 48px;
+}
+@media (min-width: 1024px) {
+  .tm-grid {
+    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
+    gap: 88px;
+  }
+  .tm-head {
+    position: sticky;
+    top: 120px;
+    align-self: start;
+  }
+}
+.tm-h2 {
+  font-size: clamp(2.4rem, 4.4vw, 3.6rem);
+  line-height: 1.08;
+}
+.tm-intro {
+  margin: 24px 0 0;
+  max-width: 440px;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.7;
+}
+
+/* the text to read */
+.tm-body {
+  max-width: 640px;
+}
+.tm-body p {
+  margin: 0 0 1.5em;
+  color: var(--soft);
+  font-size: 1.125rem;
+  line-height: 1.85;
+}
+.tm-body p .text-violet {
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82%);
+}
+.tm-body .tm-lead {
+  color: #fff;
+  font-size: 1.5rem;
+  font-weight: 500;
+  letter-spacing: -0.015em;
+  line-height: 1.55;
+}
+.tm-quote {
+  position: relative;
+  margin: 2.6rem 0 0;
+  padding: 28px 30px 28px 34px;
+  border: 1px solid var(--hair);
+  border-radius: 20px;
+  background: var(--card);
+}
+.tm-quote::before {
+  content: "";
+  position: absolute;
+  top: 24px;
+  bottom: 24px;
+  left: 0;
+  width: 3px;
+  border-radius: 0 3px 3px 0;
+  background: linear-gradient(180deg, var(--a), hsl(calc(var(--th) + 326) calc(85% * var(--ts)) 62%));
+}
+.tm-quote blockquote {
+  margin: 0;
+  color: #fff;
+  font-size: 1.375rem;
+  font-weight: 500;
+  letter-spacing: -0.015em;
+  line-height: 1.5;
+}
+.tm-quote figcaption {
+  margin-top: 14px;
+  color: var(--a);
+  font-size: 0.9375rem;
+  font-weight: 500;
+}
+
+/* the steps of a project: numbered cards on a line, two rows of three */
+.tj {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 60px 24px;
+  margin: 84px 0 0;
+  padding: 0;
+  list-style: none;
+}
+.tj-item {
+  position: relative;
+  display: flex;
+}
+.tj-step {
+  --card-bg: hsl(calc(var(--th) + 347) calc(40% * var(--ts)) 10%);
+  position: relative;
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  padding: 28px 26px 30px;
+  border: 1px solid var(--hair);
+  border-radius: 22px;
+  background: var(--card);
+  transition:
+    border-color 0.4s,
+    translate 0.5s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.tj-step:hover {
+  translate: 0 -4px;
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.35);
+}
+/* a dot on the line above every card, and the line itself */
+.tj-item::before {
+  content: "";
+  position: absolute;
+  top: -29px;
+  left: 26px;
+  width: 11px;
+  height: 11px;
+  border-radius: 50%;
+  background: var(--a);
+  box-shadow: 0 0 0 5px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.18), 0 0 18px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.6);
+}
+.tj-item::after {
+  content: "";
+  position: absolute;
+  top: -24px;
+  left: 44px;
+  right: -24px;
+  height: 1px;
+  background: linear-gradient(90deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.5), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.12));
+}
+.tj-item:nth-child(3n)::after {
+  display: none;
+}
+.tj-no {
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.55);
+  font-size: 0.9375rem;
+  font-weight: 600;
+  letter-spacing: 0.12em;
+}
+.tj-step h3 {
+  margin: 14px 0 0;
+  color: #fff;
+  font-size: 1.5rem;
+  font-weight: 600;
+  letter-spacing: -0.025em;
+  line-height: 1.2;
+}
+.tj-who {
+  margin: 14px 0 0;
+  padding: 4px 12px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.35);
+  border-radius: 999px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.08);
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84%);
+  font-size: 0.875rem;
+  font-weight: 500;
+  line-height: 1.4;
+}
+.tj-text {
+  margin: 16px 0 0;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.7;
+}
+
+/* the values: a big number, a title and a few lines, row by row */
+.tv {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  border-top: 1px solid var(--hair);
+}
+.tv-row {
+  display: grid;
+  grid-template-columns: 76px minmax(0, 1fr);
+  gap: 8px;
+  padding: 30px 0;
+  border-bottom: 1px solid var(--hair);
+}
+.tv-no {
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.35);
+  font-size: 2.4rem;
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  line-height: 1;
+  transition: color 0.4s;
+}
+.tv-row:hover .tv-no {
+  color: var(--a);
+}
+.tv-row h3 {
+  margin: 0;
+  color: #fff;
+  font-size: 1.5rem;
+  font-weight: 600;
+  letter-spacing: -0.025em;
+  line-height: 1.25;
+}
+.tv-row p {
+  margin: 12px 0 0;
+  max-width: 540px;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.75;
+}
