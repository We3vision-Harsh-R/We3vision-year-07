+            {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
+              <circle key={i} cx="400" cy="150" r="3.4" fill={i % 2 ? "var(--g-a)" : "var(--g-w)"} style={{ "--a": `${i * 45}deg` } as CSSProperties} />
