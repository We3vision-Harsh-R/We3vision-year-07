+/* ---------------------------------------------------------------------------------------------------------------------------------
+   PANDA, the chat of the site (components/site/ai-chat.tsx): a slim bar and a small window above it. Only opacity and transform change
+   (no blur, no resizing), so it stays light. */
+.pd {
+  --ph: clamp(220px, 24vh, 300px); /* the height of the chat window */
+  position: relative;
+  width: clamp(320px, 61vw, 1216px);
+  max-width: calc(100vw - 24px);
+  pointer-events: auto;
+  isolation: isolate;
+}
+.pd-bar {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 54px;
+  padding: 0 9px 0 10px;
+  border: 1px solid rgba(255, 255, 255, 0.16);
+  border-radius: 999px;
+  background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 11% / 0.92);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.12),
+    0 14px 36px -14px rgba(0, 0, 0, 0.8);
+  transition: border-color 0.25s;
+}
+.pd[data-open="true"] .pd-bar {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.5);
+}
+.pd-icon,
+.pd-face {
+  display: grid;
+  flex: none;
+  place-items: center;
+  border-radius: 50%;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.16);
+}
+.pd-icon {
+  width: 36px;
+  height: 36px;
+}
+.pd-face {
+  width: 42px;
+  height: 42px;
+}
+.pd-icon svg {
+  width: 26px;
+}
+.pd-face svg {
+  width: 31px;
+}
+.pd-bar input {
+  flex: 1;
+  min-width: 0;
+  height: 100%;
+  border: 0;
+  outline: 0;
+  background: transparent;
+  color: #fff;
+  font: inherit;
+  font-size: 1rem;
+}
+.pd-bar input::placeholder {
+  color: hsl(calc(var(--th) + 352) calc(60% * var(--ts)) 84% / 0.75);
+}
+.pd-send {
+  display: grid;
+  flex: none;
+  place-items: center;
+  width: 38px;
+  height: 38px;
+  border-radius: 50%;
+  background: linear-gradient(135deg, hsl(calc(var(--th) + 76) calc(81% * var(--ts)) 87%), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%) 65%);
+  color: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 16%);
+  transition: transform 0.2s, opacity 0.2s;
+}
+.pd-send:disabled {
+  opacity: 0.4;
+}
+.pd-send:not(:disabled):hover {
+  transform: scale(1.06);
+}
+/* The blur behind the chat, a progressive blur: six thin layers, each a little blurrier than the one outside it. A layer only starts
+   where the one before it has reached full strength, so the blur grows smoothly from nothing at the outer edge to its strongest
+   (about 60%) round the window and the bar, and it fades out again the further it is from the centre. All distances follow the size of
+   the screen (vw / vh): --ax, --ay = the area of the strongest blur beyond the window, --fx, --fyt, --fyb = how far the blur fades out. */
+.pd {
+  --ax: clamp(24px, 5.8vw, 120px);
+  --ay: clamp(40px, 6vh, 90px);
+  --fx: clamp(48px, 6vw, 130px);
+  --fyt: calc(80vh - var(--ph) - 16px - var(--ay));
+  --fyb: clamp(24px, 3.8vh, 50px);
+}
+.pd-blur {
+  position: absolute;
+  top: calc(-1 * (var(--ph) + 16px + var(--ay) + var(--fyt)));
+  right: calc(-1 * (var(--ax) + var(--fx)));
+  bottom: calc(-1 * var(--fyb));
+  left: calc(-1 * (var(--ax) + var(--fx)));
+  z-index: -1;
+  visibility: hidden;
+  pointer-events: none;
+  opacity: 0;
+  transform: scale(0.5, 0.35);
+  transform-origin: 50% calc(100% - var(--fyb) - 27px);
+  transition:
+    opacity 0.3s ease-in,
+    transform 0.4s cubic-bezier(0.5, 0, 0.75, 0),
+    visibility 0s 0.4s;
+  will-change: transform, opacity;
+}
+.pd[data-open="true"] .pd-blur {
+  visibility: visible;
+  opacity: 1;
+  transform: none;
+  transition:
+    opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
+    transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.pd-blur i {
+  --n: 6;
+  position: absolute;
+  inset: 0;
+  -webkit-backdrop-filter: blur(calc(var(--b) * 1px));
+  backdrop-filter: blur(calc(var(--b) * 1px));
+  -webkit-mask-image:
+    linear-gradient(to right, transparent calc(var(--fx) * (var(--k) - 1) / var(--n)), #000 calc(var(--fx) * var(--k) / var(--n)), #000 calc(100% - var(--fx) * var(--k) / var(--n)), transparent calc(100% - var(--fx) * (var(--k) - 1) / var(--n))),
+    linear-gradient(to bottom, transparent calc(var(--fyt) * (var(--k) - 1) / var(--n)), #000 calc(var(--fyt) * var(--k) / var(--n)), #000 calc(100% - var(--fyb) * var(--k) / var(--n)), transparent calc(100% - var(--fyb) * (var(--k) - 1) / var(--n)));
+  -webkit-mask-composite: source-in;
+  mask-image:
+    linear-gradient(to right, transparent calc(var(--fx) * (var(--k) - 1) / var(--n)), #000 calc(var(--fx) * var(--k) / var(--n)), #000 calc(100% - var(--fx) * var(--k) / var(--n)), transparent calc(100% - var(--fx) * (var(--k) - 1) / var(--n))),
+    linear-gradient(to bottom, transparent calc(var(--fyt) * (var(--k) - 1) / var(--n)), #000 calc(var(--fyt) * var(--k) / var(--n)), #000 calc(100% - var(--fyb) * var(--k) / var(--n)), transparent calc(100% - var(--fyb) * (var(--k) - 1) / var(--n)));
+  mask-composite: intersect;
+}
+@media (max-width: 899px) {
+  .pd {
+    --ax: 6px;
+    --ay: 30px;
+    --fx: 22px;
+    --fyt: calc(62vh - var(--ph) - 16px - var(--ay));
+    --fyb: 26px;
+  }
+}
+/* the window above the bar: it grows out of the bar (the picture is uncovered from the bar upwards while it rises a little), the
+   words follow one after the other; closing is quicker than opening */
+.pd-panel {
+  position: absolute;
+  right: 0;
+  bottom: calc(100% + 16px);
+  left: 0;
+  display: flex;
+  height: var(--ph);
+  flex-direction: column;
+  overflow: hidden;
+  border: 1px solid rgba(255, 255, 255, 0.13);
+  border-radius: 24px;
+  background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 9% / 0.97);
+  box-shadow: 0 30px 70px -24px rgba(0, 0, 0, 0.85);
+  opacity: 0;
+  clip-path: inset(86% 4% 0 4% round 24px);
+  transform: translateY(18px);
+  transform-origin: 50% 100%;
+  pointer-events: none;
+  transition:
+    opacity 0.26s ease-in,
+    clip-path 0.34s cubic-bezier(0.5, 0, 0.75, 0),
+    transform 0.34s cubic-bezier(0.5, 0, 0.75, 0);
+  will-change: opacity, clip-path, transform;
+}
+.pd[data-open="true"] .pd-panel {
+  opacity: 1;
+  clip-path: inset(0 0 0 0 round 24px);
+  transform: none;
+  pointer-events: auto;
+  transition:
+    opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
+    clip-path 0.75s cubic-bezier(0.22, 1, 0.36, 1),
+    transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.pd-head,
+.pd-body > * {
+  opacity: 0;
+  transform: translateY(10px);
+  transition: opacity 0.2s ease, transform 0.2s ease;
+}
+.pd[data-open="true"] .pd-head,
+.pd[data-open="true"] .pd-body > * {
+  opacity: 1;
+  transform: none;
+  transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1) calc(0.16s + var(--d, 0) * 0.07s), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(0.16s + var(--d, 0) * 0.07s);
+}
+.pd-body > :nth-child(1) { --d: 1; }
+.pd-body > :nth-child(2) { --d: 2; }
+.pd-body > :nth-child(3) { --d: 3; }
+.pd-body > :nth-child(4) { --d: 4; }
+.pd-body > :nth-child(n + 5) { --d: 5; }
+/* the gap between the bar and the window belongs to the chat, so moving the mouse up does not close it */
+.pd::before {
+  content: "";
+  position: absolute;
+  right: 0;
+  bottom: 100%;
+  left: 0;
+  height: 18px;
+}
+/* a ring of light that spreads out from the bar each time the chat opens */
+.pd-ring {
+  position: absolute;
+  inset: -2px;
+  z-index: -1;
+  border: 1.5px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.65);
+  border-radius: 999px;
+  opacity: 0;
+  pointer-events: none;
+}
+.pd[data-open="true"] .pd-ring {
+  animation: pd-ring 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+@keyframes pd-ring {
+  0% {
+    opacity: 0.75;
+    transform: scale(1);
+  }
+  100% {
+    opacity: 0;
+    transform: scale(1.12, 2.6);
+  }
+}
+.pd-head {
+  display: flex;
+  flex: none;
+  align-items: center;
+  gap: 12px;
+  padding: 14px 16px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+}
+.pd-head div {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  line-height: 1.3;
+}
+.pd-head b {
+  color: #fff;
+  font-size: 1.0625rem;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+}
+.pd-head span {
+  color: hsl(calc(var(--th) + 350) calc(37% * var(--ts)) 80%);
+  font-size: 0.875rem;
+}
+.pd-body {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  flex-direction: column;
+  gap: 8px;
+  padding: 14px 16px 16px;
+  overflow-y: auto;
+  scrollbar-width: thin;
+  scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
+}
+.pd-msg {
+  max-width: min(86%, 46rem);
+  margin: 0;
+  padding: 9px 14px;
+  border-radius: 18px;
+  font-size: 1rem;
+  line-height: 1.45;
+}
+.pd-msg[data-role="assistant"] {
+  align-self: flex-start;
+  border-bottom-left-radius: 6px;
+  background: rgba(255, 255, 255, 0.09);
+  color: hsl(calc(var(--th) + 346) calc(66% * var(--ts)) 94%);
+}
+.pd-msg[data-role="user"] {
+  align-self: flex-end;
+  border-bottom-right-radius: 6px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.28);
