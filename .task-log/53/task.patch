+  inset: 0;
+  background: #000;
+  opacity: 0;
+  pointer-events: none;
+}
+/* the words of the page: only for search engines and screen readers (nothing is written on the screen while the office loads);
+   they are shown only when the 3D office cannot run at all */
+.vr-words {
