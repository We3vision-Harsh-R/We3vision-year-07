+  height: 9px;
+  background: var(--glow);
+  box-shadow: 0 0 12px var(--glow);
+}
+
+/* hidden until the diagram scrolls into view (only when JavaScript runs) */
+.flow[data-live="false"] .flow-box {
+  opacity: 0;
+  transform: translateY(14px);
+}
+.flow[data-live="false"] .flow-core {
+  opacity: 0;
+  transform: scale(0.92);
+}
+.flow[data-live="false"] .w-v,
+.flow[data-live="false"] .w-c {
+  transform: scaleY(0);
+}
+.flow[data-live="false"] .w-h {
+  transform: scaleX(0);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .flow:not([data-live="false"]) .pulse {
+    animation-duration: 2.8s;
+    animation-iteration-count: infinite;
+    animation-timing-function: linear;
+  }
+  .flow:not([data-live="false"]) .flow-core {
+    animation: flow-breathe 3.2s ease-in-out 2.2s infinite;
+  }
+  /* data flows down the top wires to the core */
+  .is-in .w-v .pulse {
+    animation-name: flow-down;
+    animation-delay: calc(var(--base) + 1500ms + var(--i) * 350ms);
+  }
+  .is-in .pulse-l {
+    left: 0;
+    background: linear-gradient(90deg, transparent, var(--glow));
+    animation-name: flow-in-l;
+    animation-delay: calc(var(--base) + 2400ms);
+  }
+  .is-in .pulse-r {
+    right: 0;
+    background: linear-gradient(270deg, transparent, var(--glow));
+    animation-name: flow-in-r;
+    animation-delay: calc(var(--base) + 2400ms);
+  }
+  .is-in .w-c .pulse {
+    animation-name: flow-down;
+    animation-delay: calc(var(--base) + 3300ms);
+  }
+  /* the actions leave through the bottom wires */
+  .is-out .w-c .pulse {
+    animation-name: flow-down;
+    animation-delay: calc(var(--base) + 1500ms);
+  }
+  .is-out .pulse-l {
+    left: 0;
+    background: linear-gradient(270deg, transparent, var(--glow));
+    animation-name: flow-out-l;
+    animation-delay: calc(var(--base) + 2400ms);
+  }
+  .is-out .pulse-r {
+    right: 0;
+    background: linear-gradient(90deg, transparent, var(--glow));
+    animation-name: flow-out-r;
+    animation-delay: calc(var(--base) + 2400ms);
+  }
+  .is-out .w-v .pulse {
+    animation-name: flow-down;
+    animation-delay: calc(var(--base) + 3300ms + var(--i) * 350ms);
+  }
+}
+@keyframes flow-down {
+  0% {
+    opacity: 0;
+    transform: translateY(-18px);
+  }
+  15% {
+    opacity: 1;
+  }
+  80% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+    transform: translateY(35px);
+  }
+}
+@keyframes flow-in-l {
+  0% {
+    opacity: 0;
+    left: -70px;
+  }
+  15%,
+  85% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+    left: calc(50% - 70px);
+  }
+}
+@keyframes flow-in-r {
+  0% {
+    opacity: 0;
+    right: -70px;
+  }
+  15%,
+  85% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+    right: calc(50% - 70px);
+  }
+}
+@keyframes flow-out-l {
+  0% {
+    opacity: 0;
+    left: calc(50% - 70px);
+  }
+  15%,
+  85% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+    left: -70px;
+  }
+}
+@keyframes flow-out-r {
+  0% {
+    opacity: 0;
+    right: calc(50% - 70px);
+  }
+  15%,
+  85% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+    right: -70px;
+  }
+}
+@keyframes flow-breathe {
+  0%,
+  100% {
+    box-shadow: 0 0 0 hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0);
+  }
+  50% {
+    box-shadow: 0 0 36px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.4);
+  }
+}
+@media (max-width: 899px) {
+  .flow {
+    padding: 28px 16px 24px;
+  }
+  .flow-row {
+    grid-template-columns: repeat(3, 1fr);
+    gap: 10px 0;
+  }
+  .flow-wires {
+    height: 36px;
+  }
+  .flow-wires > * {
+    display: none;
+  }
+  .flow-wires .w-c {
+    display: block;
+    top: 0;
+    height: 36px;
+  }
+}
+
+/* Sliding pills (project photos), measured from the Bungee template: every photo is 181 x 520 px on a 1376 px wide screen
+   (width = 0.348 x height), fully rounded top and bottom, 10 px apart, sliding left at about 59 px/s (3.25 s per photo). The
+   loop is seamless because the list is there twice and the track moves by exactly one list (in px, so a photo that grows does
+   not shift it). The sides fade over 13 % of the width and the lower part melts into the page.
+   Pointing at a photo stops the row and opens it into a rounded square as wide as three photos, growing equally to both sides
+   (the track slides half of the growth to the left): the other photos step aside, fade back, and the project info appears. */
+@property --melt {
+  syntax: "<percentage>";
+  inherits: true;
+  initial-value: 40%;
+}
+.arch-gallery {
+  --h: clamp(300px, 37.8vw, 560px);
+  --w: calc(var(--h) * 0.348); /* one pill */
+  --grow: calc(var(--w) * 2 + 20px); /* how much wider the opened photo gets (3 pills wide) */
+  position: relative;
+  overflow: hidden;
+  padding: 24px 0 8px;
+  /* the sides fade out and the lower part fades into the page itself (a mask, so the page shows through - no dark band) */
+  -webkit-mask-image:
+    linear-gradient(90deg, transparent 0%, #000 13.3%, #000 86.8%, transparent 100%),
+    linear-gradient(180deg, #000 calc(100% - var(--melt)), transparent 100%);
+  -webkit-mask-composite: source-in;
+  mask-image:
+    linear-gradient(90deg, transparent 0%, #000 13.3%, #000 86.8%, transparent 100%),
+    linear-gradient(180deg, #000 calc(100% - var(--melt)), transparent 100%);
+  mask-composite: intersect;
+  transition: --melt 0.5s;
+}
+.arch-gallery:has(.arch:hover, .arch:focus-visible) {
+  --melt: 0%; /* the opened photo is shown clear, all the way down */
+}
+.arch-track {
+  display: flex;
+  width: max-content;
+  translate: 0 0;
+  animation: arch-slide calc(var(--n, 8) * 3.25s) linear infinite;
+  transition: translate 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.arch-gallery:hover .arch-track,
+.arch-gallery:focus-within .arch-track {
+  animation-play-state: paused;
+}
+.arch-gallery:has(.arch:hover, .arch:focus-visible) .arch-track {
+  translate: calc(var(--grow) * -0.5) 0;
+}
+.arch-group {
+  display: flex;
+  gap: 10px;
+  margin: 0;
+  padding: 0 10px 0 0;
+  list-style: none;
+}
+.arch {
+  position: relative;
+  flex: none;
+  width: var(--w);
+  height: var(--h);
+  overflow: hidden;
+  border-radius: calc(var(--w) / 2); /* a full pill */
+  outline: none;
+  background:
+    radial-gradient(120% 70% at 30% 20%, rgba(255, 255, 255, 0.45), transparent 60%),
+    linear-gradient(170deg, var(--a), var(--b));
+  transition:
+    width 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
+    border-radius 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
+    opacity 0.5s,
+    filter 0.5s;
+}
+.arch-img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.arch:hover,
+.arch:focus-visible {
+  width: calc(var(--w) + var(--grow));
+  border-radius: 34px; /* soft corners: the pill becomes a rounded square */
+}
+.arch:hover .arch-img,
+.arch:focus-visible .arch-img {
+  transform: scale(1.04);
+}
+.arch-gallery:has(.arch:hover, .arch:focus-visible) .arch:not(:hover, :focus-visible) {
+  opacity: 0.5;
+  filter: blur(2px) saturate(0.8);
+}
+
+/* project info on the opened photo: a dark soft scrim at the bottom keeps the small text readable on any photo */
+.arch-info {
+  position: absolute;
+  inset: auto 0 0;
+  padding: 90px 30px 30px;
+  background: linear-gradient(180deg, transparent, hsl(calc(var(--th) + 340.71) calc(73.91% * var(--ts)) 4.51% / 0.78) 55%, hsl(calc(var(--th) + 340.71) calc(73.91% * var(--ts)) 4.51% / 0.9));
+  opacity: 0;
+  transform: translateY(14px);
+  transition: opacity 0.2s, transform 0.2s;
+  pointer-events: none;
+}
+.arch:hover .arch-info,
+.arch:focus-visible .arch-info {
+  opacity: 1;
+  transform: none;
+  transition: opacity 0.5s 0.25s, transform 0.6s 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.arch-cat {
+  display: inline-block;
+  padding: 6px 12px;
+  border: 1px solid rgba(255, 255, 255, 0.35);
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.1);
+  color: #fff;
+  font-size: 0.72rem;
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  -webkit-backdrop-filter: blur(8px);
+  backdrop-filter: blur(8px);
+}
+.arch-title {
+  margin: 12px 0 0;
+  color: #fff;
+  font-size: clamp(1.4rem, 2.1vw, 1.9rem);
+  font-weight: 600;
+  letter-spacing: -0.03em;
+  line-height: 1.1;
+}
+.arch-text {
+  display: -webkit-box;
+  -webkit-line-clamp: 3;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  margin: 10px 0 0;
+  max-width: 44ch;
+  color: hsl(calc(var(--th) + 347.11) calc(62.79% * var(--ts)) 91.57%);
+  font-size: 0.95rem;
+  line-height: 1.55;
+}
+
+@keyframes arch-slide {
+  to {
+    transform: translateX(calc(var(--n, 8) * (var(--w) + 10px) * -1));
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .arch-track {
+    animation: none;
+  }
+}
+
+/* Brand board section (about the service). It is a tall track with a pinned screen: the tag on top, the heading + text under it,
+   and below them the board (left) and the list of services (right). While you scroll, the guide walks the board from box to box,
+   the street lights up ahead of it and the list item next to the box it is at lights up. The board is 436 x 572 px: two columns
+   of 208 px with a 20 px street between them. */
+.bb-track {
+  position: relative;
+  height: 470vh;
+}
+.bb-stage {
+  position: sticky;
+  top: 0;
+  display: grid;
+  height: 100vh;
+  place-items: center;
+  overflow: hidden;
+  padding: 16px 0 104px; /* room for the menu pill at the bottom */
+  box-sizing: border-box;
+}
+.bb {
+  width: 1160px;
+  max-width: 100%;
+  padding: 0 40px;
+  zoom: var(--fit, 1);
+}
+.bb-top {
+  text-align: center;
+}
+.bb-head {
+  margin: 0 auto;
+  text-align: center;
+}
+.bb-row {
+  display: grid;
+  grid-template-columns: 436px 480px;
+  justify-content: center;
+  gap: 80px;
+  margin-top: 52px;
+}
+.bb-board {
+  position: relative;
+  width: 436px;
+  max-width: 100%;
+  height: 572px;
+}
+
+/* the streets: dark strips with a dashed middle line; the lit part grows down the main street (--fill) as the guide moves on */
+.bb-road,
+.bb-side {
+  position: absolute;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.14);
+  background: hsl(calc(var(--th) + 341.71) calc(77.78% * var(--ts)) 3.53% / 0.55);
+  box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.45);
+}
+.bb-road {
+  --fill: 0px;
+  top: 0;
+  bottom: 0;
+  left: 208px;
+  width: 20px;
+  border-radius: 10px;
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.22);
+}
+.bb-road::before,
+.bb-side::before {
+  content: "";
+  position: absolute;
+  background: repeating-linear-gradient(180deg, hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.26) 0 7px, transparent 7px 15px);
+}
+.bb-road::before {
+  top: 8px;
+  bottom: 8px;
+  left: 50%;
+  width: 2px;
+  margin-left: -1px;
+}
+.bb-road-fill {
+  position: absolute;
+  top: var(--top);
+  left: 50%;
+  width: 4px;
+  margin-left: -2px;
+  height: var(--fill);
+  border-radius: 2px;
+  background: linear-gradient(180deg, hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%));
+  box-shadow: 0 0 12px 2px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.75);
+  transition: height 0.9s cubic-bezier(0.3, 0.7, 0.2, 1);
+}
+.bb-side {
+  width: 208px;
+  height: 20px;
+  border-radius: 10px;
+}
+.bb-side::before {
+  left: 8px;
+  right: 8px;
+  top: 50%;
+  height: 2px;
+  margin-top: -1px;
+  background: repeating-linear-gradient(90deg, hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.2) 0 7px, transparent 7px 15px);
+}
+
+/* the boxes (as before: 208 px wide, 128 px or 276 px tall), each with a little gate on the side that faces the main street */
+.bb-tile {
+  position: absolute;
+  width: 208px;
+  cursor: pointer;
+  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.bb-in {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.16);
+  border-radius: 22px;
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 347.76) calc(58.62% * var(--ts)) 22.75% / 0.55), hsl(calc(var(--th) + 344) calc(65.22% * var(--ts)) 9.02% / 0.7));
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
+  opacity: 0.58;
+  transition:
+    border-color 0.5s,
+    box-shadow 0.5s,
+    opacity 0.5s;
+}
+.bb-tile:hover .bb-in {
+  opacity: 0.9;
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.4);
+}
+.bb-tile[data-on="true"] {
+  transform: translateY(-4px) scale(1.025);
+}
+.bb-tile[data-on="true"] .bb-in {
+  opacity: 1;
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.65);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.16),
+    0 18px 46px -12px hsl(calc(var(--th) + 347.27) calc(100% * var(--ts)) 67.65% / 0.55);
+}
+.bb-gate {
+  position: absolute;
+  top: 50%;
+  width: 6px;
+  height: 24px;
+  margin-top: -12px;
+  border-radius: 3px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.4);
+  transition: background 0.5s, box-shadow 0.5s;
+}
+.bb-tile[data-side="l"] .bb-gate {
+  right: -3px;
+}
+.bb-tile[data-side="r"] .bb-gate {
+  left: -3px;
+}
+.bb-tile[data-on="true"] .bb-gate {
+  background: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%);
+  box-shadow: 0 0 12px 2px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.85);
+}
+.bb-cap {
+  position: absolute;
+  left: 16px;
+  bottom: 14px;
+  font-size: 0.72rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.6);
+}
+
+/* 0 strategy = the start: target rings (the guide sits in the bullseye) and a flag */
+.bb-ring {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  translate: -50% -50%;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.35);
+  border-radius: 50%;
+}
+.bb-ring.r1 {
+  width: 104px;
+  height: 104px;
+}
+.bb-ring.r2 {
+  width: 68px;
+  height: 68px;
+}
+.bb-ring.r3 {
+  width: 36px;
+  height: 36px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.14);
+}
+.bb-tile[data-k="0"][data-on="true"] .bb-ring {
+  animation: bb-pulse 2.6s ease-out infinite;
+}
+.bb-tile[data-k="0"][data-on="true"] .bb-ring.r2 {
+  animation-delay: 0.25s;
+}
+.bb-tile[data-k="0"][data-on="true"] .bb-ring.r3 {
+  animation-delay: 0.5s;
+}
+@keyframes bb-pulse {
+  0%,
+  100% {
+    scale: 1;
+  }
+  35% {
+    scale: 1.12;
+    border-color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.8);
+  }
+}
+.bb-flag {
+  position: absolute;
+  top: 16px;
+  right: 20px;
+  width: 22px;
+  height: 34px;
+}
+.bb-flag i {
+  position: absolute;
+  inset: 0 auto 0 0;
+  width: 2px;
+  border-radius: 1px;
+  background: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.7);
+}
+.bb-flag b {
+  position: absolute;
+  top: 1px;
+  left: 2px;
+  width: 18px;
+  height: 13px;
+  background: linear-gradient(135deg, hsl(calc(var(--th) + 76) calc(81.25% * var(--ts)) 87.45%), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%));
+  clip-path: polygon(0 0, 100% 50%, 0 100%);
+}
+
+/* 1 logo: the mark turns up, a glow breathes behind it */
+.bb-tile[data-k="1"] .bb-in {
+  display: grid;
+  place-items: center;
+}
+.bb-tile[data-k="1"] .bb-in::before {
+  content: "";
+  position: absolute;
+  width: 190px;
+  height: 190px;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.4), transparent);
+  opacity: 0.35;
+  transition: opacity 0.6s;
+}
+.bb-tile[data-k="1"][data-on="true"] .bb-in::before {
+  opacity: 1;
+}
+.bb-logo-mark {
+  position: relative;
+  width: 104px;
+  height: 104px;
+  transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.bb-tile[data-k="1"][data-on="true"] .bb-logo-mark {
