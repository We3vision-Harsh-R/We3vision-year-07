+}
+
+/* 2 identity: type + colours */
+.bb-aa {
+  position: absolute;
+  top: 12px;
+  left: 18px;
+  font-size: 4.4rem;
+  font-weight: 600;
+  letter-spacing: -0.06em;
+  line-height: 1;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%);
+}
+.bb-swatches {
+  position: absolute;
+  left: 18px;
+  right: 18px;
+  bottom: 18px;
+  display: flex;
+}
+.bb-swatches i {
+  width: 34px;
+  height: 34px;
+  margin-right: -8px;
+  border-radius: 50%;
+  border: 2px solid hsl(calc(var(--th) + 346.97) calc(58.49% * var(--ts)) 10.39%);
+  transition: transform 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.3);
+}
+.bb-tile[data-k="2"][data-on="true"] .bb-swatches i {
