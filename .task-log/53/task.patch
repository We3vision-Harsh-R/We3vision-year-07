+  return (
+    <div className="max-w-4xl space-y-6">
+      <div>
+        <h1 className="text-2xl font-bold">Leads</h1>
+        <p className="mt-1 text-sm text-zinc-500">Messages sent through the website contact form (latest 100).</p>
