+  padding: 0 5px; /* the centre of every cell is exactly where its wire is */
+}
+.flow-box {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 9px;
+  height: 78px;
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.04));
+  color: hsl(calc(var(--th) + 347.5) calc(39.22% * var(--ts)) 80%);
+  font-size: 0.74rem;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  text-align: center;
+  transition:
+    opacity 0.6s ease,
+    transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
+    border-color 0.3s,
+    color 0.3s,
+    background 0.3s;
+  transition-delay: calc(var(--base, 0ms) + var(--k, 0) * 90ms), calc(var(--base, 0ms) + var(--k, 0) * 90ms), 0s, 0s, 0s;
+}
+.flow-box:hover {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.5);
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.12));
+  color: #fff;
