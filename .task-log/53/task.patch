new file mode 100644
index 0000000..6242c55
--- /dev/null
+++ b/b/src/actions/admin-access.ts
@@ -0,0 +1,77 @@
+"use server";
+
+import bcrypt from "bcryptjs";
+import { revalidatePath } from "next/cache";
+import { z } from "zod";
+import { ADMIN_DOMAIN, LOGIN_SETTING_KEY, cleanLoginImage, isCompanyEmail } from "@/lib/admin-access";
+import { requireAdmin } from "@/lib/auth";
+import { db } from "@/lib/db";
+import type { ActionResult } from "./types";
+
+const passwordRule = z.string().min(12, "The password needs at least 12 characters.").max(200);
+const nameRule = z.string().trim().min(1, "Enter a name.").max(80);
+
+/** The picture on the right of the login page. An empty value goes back to the default picture. */
+export async function saveLoginImage(input: unknown): Promise<ActionResult> {
+  await requireAdmin();
+  const raw = typeof input === "string" ? input.trim() : "";
+  const image = cleanLoginImage(raw);
+  if (raw && !image) return { ok: false, error: "That picture address is not allowed. Upload a picture, or use /images/… or https://…" };
+  try {
+    await db.setting.upsert({ where: { key: LOGIN_SETTING_KEY }, create: { key: LOGIN_SETTING_KEY, value: { image } }, update: { value: { image } } });
+    revalidatePath("/admin/login");
+    return { ok: true, message: image ? "The login page picture is updated." : "The login page has its original picture again." };
+  } catch (error) {
+    console.error("saveLoginImage failed", error);
+    return { ok: false, error: "Could not save the picture. Please try again." };
+  }
+}
+
+/** Adds an admin user. Only e-mail addresses of the company domain are accepted. */
+export async function createAdminUser(input: { name?: unknown; email?: unknown; password?: unknown }): Promise<ActionResult> {
+  await requireAdmin();
+  const email = String(input.email ?? "").trim().toLowerCase();
+  if (!isCompanyEmail(email)) return { ok: false, error: `Only an e-mail address ending in @${ADMIN_DOMAIN} can be added.` };
+  const name = nameRule.safeParse(input.name);
+  if (!name.success) return { ok: false, error: name.error.issues[0].message };
+  const password = passwordRule.safeParse(input.password);
+  if (!password.success) return { ok: false, error: password.error.issues[0].message };
+  try {
+    if (await db.adminUser.findUnique({ where: { email } })) return { ok: false, error: "There is already a user with this e-mail address." };
+    await db.adminUser.create({ data: { email, name: name.data, passwordHash: await bcrypt.hash(password.data, 12) } });
+    revalidatePath("/admin/access");
+    return { ok: true, message: `${email} can now sign in.` };
+  } catch (error) {
+    console.error("createAdminUser failed", error);
+    return { ok: false, error: "Could not add the user. Please try again." };
+  }
+}
+
+/** A new password for a user (the old one stops working). */
+export async function setAdminPassword(id: string, password: unknown): Promise<ActionResult> {
+  await requireAdmin();
+  const parsed = passwordRule.safeParse(password);
+  if (!parsed.success) return { ok: false, error: parsed.error.issues[0].message };
+  try {
+    await db.adminUser.update({ where: { id }, data: { passwordHash: await bcrypt.hash(parsed.data, 12) } });
+    return { ok: true, message: "The password is changed." };
+  } catch (error) {
+    console.error("setAdminPassword failed", error);
+    return { ok: false, error: "Could not change the password. Please try again." };
+  }
+}
+
+/** Removes an admin user (their login stops working at once). You cannot remove yourself, and the last user cannot be removed. */
+export async function deleteAdminUser(id: string): Promise<ActionResult> {
+  const me = await requireAdmin();
+  if (me.id === id) return { ok: false, error: "You cannot remove the user you are signed in with." };
+  try {
+    if ((await db.adminUser.count()) <= 1) return { ok: false, error: "The last user cannot be removed." };
+    await db.adminUser.delete({ where: { id } });
+    revalidatePath("/admin/access");
+    return { ok: true, message: "The user is removed." };
+  } catch (error) {
+    console.error("deleteAdminUser failed", error);
+    return { ok: false, error: "Could not remove the user. Please try again." };
+  }
+}
diff --git a/b/src/actions/auth.ts b/b/src/actions/auth.ts
new file mode 100644
index 0000000..bb48e2c
--- /dev/null
+++ b/b/src/actions/auth.ts
@@ -0,0 +1,49 @@
+"use server";
+
+import bcrypt from "bcryptjs";
+import { redirect } from "next/navigation";
+import { z } from "zod";
+import { ADMIN_DOMAIN, isCompanyEmail } from "@/lib/admin-access";
+import { createSession, destroySession } from "@/lib/auth";
+import { db, hasDb } from "@/lib/db";
+import { rateLimit } from "@/lib/rate-limit";
+import { clientIp } from "@/lib/request";
+import { REMEMBER_MAX_AGE, SESSION_MAX_AGE } from "@/lib/session-token";
+
+export type LoginState = { error?: string };
+
+const credentials = z.object({ email: z.email().max(200), password: z.string().min(1).max(200) });
+
+// Compared against when the email is unknown, so response time doesn't reveal which emails exist.
+let dummyHash: string | undefined;
+
+export async function login(_prev: LoginState, formData: FormData): Promise<LoginState> {
+  if (!rateLimit(`login:${await clientIp()}`, 10, 15 * 60_000)) {
+    return { error: "Too many attempts. Please wait 15 minutes and try again." };
+  }
+  const parsed = credentials.safeParse({
+    email: String(formData.get("email") ?? "").trim().toLowerCase(),
+    password: formData.get("password"),
+  });
+  if (!parsed.success) return { error: "Enter a valid email and password." };
+  if (!isCompanyEmail(parsed.data.email)) return { error: `Please sign in with your @${ADMIN_DOMAIN} email address.` };
+  if (!hasDb || !process.env.SESSION_SECRET) return { error: "Server is not configured yet (DATABASE_URL / SESSION_SECRET)." };
+
+  try {
+    const user = await db.adminUser.findUnique({ where: { email: parsed.data.email } });
+    dummyHash ??= bcrypt.hashSync("not-a-real-password", 12);
+    const valid = await bcrypt.compare(parsed.data.password, user?.passwordHash ?? dummyHash);
+    if (!user || !valid) return { error: "Invalid email or password." };
+    await db.adminUser.update({ where: { id: user.id }, data: { lastLoginAt: new Date() } });
+    await createSession(user.id, formData.get("remember") ? REMEMBER_MAX_AGE : SESSION_MAX_AGE);
+  } catch (error) {
+    console.error("login failed", error);
+    return { error: "Something went wrong. Please try again." };
+  }
+  redirect("/admin");
+}
+
+export async function logout() {
+  await destroySession();
+  redirect("/admin/login");
+}
diff --git a/b/src/actions/blog.ts b/b/src/actions/blog.ts
new file mode 100644
index 0000000..da4d5c5
--- /dev/null
+++ b/b/src/actions/blog.ts
@@ -0,0 +1,168 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { requireAdmin } from "@/lib/auth";
+import { db } from "@/lib/db";
+import { Prisma } from "@/generated/prisma/client";
+import { isSafeHref } from "@/lib/cms/fields";
+import { parseFaq, parseTags, tileOf } from "@/lib/blog-shared";
+import type { ActionResult } from "./types";
+
+// The articles of the blog (Blog in the admin panel). Every action first checks that the admin is logged in, and cleans the input.
+
+export type BlogInput = {
+  title?: unknown;
+  category?: unknown;
+  summary?: unknown;
+  cover?: unknown;
+  tile?: unknown;
+  content?: unknown;
+  tags?: unknown;
+  faq?: unknown;
+  date?: unknown;
+  position?: unknown;
+  published?: unknown;
+};
+
+const text = (v: unknown, max: number, line = true) => {
+  let s = typeof v === "string" ? v : "";
+  if (line) s = s.replace(/[\r\n]+/g, " ");
+  return s.trim().slice(0, max);
+};
+const link = (v: unknown) => {
+  const s = text(v, 500);
+  return isSafeHref(s) ? s : "";
+};
+
+function clean(input: BlogInput) {
+  const title = text(input.title, 140);
+  if (!title) throw new Error("Please write the title of the article.");
+  const date = /^\d{4}-\d{2}-\d{2}$/.test(String(input.date ?? "")) ? new Date(`${input.date}T00:00:00.000Z`) : new Date();
+  const faq = parseFaq(text(input.faq, 6000, false)).slice(0, 12);
+  return {
+    title,
+    category: text(input.category, 40),
+    summary: text(input.summary, 300),
+    cover: link(input.cover),
+    tile: tileOf(input.tile),
+    content: text(input.content, 60000, false),
+    tags: parseTags(text(input.tags, 600, false)) as unknown as Prisma.InputJsonValue,
+    faq: faq as unknown as Prisma.InputJsonValue,
+    publishedAt: Number.isNaN(date.getTime()) ? new Date() : date,
+    published: input.published !== false,
+  };
+}
+
+const slugify = (s: string) =>
+  s
+    .toLowerCase()
+    .normalize("NFKD")
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 80) || "article";
+
+async function freeSlug(title: string, ignoreId?: string) {
+  const base = slugify(title);
+  for (let n = 1; n < 200; n++) {
+    const slug = n === 1 ? base : `${base}-${n}`;
+    const hit = await db.blogPost.findUnique({ where: { slug }, select: { id: true } });
+    if (!hit || hit.id === ignoreId) return slug;
+  }
+  return `${base}-${Date.now()}`;
+}
+
+/** The Blog page, the articles and the sitemap must be built again (the pages are kept ready for speed). */
+function refresh() {
+  revalidatePath("/", "layout");
+}
+
+/** Puts an article at a place of the list (1 = first) and numbers the whole list again. */
+async function place(id: string, position: number) {
+  const list = await db.blogPost.findMany({ orderBy: [{ sortOrder: "asc" }, { publishedAt: "desc" }], select: { id: true } });
+  const ids = list.map((p) => p.id).filter((x) => x !== id);
+  const at = Math.min(Math.max(Math.round(position) - 1, 0), ids.length);
+  ids.splice(at, 0, id);
+  await db.$transaction(ids.map((x, n) => db.blogPost.update({ where: { id: x }, data: { sortOrder: n + 1 } })));
+}
+
+const asPosition = (v: unknown) => {
+  const n = typeof v === "number" ? v : Number(v);
+  return Number.isFinite(n) && n >= 1 ? n : null;
+};
+
+const fail = (error: unknown): ActionResult => ({
+  ok: false,
+  error: error instanceof Error && error.message.startsWith("Please") ? error.message : "Could not save the article. Please try again.",
+});
+
+export async function createBlogPost(input: BlogInput): Promise<ActionResult & { id?: string }> {
+  await requireAdmin();
+  try {
+    const data = clean(input);
+    const last = await db.blogPost.aggregate({ _max: { sortOrder: true } });
+    const row = await db.blogPost.create({ data: { ...data, slug: await freeSlug(data.title), sortOrder: (last._max.sortOrder ?? 0) + 1 }, select: { id: true } });
+    const position = asPosition(input.position);
+    if (position) await place(row.id, position);
+    refresh();
+    return { ok: true, message: "Article added.", id: row.id };
+  } catch (error) {
+    return fail(error);
+  }
+}
+
+export async function updateBlogPost(id: string, input: BlogInput): Promise<ActionResult> {
+  await requireAdmin();
+  try {
+    const data = clean(input);
+    const old = await db.blogPost.findUnique({ where: { id }, select: { title: true, slug: true } });
+    if (!old) return { ok: false, error: "This article does not exist any more." };
+    // the address of the article only changes when the title changes
+    const slug = old.title === data.title ? old.slug : await freeSlug(data.title, id);
+    await db.blogPost.update({ where: { id }, data: { ...data, slug } });
+    const position = asPosition(input.position);
+    if (position) await place(id, position);
+    refresh();
+    return { ok: true, message: "Saved. The website is updated." };
+  } catch (error) {
+    return fail(error);
+  }
+}
+
+export async function deleteBlogPost(id: string): Promise<ActionResult> {
+  await requireAdmin();
+  try {
+    await db.blogPost.delete({ where: { id } });
+    refresh();
+    return { ok: true, message: "Article deleted." };
+  } catch {
+    return { ok: false, error: "Could not delete the article." };
+  }
+}
+
+/** Moves an article one place up or down in the list of the Blog page. */
+export async function moveBlogPost(id: string, direction: "up" | "down"): Promise<ActionResult> {
+  await requireAdmin();
+  try {
+    const list = await db.blogPost.findMany({ orderBy: [{ sortOrder: "asc" }, { publishedAt: "desc" }], select: { id: true } });
+    const i = list.findIndex((p) => p.id === id);
+    const j = direction === "up" ? i - 1 : i + 1;
+    if (i < 0 || j < 0 || j >= list.length) return { ok: true, message: "" };
+    [list[i], list[j]] = [list[j], list[i]];
+    await db.$transaction(list.map((p, n) => db.blogPost.update({ where: { id: p.id }, data: { sortOrder: n + 1 } })));
+    refresh();
+    return { ok: true, message: "Moved." };
+  } catch {
+    return { ok: false, error: "Could not move the article." };
+  }
+}
+
+export async function setBlogPostPublished(id: string, published: boolean): Promise<ActionResult> {
+  await requireAdmin();
+  try {
+    await db.blogPost.update({ where: { id }, data: { published } });
+    refresh();
+    return { ok: true, message: published ? "Shown on the website." : "Hidden from the website." };
+  } catch {
+    return { ok: false, error: "Could not change the article." };
+  }
+}
