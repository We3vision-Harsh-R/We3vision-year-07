+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Tech space: the whole section (heading, hint and the planets) fits in the height of the screen, the orbit lines are white, and the orbit of
+   the planet you hover (or whose pop-up is open) lights up while the other orbits go quiet. */
+@media (min-width: 901px) {
+  .ts {
+    height: 100svh;
+    min-height: 40rem;
+    justify-content: flex-start;
+    /* room at the bottom for the menu pill, so that no planet is behind it */
+    padding: 4.5rem 0 5.6rem;
+  }
+  .ts-head h2 {
+    margin-top: 0.9rem;
+    font-size: clamp(1.9rem, 3.2vw, 2.8rem);
+  }
+  .ts-wrap {
+    display: flex;
+    min-height: 0;
+    flex: 1;
+    flex-direction: column;
+  }
+  .ts-hint {
+    margin-top: 0.6rem;
+  }
+  .ts-stage {
+    width: 100%;
+    min-height: 22rem;
+    flex: 1;
+    height: auto;
+    margin-top: 0.4rem;
+  }
+}
+.ts-orbit {
+  border-color: rgba(255, 255, 255, 0.2);
+  box-shadow:
+    0 0 18px rgba(255, 255, 255, 0.05),
+    inset 0 0 18px rgba(255, 255, 255, 0.03);
+  transition: border-color 0.35s, box-shadow 0.35s;
+}
+.ts-stage:has(.ts-planet:hover, .ts-planet[aria-expanded="true"]) .ts-orbit {
+  border-color: rgba(255, 255, 255, 0.08);
+  box-shadow: none;
+}
+.ts-stage .ts-orbit:has(.ts-planet:hover, .ts-planet[aria-expanded="true"]) {
+  border-color: rgba(255, 255, 255, 0.95);
+  box-shadow:
+    0 0 14px rgba(255, 255, 255, 0.55),
+    0 0 46px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.35),
+    inset 0 0 18px rgba(255, 255, 255, 0.12);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The end of the pinned city: when the industries are finished and the next section comes up, only the TITLE of the section ("Built for every
+   industry") goes out of focus and fades (--out from 0 to 1, set in industries-road.tsx while the city scrolls away). */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-head {
+    filter: blur(calc(var(--out, 0) * 18px));
+    opacity: calc(1 - var(--out, 0) * 0.85);
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Tech space: its title sticks at the top (at the same place where the title of the industries was) while the section goes by: the planets
+   scroll away under it (it has a soft background so that they do not run through the letters). Desktop only. */
+@media (min-width: 901px) {
+  .ts {
+    padding-top: 0;
+  }
+  .ts-head {
+    position: sticky;
+    top: 0;
+    z-index: 5;
+    padding: 3.4rem 1rem 1.6rem;
+    /* no coloured band behind the title any more (it showed as a dark stripe across the page): the planets that pass under it are only blurred, by the
+       layer below, which fades out at the top and at the bottom */
+    background: none;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The big menu (mega-menu.tsx) as a pop-up: it grows out of the menu at the bottom of the page (from the bottom up), opens when the mouse comes onto
+   any button of that menu, and has the AI chat at the very top, then who we are with the recognitions, and the links of all pages as lists whose items
+   are plain lists (services and technology side by side, the other pages under them). Everything inside rises in one after the other. */
+.mm {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.84);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.16);
+  --pop-bottom: 92px; /* above the round menu button */
+  position: fixed;
+  inset: 0;
+  z-index: 48;
+  visibility: hidden;
+  pointer-events: none;
+  transition: visibility 0s 0.5s;
+}
+@media (min-width: 640px) {
+  .mm {
+    --pop-bottom: calc(3rem + 54px + 16px); /* above the pill */
+  }
+}
+.mm[data-open="true"] {
+  visibility: visible;
+  transition: none;
+}
+/* the page behind goes soft (it only catches clicks when the menu was opened with a click) */
+.mm-back {
+  position: absolute;
+  inset: 0;
+  background: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9% / 0.45);
+  -webkit-backdrop-filter: blur(9px);
+  backdrop-filter: blur(9px);
+  opacity: 0;
+  transition: opacity 0.45s;
+}
+.mm[data-open="true"] .mm-back {
+  opacity: 1;
+}
+.mm[data-sticky="true"] .mm-back {
+  pointer-events: auto;
+}
+.mm-pop {
+  position: absolute;
+  bottom: var(--pop-bottom);
+  right: 0;
+  left: 0;
+  display: flex;
+  width: min(1280px, calc(100vw - 24px));
+  max-height: calc(100svh - var(--pop-bottom) - 1.5rem);
+  margin-inline: auto;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.2);
+  border-radius: 30px;
+  background:
+    radial-gradient(70% 60% at 100% 0, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.16), transparent 70%),
+    hsl(calc(var(--th) + 347.58) calc(60% * var(--ts)) 7% / 0.9);
+  -webkit-backdrop-filter: blur(30px) saturate(1.4);
+  backdrop-filter: blur(30px) saturate(1.4);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 40px 90px -30px rgba(0, 0, 0, 0.85);
+  pointer-events: auto;
+  transform-origin: 50% 100%;
+  opacity: 0;
+  transform: translateY(60px) scale(0.82);
+  clip-path: inset(60% 14% 0 14% round 30px);
+  transition:
+    opacity 0.28s ease-in,
+    transform 0.4s cubic-bezier(0.5, 0, 0.75, 0),
+    clip-path 0.4s cubic-bezier(0.5, 0, 0.75, 0);
+}
+.mm[data-open="true"] .mm-pop {
+  opacity: 1;
+  transform: none;
+  clip-path: inset(0 0 0 0 round 30px);
+  transition:
+    opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
+    transform 0.85s cubic-bezier(0.22, 1.1, 0.36, 1),
+    clip-path 0.85s cubic-bezier(0.22, 1, 0.36, 1);
+}
+/* a bridge down to the menu, so that the mouse can go from the menu up to the pop-up without it closing */
+.mm-bridge {
+  position: absolute;
+  top: 100%;
+  right: 0;
+  left: 0;
+  height: 24px;
+}
+.mm-in {
+  width: 100%;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  padding: clamp(1.5rem, 2.6vw, 2.3rem);
+  border-radius: inherit;
+  scrollbar-width: none;
+}
+.mm-in::-webkit-scrollbar {
