+/* ---- the black of the 3D scenes dissolves into the page (sections/vr-emerge.tsx) ---- */
+.ve {
+  position: relative;
+  z-index: 5;
+  height: 120svh;
+  margin-bottom: -60svh;
+  pointer-events: none;
+}
+.ve-black {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(180deg, #000 0%, #000 14%, rgba(0, 0, 0, 0.86) 28%, rgba(0, 0, 0, 0.55) 46%, rgba(0, 0, 0, 0.22) 66%, rgba(0, 0, 0, 0.05) 84%, transparent 100%);
+}
+.ve-blur {
+  position: absolute;
+  inset: 0;
+}
+.ve-blur i {
+  --n: 6;
+  position: absolute;
+  inset: 0;
+  -webkit-backdrop-filter: blur(calc(var(--b) * 1px));
+  backdrop-filter: blur(calc(var(--b) * 1px));
+  -webkit-mask-image: linear-gradient(180deg, #000 0, #000 calc(100% - var(--k) * 15%), transparent calc(100% - var(--k) * 15% + 28%));
+  mask-image: linear-gradient(180deg, #000 0, #000 calc(100% - var(--k) * 15%), transparent calc(100% - var(--k) * 15% + 28%));
+}
