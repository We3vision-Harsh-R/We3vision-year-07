+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The view inside the headset (components/site/metaverse/vr-space.tsx): a random space behind a soft blur and three glass windows that
+   come to the middle one after the other while scrolling. */
+.vs {
+  position: relative;
+  height: calc(100svh * (2.4 + var(--n) * 1.4));
+  background: #000;
+}
+.vs[data-pin="false"] {
+  height: auto;
+}
+.vs-stage {
+  position: sticky;
+  top: 0;
+  height: 100svh;
+  overflow: hidden;
+  background: #000;
+}
+.vs[data-pin="false"] .vs-stage {
+  position: relative;
+  height: auto;
+  padding: 5rem 1rem 6rem;
+}
+/* the space: slightly blurred and a little larger than the screen, it drifts while you scroll */
+.vs-bg {
+  position: absolute;
+  inset: -6%;
+  opacity: 0;
+  will-change: transform, opacity;
+}
+.vs[data-pin="false"] .vs-bg {
+  position: absolute;
+  inset: 0;
+  opacity: 1;
+}
+.vs-bg-canvas {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  filter: blur(3.5px) saturate(1.2) brightness(0.92);
+}
+.vs-haze {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background:
+    radial-gradient(ellipse at 50% 48%, transparent 38%, rgba(2, 1, 8, 0.6) 100%),
+    linear-gradient(180deg, rgba(2, 1, 8, 0.25), transparent 30%, transparent 70%, rgba(2, 1, 8, 0.35));
+}
+/* depth of field: the top and the bottom of the picture get a stronger blur that fades out towards the middle */
+.vs-fade {
+  position: absolute;
+  right: 0;
+  left: 0;
+  z-index: 1;
+  height: 24%;
+  pointer-events: none;
+  -webkit-backdrop-filter: blur(9px);
+  backdrop-filter: blur(9px);
+}
+.vs-fade-t {
+  top: 0;
+  -webkit-mask-image: linear-gradient(180deg, #000, transparent);
+  mask-image: linear-gradient(180deg, #000, transparent);
+}
+.vs-fade-b {
