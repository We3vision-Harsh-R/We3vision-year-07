+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The pinned strip WITH its detail card under it (the service pages: the points of the open panel): the chip and the heading are pinned with it, below
+   the logo, and the whole block (heading, strip, detail card, progress line) has to fit in the screen. So the block starts a little higher, the
+   description under the heading is left out (the card says it) and the panels are a little lower than on the About page. */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .ss-track[data-head="true"][data-detail="true"] .ss-sticky {
+    padding-top: 5.4rem;
+    padding-bottom: 1.2rem;
+  }
+  .ss-track[data-head="true"][data-detail="true"] .ss-head {
+    margin-bottom: 1.2rem;
+  }
+  .ss-track[data-head="true"][data-detail="true"] .ss-h-h2 {
+    margin-top: 0.7rem;
+    font-size: clamp(1.8rem, 3vw, 2.6rem);
+  }
+  .ss-track[data-head="true"][data-detail="true"] .ss-h-p {
+    display: none;
+  }
+  .ss-track[data-head="true"][data-detail="true"][data-pin="true"] .ss-p {
+    height: clamp(16rem, 36svh, 23rem);
+  }
+  .ss-track[data-head="true"][data-detail="true"] .ss-prog {
+    margin-top: 1rem;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Glass cards, everywhere: the cards had a strong coloured light (violet in one corner, pink in the other); now the colour is minimal and the cards
+   are frosted glass: a see-through dark tint, a soft white sheen from the top-left corner, a fine light edge and a blur of what is behind them.
+   The border glow (.bglow) keeps its own colours; its inside fill is the colour of the glass, so a card does not change tone when the glow comes. */
+.card-glass,
+.ac-item,
+.ac-meet,
+.rs-card,
+.go-card,
+.fa-card,
+.sy-card,
+.bud,
+.sx-tab,
+.sx-panel {
+  background:
+    linear-gradient(155deg, hsl(0 0% 100% / 0.075) 0%, hsl(0 0% 100% / 0.025) 42%, hsl(0 0% 100% / 0.01) 100%),
+    hsl(calc(var(--th) + 347) calc(38% * var(--ts)) 9% / 0.52);
+  -webkit-backdrop-filter: blur(14px) saturate(1.15);
+  backdrop-filter: blur(14px) saturate(1.15);
+  box-shadow:
+    inset 0 1px 0 hsl(0 0% 100% / 0.11),
+    inset 0 0 0 1px hsl(0 0% 100% / 0.035);
+}
+.bglow {
+  --card-bg: hsl(calc(var(--th) + 347) calc(40% * var(--ts)) 10%);
+}
+.sx-tab[data-on="true"] {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.4);
+  background:
+    linear-gradient(155deg, hsl(0 0% 100% / 0.12) 0%, hsl(0 0% 100% / 0.04) 50%, hsl(0 0% 100% / 0.015) 100%),
+    hsl(calc(var(--th) + 347) calc(38% * var(--ts)) 11% / 0.6);
+}
+/* the open panel of the strip: the coloured light in it is much softer, and its shadow is not violet any more */
+.ss-glow {
+  background: radial-gradient(90% 70% at 15% 0%, hsl(calc(var(--th) + 354 + var(--k) * 12) calc(60% * var(--ts)) 68% / 0.1), transparent 65%);
+}
+.ss-track .ss-p[data-active="true"] {
+  box-shadow:
+    inset 0 1px 0 hsl(0 0% 100% / 0.16),
+    0 26px 56px -36px rgba(0, 0, 0, 0.7);
+}
+.sx-art {
+  background:
+    radial-gradient(90% 120% at 50% 110%, hsl(calc(var(--th) + 354) calc(80% * var(--ts)) 62% / 0.13), transparent 70%),
+    radial-gradient(circle, hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.1) 1px, transparent 1.5px) 0 0 / 22px 22px,
+    hsl(calc(var(--th) + 349) calc(40% * var(--ts)) 7% / 0.6);
+}
+
+/* the menu pop-up: the same border glow as the cards (components/site/mega-menu.tsx); its coloured corner light is softer too */
+.mm-pop {
+  --card-bg: hsl(calc(var(--th) + 347.58) calc(55% * var(--ts)) 8%);
+  background:
+    linear-gradient(155deg, hsl(0 0% 100% / 0.06) 0%, hsl(0 0% 100% / 0.015) 45%, transparent 100%),
+    hsl(calc(var(--th) + 347.58) calc(55% * var(--ts)) 7% / 0.86);
+}
+.mm[data-open="true"] .mm-pop {
+  /* a little room round the pop-up, so that the glow outside the border is not cut off */
+  clip-path: inset(-44px -44px -44px -44px round 30px);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Smoothness and readability, for the whole site.
+   - The blur behind the glass cards costs a lot on phones and tablets (it is repainted on every scroll frame), so it is only used with a mouse on a wide
+     screen; elsewhere the glass is the same see-through tint without the blur (the sky behind is soft anyway).
+   - The small uppercase labels of the panels were 11 to 12 px: 14 px is the smallest text of the site. */
+@media (max-width: 1023px), (hover: none) {
+  .card-glass,
+  .ac-item,
+  .ac-meet,
+  .rs-card,
+  .go-card,
+  .fa-card,
+  .sy-card,
+  .bud,
+  .sx-tab,
+  .sx-panel {
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
+.ss-d-label,
+.ss-info b,
+.ss-good,
+.ss-prog-t,
+.ss-prog-n,
+.tl-tag,
+.at-count {
+  font-size: 0.875rem;
+}
+
+/* the figures that are off the screen stand still (components/site/pause-offscreen.tsx): their animations are paused, not removed */
+.ch[data-off="true"],
+.ch[data-off="true"] * {
+  animation-play-state: paused !important;
+}
+
+/* PANDA bar: the width of the closed bar in the hero is the width of the menu pill. */
+@media (min-width: 640px) {
