+  padding: 1.5rem 1.5rem 1.6rem;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.16);
+  border-radius: 22px;
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.08), hsl(calc(var(--th) + 346) calc(60% * var(--ts)) 8% / 0.7));
+  list-style: none;
+}
+.sk-step-no {
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.9);
+  font-size: 0.9375rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+}
+.sk-step h3 {
+  margin: 0.6rem 0 0;
+  color: #fff;
+  font-size: 1.3rem;
+  font-weight: 600;
+  letter-spacing: -0.02em;
+}
+.sk-step p {
+  margin: 0.5rem 0 0;
+  color: hsl(calc(var(--th) + 354) calc(40% * var(--ts)) 82%);
+  font-size: 1rem;
