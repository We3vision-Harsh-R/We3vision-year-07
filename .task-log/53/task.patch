+.to2 {
+  position: relative;
+  inset: auto;
+  width: 100%;
+  min-height: 520px;
+  overflow: hidden;
+  background: hsl(calc(var(--th) + 347.58) calc(66% * var(--ts)) 7.4% / 0.7);
+  /* the top and the bottom melt into the sections around the office, so that there is no hard edge */
