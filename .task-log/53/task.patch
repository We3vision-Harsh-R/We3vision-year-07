+            <circle r="108" fill="hsl(calc(var(--th) + 346) calc(72.22% * var(--ts)) 7.06%)" stroke="hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.7)" strokeWidth="3" />
+            <circle r="78" fill="url(#mono-glow)" opacity=".9" />
