+    inset: 0;
+    overflow: visible;
+  }
+  .mp-road {
+    fill: none;
+    stroke: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.09);
+    stroke-width: 170;
+    stroke-linecap: round;
+    stroke-linejoin: round;
+  }
+  .mp-dash {
+    fill: none;
+    stroke: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82% / 0.55);
+    stroke-width: 4;
+    stroke-linecap: round;
+    stroke-dasharray: 2 30;
+    animation: mp-flow 1.2s linear infinite;
+  }
+  @keyframes mp-flow {
+    to {
