+}
+.md-pr-dot {
+  position: absolute;
+  top: 30px;
+  left: -35px;
+  width: 14px;
+  height: 14px;
+  border: 2px solid hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.4);
