+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The device wall (components/site/metaverse/vr-devices.tsx) and the quiz (vr-quiz.tsx) of the Metaverse page. */
+.vd,
+.vq {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --ad: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 12%);
+  --edge: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.28);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.9);
+}
+/* the devices as a plain table: no glow, no cards; hairlines, one accent colour for "this fits" */
+.vd-spec {
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.13);
+  max-width: 1080px;
+  margin: 40px auto 0;
+}
+.vd-bar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 14px;
+}
+.vd-bar > span {
+  margin-right: 6px;
+  color: var(--soft);
+  font-size: 0.9375rem;
+}
+.vd-fbtn {
+  padding: 6px 16px;
+  border: 1px solid var(--hair);
+  border-radius: 8px;
+  background: transparent;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  font-weight: 500;
+  cursor: pointer;
+  transition:
+    background 0.2s,
+    color 0.2s,
+    border-color 0.2s;
+}
+.vd-fbtn:hover {
+  color: #fff;
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.4);
+}
+.vd-fbtn[aria-pressed="true"] {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.55);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.14);
+  color: #fff;
+}
+.vd-table {
+  width: 100%;
+  overflow: hidden;
+  border: 1px solid var(--hair);
+  border-collapse: separate;
+  border-radius: 16px;
+  border-spacing: 0;
+  background: hsl(calc(var(--th) + 347) calc(40% * var(--ts)) 8% / 0.55);
+}
+.vd-table th,
+.vd-table td {
+  padding: 16px 18px;
+  text-align: left;
+  font-weight: 400;
+  vertical-align: middle;
+}
+.vd-table thead th {
+  padding-top: 13px;
+  padding-bottom: 13px;
+  border-bottom: 1px solid var(--hair);
+  color: var(--soft);
+  font-size: 0.875rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+.vd-table thead th:first-child {
+  width: 34%;
+}
+.vd-th-r,
+.vd-r {
+  width: 70px;
+  text-align: center !important;
+}
+.vd-tr > * {
+  border-top: 1px solid var(--hair);
+}
+.vd-table tbody > tr:first-child > * {
+  border-top: 0;
+}
+.vd-tr {
+  cursor: pointer;
+  transition:
+    background 0.25s,
+    opacity 0.3s;
+}
+.vd-tr:hover {
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.04);
+}
+.vd-tr[data-open="true"],
+.vd-tr[data-open="true"] + .vd-detail {
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.07);
+}
+.vd-tr[data-dim="true"],
+.vd-tr[data-dim="true"] + .vd-detail {
+  opacity: 0.32;
+}
+.vd-tr[data-open="true"] .vd-dev {
+  box-shadow: inset 3px 0 0 var(--a);
+}
+.vd-dev > * {
+  vertical-align: middle;
+}
+.vd-ico {
+  display: inline-grid;
+  width: 64px;
+  height: 38px;
+  margin-right: 16px;
+  place-items: center;
+  color: var(--soft);
+}
+.vd-tr[data-open="true"] .vd-ico {
+  color: var(--a);
+}
+.vd-ico svg {
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+/* the drawings are used as plain line icons here */
+.vd-ico svg * {
+  fill: none;
+  stroke: currentColor;
+  stroke-opacity: 1;
+  stroke-width: 4;
+  animation: none !important;
+  filter: none;
+}
+.vd-ico .vda-pulse,
+.vd-ico .vda-cube-t,
+.vd-ico .vda-cube-l,
+.vd-ico .vda-cube-r {
+  fill: currentColor;
+  stroke: none;
+}
+.vd-dev-t {
+  display: inline-block;
+  max-width: calc(100% - 84px);
+}
+.vd-dev-t button {
+  display: block;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: #fff;
+  font-size: 1.0625rem;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  line-height: 1.25;
+  text-align: left;
+  cursor: pointer;
+}
+.vd-dev-t button:focus-visible {
+  outline: 2px solid var(--a);
+  outline-offset: 4px;
+  border-radius: 4px;
+}
+.vd-dev-t small {
+  display: block;
+  margin-top: 3px;
+  color: var(--soft);
+  font-size: 0.875rem;
+}
+.vd-dot {
+  display: inline-block;
+  width: 12px;
+  height: 12px;
+  border: 1.5px solid hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.28);
+  border-radius: 50%;
+}
+.vd-r[data-on="true"] .vd-dot {
+  border-color: var(--a);
+  background: var(--a);
+}
+/* the column of the chosen reality is marked */
+.vd-spec[data-filter="AR"] [data-r="AR"],
+.vd-spec[data-filter="VR"] [data-r="VR"],
+.vd-spec[data-filter="XR"] [data-r="XR"],
+.vd-spec[data-filter="MR"] [data-r="MR"] {
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.08);
+}
+.vd-spec[data-filter="AR"] th[data-r="AR"],
+.vd-spec[data-filter="VR"] th[data-r="VR"],
+.vd-spec[data-filter="XR"] th[data-r="XR"],
+.vd-spec[data-filter="MR"] th[data-r="MR"] {
