+      <path d="M0 12.8v3.2M-5.2 17q2.6 2.8 5.2 0M0 17q2.6 2.8 5.2 0" fill="none" stroke="#2a1f33" strokeWidth="1.4" strokeLinecap="round" />
+      <ellipse cx="0" cy="19.4" rx="2.2" ry="1.3" fill="#ff8aa8" opacity="0.75" />
