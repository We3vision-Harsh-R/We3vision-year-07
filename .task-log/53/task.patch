+
+/* the brief with many choices: smaller pills, two or three in a row, the rest as "+3 more"; a little wider so that they fit */
+@media (min-width: 900px) {
+  .cf {
+    grid-template-columns: minmax(0, 1fr) 19.5rem;
+  }
+}
+.cf-brief-row > div {
+  gap: 6px;
+}
+.cf-pill {
+  padding: 3px 11px;
+  font-size: 0.875rem;
