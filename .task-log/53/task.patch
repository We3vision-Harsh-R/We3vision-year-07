+  }
+}
+
+/* the sun of the technologies: the white logo of the company (no letter, no domain under it). The sun is a deeper violet orb with a bright glow, so
+   that the white mark can be read on it. */
+.ts-sun i {
+  background: radial-gradient(
+    circle at 38% 30%,
+    hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80%) 0%,
+    hsl(calc(var(--th) + 354) calc(90% * var(--ts)) 62%) 38%,
+    hsl(calc(var(--th) + 350) calc(80% * var(--ts)) 44%) 72%,
+    hsl(calc(var(--th) + 346) calc(80% * var(--ts)) 30%) 100%
+  );
+}
+.ts-logo {
+  position: relative;
+  width: 58%;
+  height: auto;
+  filter: drop-shadow(0 2px 8px hsl(calc(var(--th) + 346) calc(80% * var(--ts)) 14% / 0.55));
+}
