+  top: 50%;
+  left: 50%;
+  width: calc(var(--rx) * 2);
+  height: calc(var(--ry) * 2);
+  margin: calc(var(--ry) * -1) 0 0 calc(var(--rx) * -1);
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.2);
+  border-radius: 50%;
+  box-shadow:
