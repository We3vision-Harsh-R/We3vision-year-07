+/* Liquid glass (Apple style): strong blur + colour boost of what is behind, a light-to-violet tint, a bright specular rim at the
+   top-left and bottom-right edge, a soft gloss on the upper half and a deep soft shadow. Add class "lg" to any rounded box. */
+.lg {
+  position: relative;
+  isolation: isolate;
+  border: 1px solid rgba(255, 255, 255, 0.16);
+  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.05) 38%, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.13));
+  -webkit-backdrop-filter: blur(26px) saturate(1.9) brightness(1.1);
+  backdrop-filter: blur(26px) saturate(1.9) brightness(1.1);
+  box-shadow:
+    inset 0 1px 1px rgba(255, 255, 255, 0.6),
+    inset 0 -1px 1px rgba(255, 255, 255, 0.14),
+    inset 0 0 24px rgba(255, 255, 255, 0.07),
+    0 24px 60px hsl(calc(var(--th) + 337) calc(100% * var(--ts)) 7.84% / 0.55),
+    0 2px 8px rgba(0, 0, 0, 0.25);
+}
+.lg::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  padding: 1px;
+  border-radius: inherit;
+  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0) 28%, rgba(255, 255, 255, 0) 70%, rgba(255, 255, 255, 0.38));
+  -webkit-mask:
+    linear-gradient(#000 0 0) content-box,
+    linear-gradient(#000 0 0);
+  -webkit-mask-composite: xor;
+  mask:
+    linear-gradient(#000 0 0) content-box exclude,
+    linear-gradient(#000 0 0);
+  pointer-events: none;
