+.flow-wires {
+  position: relative;
+  height: 70px;
+}
+.w {
+  position: absolute;
+  background: var(--line);
+  transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.w-v {
