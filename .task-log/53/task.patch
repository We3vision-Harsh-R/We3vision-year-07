+.lg::after {
+  content: "";
+  position: absolute;
+  inset: 1px 3% auto;
+  z-index: -1;
+  height: 40%;
+  border-radius: inherit;
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0));
+  pointer-events: none;
