+          <use href="#pw" stroke="hsl(calc(var(--th) + 354.46) calc(100% * var(--ts)) 92.35%)" strokeWidth="3" strokeDasharray="3 60 140 60" className="flow-line flow-line-slow" opacity=".9" />
