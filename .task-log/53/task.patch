+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+  /* the floor: one flat tone of the page colour itself (a touch lighter than the page). No pattern, no extra colours. */
+  background: hsl(calc(var(--th) + 347.58) calc(66% * var(--ts)) 7.4%);
