+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The menu at the bottom (floating-nav.tsx). The "Menu" button has the same space (8 px) to the top, the bottom and the right edge of the pill.
+   Hover: a gradient sweeps in from the left, the button lifts and glows, the three lines of the icon shift one after the other; when the big menu is
+   open the icon is a cross. The links of the pill get a light dot under them that pops in. */
+.fn-list {
+  padding-left: 1rem;
+  padding-right: 7px;
+}
+.fn-ham {
+  position: relative;
+  display: block;
+  width: 18px;
+  height: 18px;
+  color: var(--color-violet);
+}
+.fn-ham i {
+  position: absolute;
+  left: 1px;
+  width: 16px;
+  height: 1.5px;
+  border-radius: 2px;
+  background: currentColor;
+  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
+}
+.fn-ham i:nth-child(1) {
+  top: 4px;
+}
+.fn-ham i:nth-child(2) {
+  top: 8.5px;
+}
+.fn-ham i:nth-child(3) {
+  top: 13px;
+}
+.fn-ham[data-open="true"] i:nth-child(1) {
+  transform: translateY(4.5px) rotate(45deg);
+}
+.fn-ham[data-open="true"] i:nth-child(2) {
+  opacity: 0;
+  transform: scaleX(0.3);
+}
+.fn-ham[data-open="true"] i:nth-child(3) {
+  transform: translateY(-4.5px) rotate(-45deg);
+}
+.fn-menu {
+  position: relative;
+  isolation: isolate;
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+  height: 36px;
+  padding: 0 16px 0 12px;
+  overflow: hidden;
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.07);
+  color: var(--color-violet);
+  font: inherit;
+  font-size: 0.875rem;
+  line-height: 18px;
+  cursor: pointer;
+  transition: color 0.35s, transform 0.5s cubic-bezier(0.22, 1.4, 0.36, 1), box-shadow 0.5s, border-color 0.3s;
+}
+.fn-menu::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: linear-gradient(110deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82%), hsl(calc(var(--th) + 334) calc(85% * var(--ts)) 68%));
+  transform: scaleX(0);
+  transform-origin: left;
+  transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
+}
