+      </text>
+      {TESTS.map(([name, time], i) => {
+        const st = state(i);
+        const failing = i === 3 && q >= start(i) && q < start(i) + 0.045;
+        return (
+          <g key={name} transform={`translate(6 ${17 + i * 12.6})`}>
+            <rect width="140" height="10.6" rx="3" fill={st === "run" ? "#243256" : "#1a2440"} />
