+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The About page, as words: the first screen with a grid floor in perspective (about/about-hero.tsx) and the story as chapters on a line
+   (about/about-chapters.tsx). */
+.ah {
+  position: relative;
+  display: flex;
+  min-height: 100svh;
+  align-items: center;
+  justify-content: center;
+  padding: 6rem 1rem 6rem;
+  overflow: hidden;
+  text-align: center;
+}
+/* the background of the About hero: three soft round lights of colour that drift very slowly (only transform moves) */
+.ah-bg {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+  pointer-events: none;
+  /* the lights fade out towards the bottom of the screen, so that there is no hard edge where the section ends: they melt into the background of the site */
+  -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 45%, transparent 96%);
+  mask-image: linear-gradient(to bottom, #000 0, #000 45%, transparent 96%);
+}
+.ah-bg i {
+  position: absolute;
+  border-radius: 50%;
+  will-change: transform;
+}
+.ah-bg i:nth-child(1) {
+  top: -28%;
+  left: -14%;
+  width: 70vmax;
+  height: 70vmax;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.34), transparent);
+  animation: ah-d1 24s ease-in-out infinite alternate;
+}
+.ah-bg i:nth-child(2) {
+  right: -16%;
+  bottom: -34%;
+  width: 78vmax;
+  height: 78vmax;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 326) calc(85% * var(--ts)) 56% / 0.28), transparent);
+  animation: ah-d2 30s ease-in-out infinite alternate;
+}
+.ah-bg i:nth-child(3) {
+  top: 22%;
+  left: 30%;
+  width: 44vmax;
+  height: 30vmax;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 8) calc(100% * var(--ts)) 70% / 0.14), transparent);
+  animation: ah-d3 19s ease-in-out infinite alternate;
+}
+@keyframes ah-d1 {
+  to {
+    transform: translate(12vw, 10vh) scale(1.12);
+  }
+}
+@keyframes ah-d2 {
+  to {
+    transform: translate(-10vw, -12vh) scale(1.1);
+  }
+}
+@keyframes ah-d3 {
