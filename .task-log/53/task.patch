+            {failing && <circle cx="7" cy="5.3" r="3.4" fill="#ff5f57" />}
+            {st === "run" && !failing && <circle className="ob-spin-svg" cx="7" cy="5.3" r="3.1" fill="none" stroke="var(--g-a)" strokeWidth="1.3" strokeDasharray="5 4" />}
