+const Drone = ({ pkg }: { pkg?: boolean }) => (
+  <>
+    <Box x={-9} y={-9} w={18} d={18} h={5} l={60} z={20} />
+    <div className="cm-rotor">
+      <Box x={-16} y={-2} w={32} d={4} h={1} l={30} z={27} />
+      <Box x={-2} y={-16} w={4} d={32} h={1} l={30} z={27} />
+    </div>
+    {pkg && <Box x={-6} y={-6} w={12} d={12} h={9} l={38} z={9} />}
+  </>
+);
