diff --git a/b/src/components/site/modern/blog-masonry.tsx b/b/src/components/site/modern/blog-masonry.tsx
new file mode 100644
index 0000000..0d5bd67
--- /dev/null
+++ b/b/src/components/site/modern/blog-masonry.tsx
@@ -0,0 +1,210 @@
+"use client";
+
+import Link from "next/link";
+import { useEffect, useMemo, useRef, useState } from "react";
+import { tileRatio } from "@/lib/blog-shared";
+import { GlowEdge } from "../glow-edge";
+
+// The list of the blog as a masonry of pictures (the idea is the Masonry of React Bits, built here without a library): only the cover pictures are
+// seen, each in its own shape (landscape, square, portrait, tall; chosen for every article in the admin panel), laid out column by column: the next
+// picture goes under the shortest column. The bigger the screen, the more columns. A picture comes up from below out of a blur, one after the other;
+// when the window changes size the pictures glide to their new places.
+//  - The pointer INSIDE a card: that card is clear and has the border glow (it follows the pointer along the edge); all the other pictures go out of
+//    focus (the frames of the cards stay sharp, so they still read as cards). The pointer between the cards: everything is clear.
+//  - The pointer stays on one card for 2 seconds: a small panel with the brief of the article opens beside it (on the right, or the left, or below,
+//    wherever there is room). It stays while the pointer is on the panel, and it closes when the pointer goes to another card or away.
+// The same component draws the preview in the admin panel (fixed number of columns, nothing to click, one picture marked).
+// The look is in globals.css (.bm-*).
+
+export type MasonryItem = {
+  id: string;
+  title: string;
+  category: string;
+  image: string;
+  tile: string;
+  href: string;
+  /** shown in the panel that opens after 3 seconds */
+  summary?: string;
+  dateLabel?: string;
+  tags?: string[];
+  minutes?: number;
+};
+
+type Props = {
+  items: MasonryItem[];
+  /** a fixed number of columns (the preview of the admin panel); without it the number follows the width: about one column for every 300 px */
+  columns?: number;
+  minColumn?: number;
+  minColumns?: number;
+  maxColumns?: number;
+  /** the picture that is marked (the article being edited in the admin panel) */
+  highlightId?: string;
+  /** false: the pictures are not links and nothing opens (the preview) */
+  interactive?: boolean;
+};
+
+const OPEN_AFTER = 2000;
+
+export function BlogMasonry({ items, columns, minColumn = 300, minColumns = 3, maxColumns = 6, highlightId, interactive = true }: Props) {
+  const boxRef = useRef<HTMLDivElement>(null);
+  const [width, setWidth] = useState(0);
+  const [settled, setSettled] = useState(false);
+  const [hoverId, setHoverId] = useState<string | null>(null);
+  const [openId, setOpenId] = useState<string | null>(null);
+  const [onPanel, setOnPanel] = useState(false);
+  const hideT = useRef(0);
+
+  useEffect(() => {
+    const el = boxRef.current;
+    if (!el) return;
+    const ro = new ResizeObserver(([entry]) => setWidth(Math.round(entry.contentRect.width)));
+    ro.observe(el);
+    setWidth(Math.round(el.getBoundingClientRect().width));
+    return () => ro.disconnect();
+  }, []);
+
+  // the pictures glide to new places only after they have come in (not from the corner at the first layout)
+  useEffect(() => {
+    if (!width || settled) return;
+    const t = window.setTimeout(() => setSettled(true), 900 + items.length * 50);
+    return () => window.clearTimeout(t);
+  }, [width, settled, items.length]);
+
+  // 2 seconds on one card: its panel opens
+  useEffect(() => {
+    if (!interactive || !hoverId) return;
+    const t = window.setTimeout(() => setOpenId(hoverId), OPEN_AFTER);
+    return () => window.clearTimeout(t);
+  }, [hoverId, interactive]);
+  useEffect(() => () => window.clearTimeout(hideT.current), []);
+
+  const enterCard = (id: string) => {
+    window.clearTimeout(hideT.current);
+    setHoverId(id);
+    setOpenId((cur) => (cur === id ? cur : null)); // another card: the panel of the last one closes
+  };
+  const leaveCard = () => {
+    setHoverId(null);
+    window.clearTimeout(hideT.current);
+    // a moment to cross the little gap to the panel; between the cards (or away) the panel closes
+    hideT.current = window.setTimeout(() => setOpenId(null), 220);
+  };
+
+  const cols = columns ?? Math.max(minColumns, Math.min(maxColumns, Math.floor(width / minColumn) || 1));
+
+  const { cells, height } = useMemo(() => {
+    if (!width) return { cells: [] as { x: number; y: number; w: number; h: number }[], height: 0 };
+    const colW = width / cols;
+    const heights = new Array(cols).fill(0) as number[];
+    const out = items.map((it) => {
+      const col = heights.indexOf(Math.min(...heights));
+      const h = Math.round(colW * tileRatio(it.tile));
+      const cell = { x: Math.round(colW * col), y: heights[col], w: Math.round(colW), h };
+      heights[col] += h;
+      return cell;
+    });
+    return { cells: out, height: Math.max(0, ...heights) };
+  }, [items, width, cols]);
+
+  // the card that is in focus: the one under the pointer, or the one whose panel the pointer is on
+  const focusId = hoverId ?? (onPanel ? openId : null);
+
+  // the panel has the SAME size and shape as the card it belongs to, and stands next to it: on the right (in the place of the next column), else on
+  // the left, else below it (or above it, at the bottom of the wall)
+  const panel = useMemo(() => {
+    if (!openId) return null;
+    const i = items.findIndex((x) => x.id === openId);
+    const c = cells[i];
+    if (i < 0 || !c) return null;
+    const GAP = 14;
+    const fx = c.x + 7; // the card itself (the cell has 7 px round it)
+    const fy = c.y + 7;
+    const fw = c.w - 14;
+    const fh = c.h - 14;
+    const base = { w: fw, h: fh, item: items[i] };
+    if (fx + fw + GAP + fw <= width) return { ...base, left: fx + fw + GAP, top: fy, side: "right" as const };
+    if (fx - GAP - fw >= 0) return { ...base, left: fx - GAP - fw, top: fy, side: "left" as const };
+    const below = fy + fh + GAP + fh <= height + 40;
+    return { ...base, left: fx, top: below ? fy + fh + GAP : Math.max(0, fy - GAP - fh), side: below ? ("below" as const) : ("above" as const) };
+  }, [openId, items, cells, width, height]);
+
+  return (
+    <div ref={boxRef} className="bm" data-settled={settled} data-active={focusId ? "true" : "false"} style={{ height }}>
+      {items.map((it, i) => {
+        const c = cells[i];
+        const style = c
+          ? ({ transform: `translate(${c.x}px, ${c.y}px)`, width: c.w, height: c.h, "--i": i } as React.CSSProperties)
+          : ({ "--i": i, opacity: 0 } as React.CSSProperties);
+        const frame = (
+          <span
+            className="bm-frame bglow"
+            data-hl={highlightId === it.id}
+            onPointerEnter={interactive ? () => enterCard(it.id) : undefined}
+            onPointerLeave={interactive ? leaveCard : undefined}
+          >
+            <GlowEdge />
+            <span className="bm-card">
+              {it.image ? (
+                // eslint-disable-next-line @next/next/no-img-element
+                <img src={it.image} alt="" className="bm-img" loading="lazy" decoding="async" />
+              ) : (
+                <span className="bm-empty">No picture yet</span>
+              )}
+              <span className="bm-cap">
+                {it.category && <span className="bm-chip">{it.category}</span>}
+                <span className="bm-title">{it.title}</span>
+              </span>
+            </span>
+          </span>
+        );
+        const on = focusId === it.id;
+        return interactive ? (
+          <Link key={it.id} href={it.href} className="bm-item" style={style} aria-label={it.title} data-on={on}>
+            {frame}
+          </Link>
+        ) : (
+          <div key={it.id} className="bm-item" style={style}>
+            {frame}
+          </div>
+        );
+      })}
+
+      {interactive && panel && (
+        <aside
+          className="bm-info"
+          data-side={panel.side}
+          data-short={panel.h < 300}
+          style={{ left: panel.left, top: panel.top, width: panel.w, height: panel.h }}
+          onPointerEnter={() => {
+            window.clearTimeout(hideT.current);
+            setOnPanel(true);
+          }}
+          onPointerLeave={() => {
+            setOnPanel(false);
+            setOpenId(null);
+          }}
+          aria-label={`About: ${panel.item.title}`}
+        >
+          {panel.item.category && <span className="bm-info-chip">{panel.item.category}</span>}
+          <h3>{panel.item.title}</h3>
+          <p className="bm-info-meta">
+            {panel.item.dateLabel}
+            {panel.item.dateLabel && panel.item.minutes ? " · " : ""}
+            {panel.item.minutes ? `${panel.item.minutes} min read` : ""}
+          </p>
+          {panel.item.summary && <p className="bm-info-text">{panel.item.summary}</p>}
+          {panel.item.tags && panel.item.tags.length > 0 && (
+            <ul className="bm-info-tags" aria-label="Topics">
+              {panel.item.tags.slice(0, 4).map((t) => (
+                <li key={t}>{t}</li>
+              ))}
+            </ul>
+          )}
+          <Link href={panel.item.href} className="bm-info-go">
+            Read the article →
+          </Link>
+        </aside>
+      )}
+    </div>
+  );
+}
diff --git a/b/src/components/site/modern/cursor-grid.tsx b/b/src/components/site/modern/cursor-grid.tsx
new file mode 100644
index 0000000..850c158
--- /dev/null
+++ b/b/src/components/site/modern/cursor-grid.tsx
@@ -0,0 +1,303 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+import { THEME_EVENT, liveTheme } from "@/lib/theme";
+import { shiftRgb } from "../anim-utils";
+
+// CursorGrid (React Bits): a grid of cells on a canvas that light up round the pointer and fade out again, with a ring of lit cells on every click.
+// Ported to TypeScript for this site. Differences from the original: the colour follows the colour of the site (the visitor's colour picker) unless a
+// colour is given, and `follow` makes the grid listen to the section it stands in (the words of the hero lie over it, so the pointer would otherwise
+// never reach the canvas). The look is in globals.css (.cursor-grid).
+
+type Falloff = "linear" | "smooth" | "sharp";
+type Props = {
+  cellSize?: number;
+  color?: string;
+  radius?: number;
+  falloff?: Falloff;
+  holdTime?: number;
+  fadeDuration?: number;
+  lineWidth?: number;
+  maxOpacity?: number;
+  fillOpacity?: number;
+  gridOpacity?: number;
+  cellRadius?: number;
+  clickPulse?: boolean;
+  pulseSpeed?: number;
+  follow?: boolean;
+  className?: string;
+};
+
+const FALLOFF_CURVES: Record<Falloff, (t: number) => number> = {
+  linear: (t) => t,
+  smooth: (t) => t * t * (3 - 2 * t),
+  sharp: (t) => t * t * t,
+};
+
+const hexToRgb = (hex: string): [number, number, number] => {
+  const h = hex.replace("#", "");
+  const v = h.length === 3 ? h.split("").map((c) => c + c).join("") : h;
+  const num = parseInt(v.slice(0, 6), 16);
+  return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
+};
+
+type Pulse = { x: number; y: number; t0: number };
+
+export default function CursorGrid({
+  cellSize = 70,
+  color,
+  radius = 140,
+  falloff = "smooth",
+  holdTime = 400,
+  fadeDuration = 800,
+  lineWidth = 1.2,
+  maxOpacity = 1,
+  fillOpacity = 0,
+  gridOpacity = 0,
+  cellRadius = 0,
+  clickPulse = true,
+  pulseSpeed = 600,
+  follow = false,
+  className = "",
+}: Props) {
+  const containerRef = useRef<HTMLDivElement>(null);
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const propsRef = useRef({ cellSize, color, radius, falloff, holdTime, fadeDuration, lineWidth, maxOpacity, fillOpacity, gridOpacity, cellRadius, clickPulse, pulseSpeed });
+  const wakeRef = useRef<(() => void) | null>(null);
+
+  // the loop reads the props from here, so it never has to be rebuilt when one of them changes (written after every render, not during it)
+  useEffect(() => {
+    propsRef.current = { cellSize, color, radius, falloff, holdTime, fadeDuration, lineWidth, maxOpacity, fillOpacity, gridOpacity, cellRadius, clickPulse, pulseSpeed };
+    wakeRef.current?.();
+  });
+
+  useEffect(() => {
+    const container = containerRef.current;
+    const canvas = canvasRef.current;
+    if (!container || !canvas) return;
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return;
+    const dpr = Math.min(window.devicePixelRatio || 1, 2);
+
+    // grid state: one alpha and one timestamp per cell, row by row
+    let cols = 0;
+    let rows = 0;
+    let offX = 0;
+    let offY = 0;
+    let alphas = new Float32Array(0);
+    let touched = new Float64Array(0);
+    let w = 0;
+    let h = 0;
+    const pulses: Pulse[] = [];
+    let raf = 0;
+    let running = false;
+    let lastFrame = 0;
+
+    const rgb = (): [number, number, number] => {
+      const p = propsRef.current;
+      if (p.color) return hexToRgb(p.color);
+      const t = liveTheme();
+      return shiftRgb([211, 135, 255], t.h, t.s) as [number, number, number];
+    };
+
+    const rebuild = () => {
+      const p = propsRef.current;
+      w = container.offsetWidth;
+      h = container.offsetHeight;
+      canvas.width = Math.max(1, Math.round(w * dpr));
+      canvas.height = Math.max(1, Math.round(h * dpr));
+      canvas.style.width = `${w}px`;
+      canvas.style.height = `${h}px`;
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      cols = Math.ceil(w / p.cellSize) + 1;
+      rows = Math.ceil(h / p.cellSize) + 1;
+      // the lattice is centred, so the cells at the edge are cut evenly on both sides
+      offX = (w - cols * p.cellSize) / 2;
+      offY = (h - rows * p.cellSize) / 2;
+      alphas = new Float32Array(cols * rows);
+      touched = new Float64Array(cols * rows);
+    };
+
+    const cellCenter = (i: number): [number, number] => {
+      const p = propsRef.current;
+      return [offX + (i % cols) * p.cellSize + p.cellSize / 2, offY + Math.floor(i / cols) * p.cellSize + p.cellSize / 2];
+    };
+
+    // every cell whose centre is inside the radius lights up, brighter the nearer it is (the falloff curve)
+    const energize = (x: number, y: number) => {
+      const p = propsRef.current;
+      const r = Math.max(p.radius, 1);
+      const ease = FALLOFF_CURVES[p.falloff] ?? FALLOFF_CURVES.linear;
+      const now = performance.now();
+      const minCol = Math.max(0, Math.floor((x - r - offX) / p.cellSize));
+      const maxCol = Math.min(cols - 1, Math.floor((x + r - offX) / p.cellSize));
+      const minRow = Math.max(0, Math.floor((y - r - offY) / p.cellSize));
+      const maxRow = Math.min(rows - 1, Math.floor((y + r - offY) / p.cellSize));
+      for (let cRow = minRow; cRow <= maxRow; cRow++) {
+        for (let cCol = minCol; cCol <= maxCol; cCol++) {
+          const i = cRow * cols + cCol;
+          const [cx, cy] = cellCenter(i);
+          const dist = Math.hypot(cx - x, cy - y);
+          if (dist > r) continue;
+          const level = ease(1 - dist / r) * p.maxOpacity;
+          if (level > alphas[i]) {
+            alphas[i] = level;
+            touched[i] = now;
+          } else if (level > 0) {
+            touched[i] = now;
+          }
+        }
+      }
+    };
+
+    const draw = (now: number) => {
+      const p = propsRef.current;
+      const dt = Math.min(now - lastFrame, 50);
+      lastFrame = now;
+      ctx.clearRect(0, 0, w, h);
+      const [cr, cg, cb] = rgb();
+
+      // the faint lattice that is always there (off by default)
+      if (p.gridOpacity > 0) {
+        ctx.strokeStyle = `rgba(${cr}, ${cg}, ${cb}, ${p.gridOpacity})`;
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        for (let cCol = 0; cCol <= cols; cCol++) {
+          const x = Math.round(offX + cCol * p.cellSize) + 0.5;
+          ctx.moveTo(x, 0);
+          ctx.lineTo(x, h);
+        }
+        for (let cRow = 0; cRow <= rows; cRow++) {
+          const y = Math.round(offY + cRow * p.cellSize) + 0.5;
+          ctx.moveTo(0, y);
+          ctx.lineTo(w, y);
+        }
+        ctx.stroke();
+      }
+
+      // the rings of a click give their light to the cells they pass
+      for (let pi = pulses.length - 1; pi >= 0; pi--) {
+        const pulse = pulses[pi];
+        const age = (now - pulse.t0) / 1000;
+        const ringR = age * p.pulseSpeed;
+        if (ringR > Math.hypot(w, h)) {
+          pulses.splice(pi, 1);
+          continue;
+        }
+        const band = p.cellSize;
+        const minCol = Math.max(0, Math.floor((pulse.x - ringR - band - offX) / p.cellSize));
+        const maxCol = Math.min(cols - 1, Math.floor((pulse.x + ringR + band - offX) / p.cellSize));
+        const minRow = Math.max(0, Math.floor((pulse.y - ringR - band - offY) / p.cellSize));
+        const maxRow = Math.min(rows - 1, Math.floor((pulse.y + ringR + band - offY) / p.cellSize));
+        for (let cRow = minRow; cRow <= maxRow; cRow++) {
+          for (let cCol = minCol; cCol <= maxCol; cCol++) {
+            const i = cRow * cols + cCol;
+            const [cx, cy] = cellCenter(i);
+            const dist = Math.hypot(cx - pulse.x, cy - pulse.y);
+            if (Math.abs(dist - ringR) < band / 2 && p.maxOpacity > alphas[i]) {
+              alphas[i] = p.maxOpacity;
+              touched[i] = now;
+            }
+          }
+        }
+      }
+
+      let anyVisible = pulses.length > 0;
+      const fadeStep = dt / Math.max(p.fadeDuration, 16);
+      const half = p.cellSize / 2;
+
+      for (let i = 0; i < alphas.length; i++) {
+        let a = alphas[i];
+        if (a <= 0) continue;
+        if (now - touched[i] > p.holdTime) {
+          a = Math.max(0, a - fadeStep);
+          alphas[i] = a;
+          if (a <= 0) continue;
+        }
+        anyVisible = true;
+
+        const [cx, cy] = cellCenter(i);
+        const gradient = ctx.createRadialGradient(cx, cy, half * 0.1, cx, cy, p.cellSize);
+        gradient.addColorStop(0, `rgba(${cr}, ${cg}, ${cb}, ${a})`);
+        gradient.addColorStop(1, `rgba(${cr}, ${cg}, ${cb}, 0)`);
+
+        const x = cx - half + 0.5;
+        const y = cy - half + 0.5;
+        const s = p.cellSize - 1;
+
+        ctx.beginPath();
+        if (p.cellRadius > 0) ctx.roundRect(x, y, s, s, p.cellRadius);
+        else ctx.rect(x, y, s, s);
+        if (p.fillOpacity > 0) {
+          ctx.fillStyle = `rgba(${cr}, ${cg}, ${cb}, ${a * p.fillOpacity})`;
+          ctx.fill();
+        }
+        ctx.strokeStyle = gradient;
+        ctx.lineWidth = p.lineWidth;
+        ctx.stroke();
+      }
+
+      if (anyVisible) {
+        raf = requestAnimationFrame(draw);
+      } else {
+        running = false;
+        if (propsRef.current.gridOpacity <= 0) ctx.clearRect(0, 0, w, h);
+      }
+    };
+
+    // nothing runs while nothing is lit: the loop starts with the pointer and stops when the last cell has faded
+    const wake = () => {
+      if (running) return;
+      running = true;
+      lastFrame = performance.now();
+      raf = requestAnimationFrame(draw);
+    };
+    wakeRef.current = wake;
+
+    const toLocal = (e: PointerEvent): [number, number] => {
+      const rect = canvas.getBoundingClientRect();
+      return [e.clientX - rect.left, e.clientY - rect.top];
+    };
+    const onPointerMove = (e: PointerEvent) => {
+      const [x, y] = toLocal(e);
+      energize(x, y);
+      wake();
+    };
+    const onPointerDown = (e: PointerEvent) => {
+      if (!propsRef.current.clickPulse) return;
+      const [x, y] = toLocal(e);
+      pulses.push({ x, y, t0: performance.now() });
+      wake();
+    };
+
+    const ro = new ResizeObserver(() => {
+      rebuild();
+      wake();
+    });
+    ro.observe(container);
+    rebuild();
+    wake();
+
+    // the grid listens to its own box, or (follow) to the section it stands in, because the words of the section lie over it
+    const host: HTMLElement = follow ? container.closest<HTMLElement>("section") ?? container : container;
+    host.addEventListener("pointermove", onPointerMove);
+    host.addEventListener("pointerdown", onPointerDown);
+    const onTheme = () => wake();
+    window.addEventListener(THEME_EVENT, onTheme);
+
+    return () => {
+      cancelAnimationFrame(raf);
+      ro.disconnect();
+      host.removeEventListener("pointermove", onPointerMove);
+      host.removeEventListener("pointerdown", onPointerDown);
+      window.removeEventListener(THEME_EVENT, onTheme);
+    };
+    // the grid is rebuilt only when the size of the cells changes; the other props are read from propsRef
+  }, [cellSize, follow]);
+
+  return (
+    <div ref={containerRef} className={`cursor-grid${className ? ` ${className}` : ""}`} aria-hidden>
+      <canvas ref={canvasRef} className="cursor-grid__canvas" />
+    </div>
+  );
+}
diff --git a/b/src/components/site/modern/dappled-light.tsx b/b/src/components/site/modern/dappled-light.tsx
new file mode 100644
index 0000000..29e3a3c
--- /dev/null
+++ b/b/src/components/site/modern/dappled-light.tsx
@@ -0,0 +1,105 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+
+// "Dappled Light": sunlight falling through swaying leaves onto a wall (the idea is the Dappled Light of React Bits Pro, built here without
+// any library). A soft light in the colour of the site lies on the wall; over it a small canvas (320 x 180 pixels, scaled up so that the
+// shadows are soft) draws about seventy leaves that sway a little in the wind, so that spots of light slide over the wall between them.
+// It draws about 24 times a second, only while it is on the screen, and draws one still picture for visitors who prefer less motion.
+// Put it behind content: it is absolutely positioned, does not take clicks and fades out at its edges. The look is in globals.css (.dl-*).
+
+const W = 320;
+const H = 180;
+
+// a small seeded random generator, so that the leaves are the same on every visit (and on the server)
+function rng(seed: number) {
+  let a = seed;
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+type Leaf = { x: number; y: number; s: number; r: number; amp: number; ph: number; sp: number; dx: number };
+
+export function DappledLight({ className = "", seed = 7 }: { className?: string; seed?: number }) {
+  const ref = useRef<HTMLCanvasElement>(null);
+  const box = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const cv = ref.current;
+    const wrap = box.current;
+    if (!cv || !wrap) return;
+    const ctx = cv.getContext("2d");
+    if (!ctx) return;
+    const rnd = rng(seed);
+    // the leaves hang in clusters along a few branches from the top right
+    const leaves: Leaf[] = Array.from({ length: 74 }, (_, i) => {
+      const branch = i % 5;
+      const bx = 0.25 + branch * 0.17 + rnd() * 0.08;
+      return { x: bx + (rnd() - 0.5) * 0.22, y: rnd() * 0.95, s: 0.07 + rnd() * 0.085, r: rnd() * Math.PI * 2, amp: 0.1 + rnd() * 0.22, ph: rnd() * 6.28, sp: 0.5 + rnd() * 0.7, dx: 0.004 + rnd() * 0.012 };
+    });
+    const draw = (t: number) => {
+      ctx.clearRect(0, 0, W, H);
+      ctx.fillStyle = "rgba(6, 2, 12, 0.78)";
+      ctx.strokeStyle = "rgba(6, 2, 12, 0.78)";
+      for (const l of leaves) {
+        const a = l.r + Math.sin(t * l.sp + l.ph) * l.amp;
+        const px = (l.x + Math.sin(t * 0.5 + l.ph) * l.dx) * W;
+        const py = l.y * H;
+        const len = l.s * W * 0.5;
+        const wid = len * 0.46;
+        ctx.save();
+        ctx.translate(px, py);
+        ctx.rotate(a);
+        // a leaf: two curves that meet in a point at both ends
+        ctx.beginPath();
+        ctx.moveTo(-len, 0);
+        ctx.quadraticCurveTo(0, -wid * 1.6, len, 0);
+        ctx.quadraticCurveTo(0, wid * 1.6, -len, 0);
+        ctx.fill();
+        ctx.lineWidth = 1.4;
+        ctx.beginPath();
+        ctx.moveTo(-len * 1.5, 0);
+        ctx.lineTo(-len, 0);
+        ctx.stroke();
+        ctx.restore();
+      }
+      // a thick wall of shade on the top and the right, so that the light comes through a gap
+      const g = ctx.createLinearGradient(W, 0, W * 0.55, H * 0.6);
+      g.addColorStop(0, "rgba(6, 2, 12, 0.85)");
+      g.addColorStop(1, "rgba(6, 2, 12, 0)");
+      ctx.fillStyle = g;
+      ctx.fillRect(0, 0, W, H);
+    };
+
+    draw(0);
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+    let raf = 0;
+    let visible = false;
+    let last = 0;
+    const loop = (now: number) => {
+      raf = requestAnimationFrame(loop);
+      if (!visible || now - last < 41) return;
+      last = now;
+      draw(now / 1000);
+    };
+    const io = new IntersectionObserver(([e]) => (visible = e.isIntersecting), { rootMargin: "60px" });
+    io.observe(wrap);
+    raf = requestAnimationFrame(loop);
+    return () => {
+      cancelAnimationFrame(raf);
+      io.disconnect();
+    };
+  }, [seed]);
+
+  return (
+    <div ref={box} className={`dl ${className}`} aria-hidden>
+      <span className="dl-light" />
+      <canvas ref={ref} width={W} height={H} className="dl-leaves" />
+    </div>
+  );
+}
diff --git a/b/src/components/site/modern/faq-split.tsx b/b/src/components/site/modern/faq-split.tsx
new file mode 100644
index 0000000..38be8d5
--- /dev/null
+++ b/b/src/components/site/modern/faq-split.tsx
@@ -0,0 +1,61 @@
+"use client";
+
+import { useState } from "react";
+import { GlowEdge } from "../glow-edge";
+import { SplitHeading } from "./split-heading";
+
+type Q = { question: string; answer: string };
+
+const two = (n: number) => String(n).padStart(2, "0");
+
+// The redesigned FAQ of the service pages: the heading and a "still have a question?" card stay on the left while the questions are read on
+// the right, numbered, one open at a time. Also tells Google about the questions (FAQPage).
+export function FaqSplit({ chip, heading, intro, items }: { chip: string; heading: string; intro?: string; items: Q[] }) {
+  const [open, setOpen] = useState<number | null>(0);
+  const json = {
+    "@context": "https://schema.org",
+    "@type": "FAQPage",
+    mainEntity: items.map((q) => ({ "@type": "Question", name: q.question, acceptedAnswer: { "@type": "Answer", text: q.answer } })),
+  };
+  return (
+    <div className="md md-faq">
+      <script type="application/ld+json" dangerouslySetInnerHTML={{ __html: JSON.stringify(json).replace(/</g, "\\u003c") }} />
+      <aside className="md-faq-side">
+        <span className="md-chip">{chip}</span>
+        <SplitHeading text={heading} className="md-h2" />
+        {intro && <p className="md-intro">{intro}</p>}
+        <div className="md-faq-help bglow">
+          <GlowEdge />
+          <b>Still have a question?</b>
+          <p>Tell us what you need and we will answer you ourselves.</p>
+          <a href="#contact">Talk to us →</a>
+        </div>
+      </aside>
+
+      <div className="md-faq-list">
+        {items.map((q, i) => {
+          const isOpen = open === i;
+          return (
+            <div key={i} className="md-faq-item" data-open={isOpen}>
+              <h3>
+                <button type="button" aria-expanded={isOpen} aria-controls={`mdfaq-${i}`} onClick={() => setOpen(isOpen ? null : i)}>
+                  <i aria-hidden>{two(i + 1)}</i>
+                  <span>{q.question}</span>
+                  <svg viewBox="0 0 20 20" aria-hidden>
+                    <path d="M3 10h14" />
+                    <path d="M10 3v14" className="md-faq-v" />
+                  </svg>
+                </button>
+              </h3>
+              <div id={`mdfaq-${i}`} role="region" className="md-faq-a">
+                <div>
+                  <p>{q.answer}</p>
+                </div>
+              </div>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
diff --git a/b/src/components/site/modern/map-variants.ts b/b/src/components/site/modern/map-variants.ts
new file mode 100644
index 0000000..b1480a2
--- /dev/null
+++ b/b/src/components/site/modern/map-variants.ts
@@ -0,0 +1,19 @@
+// The road of the industries city of every service page (a plain module: it is read by a server component). The city is the same on every
+// page; only the shape of the road and the point of view differ. The car always drives straight ahead, it never turns back.
+
+export type Road = "straight" | "wave" | "stairs";
+export type Variant = { road: Road; ang: number };
+
+/** the road of every service page (ang: the angle the camera looks at the road from, in degrees) */
+export const VARIANTS: Record<string, Variant> = {
+  webdev: { road: "straight", ang: -34 },
+  mobile: { road: "wave", ang: -22 },
+  "ui-ux-design": { road: "stairs", ang: -44 },
+  crm: { road: "straight", ang: 26 },
+  animation: { road: "wave", ang: 34 },
+  "3d-modeling": { road: "stairs", ang: 30 },
+  graphics: { road: "straight", ang: -58 },
+  seo: { road: "stairs", ang: -24 },
+  ai: { road: "wave", ang: -50 },
+};
+export const DEFAULT_VARIANT: Variant = VARIANTS.webdev;
