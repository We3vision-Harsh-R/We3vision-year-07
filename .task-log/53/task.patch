+}
+.gs-stage[data-tilt] .gs-svg {
+  transform: rotateX(calc(var(--ly) * -5deg)) rotateY(calc(var(--lx) * 7deg));
+  transition: transform 0.25s ease-out;
+}
+.gs-bubble {
+  position: absolute;
+  z-index: 3;
+  left: 22px;
+  top: 56%;
+  max-width: min(38%, 220px);
+  margin: 0;
+  padding: 9px 13px;
+  border-radius: 16px 16px 16px 4px;
+  background: rgba(255, 255, 255, 0.96);
+  color: hsl(calc(var(--th) + 349) calc(58% * var(--ts)) 14%);
