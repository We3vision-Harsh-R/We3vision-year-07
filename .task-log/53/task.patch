+    0 0 0 3px hsl(calc(var(--th) + 347) calc(60% * var(--ts)) 8%),
+    0 0 0 5px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84%),
+    0 12px 34px -10px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.7);
+}
+.cf-brief {
+  background:
+    linear-gradient(155deg, hsl(0 0% 100% / 0.075) 0%, hsl(0 0% 100% / 0.025) 42%, hsl(0 0% 100% / 0.01) 100%),
+    hsl(calc(var(--th) + 347) calc(38% * var(--ts)) 9% / 0.52);
+  border-color: hsl(0 0% 100% / 0.12);
+  box-shadow:
+    inset 0 1px 0 hsl(0 0% 100% / 0.11),
