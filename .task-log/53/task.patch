+            {data.text && <p className="mx-auto mt-6 max-w-[620px] text-base leading-relaxed text-orchid sm:text-lg">{data.text}</p>}
+          </Reveal>
+          <Reveal className="mt-12">
+            <AiBuddy greeting={tips[0] ?? ""} />
+          </Reveal>
+        </div>
+      </section>
