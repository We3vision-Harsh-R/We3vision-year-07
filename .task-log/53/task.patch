+  for (let i = 0; i < count; i++) {
+    delay[i] = rnd();
+    rx[i] = rnd();
+    ry[i] = rnd();
+    power[i] = rnd();
+    side[i] = rnd() < 0.5 ? -1 : 1;
+    const k = rnd();
