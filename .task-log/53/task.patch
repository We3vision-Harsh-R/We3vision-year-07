+  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.au-l1 {
+  top: -26%;
+  left: -16%;
+  width: 78vmax;
+  height: 78vmax;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.3), transparent);
+  transform: translate3d(calc(var(--p) * 46vw), calc(var(--p) * 56vh), 0);
+}
+.au-l2 {
+  right: -18%;
+  bottom: -32%;
+  width: 84vmax;
+  height: 84vmax;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 326) calc(85% * var(--ts)) 56% / 0.26), transparent);
+  transform: translate3d(calc(var(--p) * -50vw), calc(var(--p) * -50vh), 0);
+}
+.au-l3 {
+  top: 18%;
+  left: 28%;
+  width: 52vmax;
+  height: 40vmax;
+  background: radial-gradient(closest-side, hsl(calc(var(--th) + 8) calc(100% * var(--ts)) 70% / 0.13), transparent);
+  transform: translate3d(calc(26vw - var(--p) * 56vw), calc(var(--p) * 24vh), 0);
+}
+@media (prefers-reduced-motion: reduce) {
