+}
+.pd-chips {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-start;
+  gap: 8px;
+  margin-top: 4px;
+}
+.pd-chip {
+  padding: 8px 14px;
+  border: 1px solid rgba(255, 255, 255, 0.18);
+  border-radius: 999px;
+  background: transparent;
+  color: hsl(calc(var(--th) + 350) calc(100% * var(--ts)) 93%);
+  font-size: 0.9375rem;
