+}
+.vd-what p {
+  display: -webkit-box;
+  margin: 0;
+  overflow: hidden;
+  color: var(--soft);
+  font-size: 1rem;
+  line-height: 1.55;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+.vd-tr[data-open="true"] .vd-what p {
+  display: block;
+}
+.vd-table .vd-detail td {
+  padding: 0;
+  border-top: 0;
+}
+.vd-detail-in {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1);
+}
