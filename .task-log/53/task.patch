+  }
+  to {
+    transform: rotate(26deg);
+  }
+}
+/* a waddle: the body rises a little at every step and leans to the foot that is down */
+@keyframes pw-sway {
+  0% {
+    transform: translateY(0) rotate(-1.6deg);
+  }
+  25% {
