+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The office of the metaverse team seen from above (components/site/metaverse/vr-floor.tsx). It is the office of 2027 on the About page
+   (the .of-* rules above: floor, walls, corners, people, desk, the founders' figure) with four big corners (AR, VR, XR, MR), one girl who
+   walks in and sits down, a heading on the floor, and a card + progressive blur that open when a team is pointed at. */
+.vfo {
+  position: relative;
+  height: calc(100vh * 7.5);
+  background: #000;
+}
+.vfo-of {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --ad: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 12%);
+  --edge: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.3);
+}
+/* the heading on the floor (where the year stands in the office of 2027) */
+.vfo-title {
+  top: 30%;
+  font-family: inherit;
+  font-size: calc(var(--p) * 74);
+  font-weight: 600;
+  line-height: 1.04;
+  letter-spacing: -0.045em;
+}
+.vfo-title {
+  background: none;
+  -webkit-background-clip: border-box;
+  background-clip: border-box;
+}
+.vfo-title span {
+  display: block;
+  background: linear-gradient(180deg, #fff, color-mix(in srgb, #fff 80%, var(--a)));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  opacity: 0;
+  will-change: opacity, transform, filter;
+}
+.vfo-title span:nth-child(2) {
+  background-image: linear-gradient(180deg, color-mix(in srgb, #fff 80%, var(--a)), color-mix(in srgb, #fff 45%, var(--a)));
+}
+.vfo-title span:nth-child(n + 3) {
+  background-image: linear-gradient(180deg, color-mix(in srgb, #fff 45%, var(--a)), var(--a));
+}
+/* everything else of the office comes in later (the script uncovers it step by step while the page is scrolled) */
+.vfo-of .of-zone,
+.vfo-of .of-walker,
+.vfo-tip {
+  opacity: 0;
+}
+.vfo-chip {
+  opacity: 0;
+}
+/* the card under her desk: it never reaches into the big corners */
+.vfo-tip {
+  width: min(max(560px, calc(var(--p) * 448)), calc(100% - 2 * (3.5% + 300px * var(--zs) + 14px)));
+}
+.vfo-of[data-layout="tall"] .vfo-tip {
+  width: 92%;
+}
+/* her chair and her desk: the boss desk of the office, for one person */
+.vfo-chair {
+  left: 50%;
+}
+.vfo-desk {
+  width: calc(var(--p) * 130);
+}
+.vfo-desk .of-mon {
+  left: 50%;
+  margin-left: calc(var(--p) * -22);
+}
+.vfo-desk .of-mon-b {
