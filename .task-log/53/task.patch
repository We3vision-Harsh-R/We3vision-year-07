+}
+.sk-chip:disabled { opacity: 0.45; cursor: default; }
+
+.sk-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  padding: 18px 6px 6px;
+}
+.sk-btn {
+  display: inline-flex;
+  height: 3rem;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+  padding: 0 1.5rem;
