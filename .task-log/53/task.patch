+  background: linear-gradient(160deg, hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 14% / 0.96), hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 8.5% / 0.96));
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.08),
