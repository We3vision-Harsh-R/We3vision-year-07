+    transform: translateY(18px);
+  }
+}
+.md-pr-count span {
+  color: var(--soft);
+  font-size: 1.25rem;
+  font-weight: 500;
+}
+.md-pr-now {
+  min-height: 2.8em;
+  margin: 14px 0 0;
+  color: #fff;
+  font-size: 1.375rem;
+  font-weight: 600;
