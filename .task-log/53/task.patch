+}
+
+/* 3 guidelines: a spec sheet whose lines draw themselves */
+.bb-grid {
+  position: absolute;
+  inset: 0;
+  background-image: linear-gradient(hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.07) 1px, transparent 1px), linear-gradient(90deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.07) 1px, transparent 1px);
+  background-size: 22px 22px;
+}
+.bb-line {
+  position: absolute;
+  left: 18px;
+  height: 7px;
+  border-radius: 4px;
+  background: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.5);
+  transform-origin: left;
+  transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.bb-line.l1 {
+  top: 24px;
+  width: 52%;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%);
+}
+.bb-line.l2 {
+  top: 48px;
+  width: 78%;
+}
+.bb-line.l3 {
+  top: 66px;
+  width: 64%;
+}
+.bb-line.l4 {
+  top: 84px;
+  width: 40%;
+}
+.bb-tile[data-k="3"]:not([data-on="true"]) .bb-line {
+  transform: scaleX(0.35);
+}
+.bb-tile[data-k="3"][data-on="true"] .bb-line.l2 {
+  transition-delay: 0.1s;
+}
+.bb-tile[data-k="3"][data-on="true"] .bb-line.l3 {
+  transition-delay: 0.2s;
+}
+.bb-tile[data-k="3"][data-on="true"] .bb-line.l4 {
+  transition-delay: 0.3s;
+}
+
+/* 4 collateral: two cards and a tag fan out */
+.bb-card {
+  position: absolute;
+  width: 74px;
+  height: 46px;
+  border-radius: 8px;
+  border: 1px solid rgba(255, 255, 255, 0.18);
+  transition: transform 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.2);
+}
+.bb-card i {
+  position: absolute;
+  top: 8px;
+  left: 8px;
+  width: 10px;
+  height: 10px;
+  border-radius: 3px;
+  background: rgba(255, 255, 255, 0.85);
+}
+.bb-card b {
+  position: absolute;
+  left: 8px;
+  bottom: 9px;
+  width: 36px;
+  height: 4px;
+  border-radius: 2px;
+  background: rgba(255, 255, 255, 0.55);
+}
+.bb-card.c1 {
+  top: 28px;
+  left: 22px;
+  background: linear-gradient(140deg, hsl(calc(var(--th) + 341.66) calc(70.05% * var(--ts)) 59.41%), hsl(calc(var(--th) + 341.26) calc(57.58% * var(--ts)) 38.82%));
+  transform: rotate(-8deg);
+}
+.bb-card.c2 {
+  top: 44px;
+  left: 64px;
+  background: linear-gradient(140deg, hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%));
+  transform: rotate(6deg);
+}
+.bb-card.c2 i,
+.bb-card.c2 b {
+  background: hsl(calc(var(--th) + 343.86) calc(66.67% * var(--ts)) 16.47% / 0.7);
+}
+.bb-tag {
+  position: absolute;
+  top: 24px;
+  right: 22px;
+  width: 16px;
+  height: 26px;
+  border-radius: 4px 4px 8px 8px;
+  background: hsl(calc(var(--th) + 76) calc(81.25% * var(--ts)) 87.45%);
+  transform: rotate(10deg);
+  transition: transform 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.2);
+}
+.bb-tile[data-k="4"][data-on="true"] .bb-card.c1 {
+  transform: translate(-6px, -4px) rotate(-14deg);
+}
+.bb-tile[data-k="4"][data-on="true"] .bb-card.c2 {
+  transform: translate(8px, 2px) rotate(12deg);
+}
+.bb-tile[data-k="4"][data-on="true"] .bb-tag {
+  transform: translateY(-6px) rotate(20deg);
+}
+
+/* the guide on the board: the same little character as on the rest of the site (.av), a bit smaller so it fits the street */
+.bb-board .av {
+  z-index: 6;
+}
+.bb-board .av-body {
+  scale: 0.72;
+}
+.bb-board .av[data-state="sit"] .av-body {
+  scale: 0.9;
+}
+.bb-board .av[data-state="sit"] .av-hop {
+  animation: bb-sit 3.2s ease-in-out infinite;
+}
+@keyframes bb-sit {
+  0%,
+  100% {
+    transform: translateY(0);
+  }
+  50% {
+    transform: translateY(-1px) scale(1.04);
+  }
+}
+
+/* copy: heading + text (centred, under the tag) */
+.bb-lead {
+  margin: 24px auto 0;
+  max-width: 920px;
+  text-wrap: balance;
+  font-size: clamp(1.7rem, 2.35vw, 2.4rem);
+  font-weight: 500;
+  line-height: 1.16;
+  letter-spacing: -0.035em;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%);
+}
+.bb-lead span {
+  opacity: calc(0.2 + 0.8 * var(--k, 1));
+  transition: opacity 0.3s;
+}
+.bb-lead span.hi {
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%);
+}
+.bb-body {
+  max-width: 780px;
+  margin: 24px auto 0;
+  font-size: 1rem;
+  line-height: 1.65;
+  text-wrap: balance;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.72);
+}
+
+/* the list: five equal rows, a rail beside them that fills like the street (one stop per box) and the button at the end */
+.bb-list {
+  display: flex;
+  flex-direction: column;
+  height: 572px;
+}
+.bb-list-intro {
+  flex: none;
+  margin: 0 0 14px;
+  padding-left: 40px;
+  font-size: 0.78rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.55);
+}
+.bb-items {
+  position: relative;
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.bb-rail {
+  position: absolute;
+  left: 9px;
+  top: calc(50% / var(--n, 5));
+  bottom: calc(50% / var(--n, 5));
+  width: 2px;
+  border-radius: 1px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.18);
+}
+.bb-rail i {
+  position: absolute;
+  inset: 0 0 auto;
+  height: calc(var(--rail, 0) * 100%);
+  border-radius: 1px;
+  background: linear-gradient(180deg, hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%));
+  box-shadow: 0 0 10px 1px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.7);
+}
+.bb-item {
+  position: relative;
+  flex: 1;
+  min-height: 0;
+  padding-left: 40px;
+}
+.bb-node {
+  position: absolute;
+  top: 50%;
+  left: 3px;
+  width: 14px;
+  height: 14px;
+  margin-top: -7px;
+  border-radius: 50%;
+  border: 2px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.35);
+  background: hsl(calc(var(--th) + 344.8) calc(67.57% * var(--ts)) 7.25%);
+  transition: background 0.4s, border-color 0.4s, box-shadow 0.4s, scale 0.4s;
+}
+.bb-item[data-lit="true"] .bb-node {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%);
+}
+.bb-item[data-on="true"] .bb-node {
+  border-color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%);
+  background: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%);
+  box-shadow: 0 0 14px 3px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.8);
+  scale: 1.2;
+}
+.bb-item button {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  width: 100%;
+  height: 100%;
+  padding: 0 20px;
+  border: 1px solid transparent;
+  border-radius: 16px;
+  background: none;
+  font: inherit;
+  text-align: left;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.5);
+  cursor: pointer;
+  transition:
+    background 0.5s,
+    border-color 0.5s,
+    color 0.4s;
+}
+.bb-item button:hover {
+  color: rgba(255, 255, 255, 0.85);
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.18);
+}
+.bb-item[data-on="true"] button {
+  color: #fff;
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.4);
+  background: linear-gradient(100deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.16), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.03));
+  box-shadow: 0 14px 34px -16px hsl(calc(var(--th) + 347.27) calc(100% * var(--ts)) 67.65% / 0.55);
+}
+.bb-n {
+  flex: none;
+  font-size: 0.78rem;
+  letter-spacing: 0.1em;
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.7);
+}
+.bb-item[data-on="true"] .bb-n {
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16%);
+}
+.bb-t {
+  display: grid;
+  gap: 4px;
+  min-width: 0;
+}
+.bb-p {
+  font-size: 1.3rem;
+  font-weight: 500;
+  letter-spacing: -0.02em;
+  line-height: 1.15;
+}
+.bb-x {
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  font-size: 0.86rem;
+  line-height: 1.4;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.45);
+  transition: color 0.4s;
+}
+.bb-item[data-on="true"] .bb-x {
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.82);
+}
+.bb-end {
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 20px;
+  height: 48px;
+  margin-top: 22px;
+  padding-left: 40px;
+}
+.bb-cta {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  height: 48px;
+  padding: 0 26px;
+  border-radius: 10px;
+  font-size: 0.9rem;
+  font-weight: 600;
+  opacity: 0.55;
+  transition: opacity 0.6s, transform 0.5s, box-shadow 0.6s, filter 0.3s;
+}
+.bb-cta:hover {
+  filter: brightness(1.1);
+}
+.bb-list[data-done="true"] .bb-cta {
+  opacity: 1;
+  transform: translateY(-2px);
+  box-shadow: 0 12px 34px -8px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.65);
+}
+.bb-note {
+  margin: 0;
+  font-size: 0.84rem;
+  line-height: 1.4;
+  color: hsl(calc(var(--th) + 358) calc(100% * var(--ts)) 92.16% / 0.5);
+}
+/* Phones (up to 700 px): the tag, heading and text scroll away as normal text; then ONLY the board is pinned (scaled to the width
+   of the screen) with the step the guide is at shown under it, and the button at the end. Same scroll-driven walk as on a laptop. */
+@media (max-width: 700px) {
+  .bb-track {
+    height: auto;
+  }
+  .bb-stage {
+    position: static;
+    display: block;
+    height: auto;
+    padding: 72px 0 90px;
+    overflow: visible;
+  }
+  .bb {
+    zoom: 1;
+    padding: 0 16px;
+  }
+  .bb-lead {
+    font-size: 1.6rem;
+  }
+  .bb-body {
+    font-size: 0.95rem;
+  }
+  .bb-pin {
+    height: 250vh;
+    margin-top: 28px;
+  }
+  .bb-row {
+    position: sticky;
+    top: 78px;
+    zoom: var(--fit, 1);
+    grid-template-columns: 436px;
+    gap: 22px;
+    margin-top: 0;
+  }
+  .bb-list {
+    height: auto;
+  }
+  .bb-list-intro,
+  .bb-rail,
+  .bb-node {
+    display: none;
+  }
+  .bb-items {
+    display: block;
+  }
+  .bb-item {
+    display: none;
+    padding-left: 0;
+    min-height: 92px;
+  }
+  .bb-item[data-on="true"] {
+    display: block;
+  }
+  .bb-item button {
+    min-height: 92px;
+    padding: 12px 18px;
+  }
+  .bb-end {
+    height: auto;
+    margin-top: 18px;
+    padding-left: 0;
+    flex-wrap: wrap;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .bb-tile[data-k="0"][data-on="true"] .bb-ring,
+  .bb-board .av[data-state="sit"] .av-hop {
+    animation: none;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   Colour picker (components/site/theme-picker.tsx): the card that asks for a colour + a name, and the small button that reopens it.
+   All its colours come from --pc (the colour being picked) and the theme tokens, so it is readable on every theme. */
+html.tp-open {
+  overflow: hidden;
+}
+.tp-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 9990;
+  display: grid;
+  place-items: center;
+  padding: 20px;
+  background: color-mix(in srgb, var(--color-void) 52%, transparent);
+  -webkit-backdrop-filter: blur(9px);
+  backdrop-filter: blur(9px);
+  animation: tp-fade 0.5s ease both;
+  overflow-y: auto;
+}
+@keyframes tp-fade {
+  from {
+    opacity: 0;
+  }
+}
+.tp-card {
+  width: min(94vw, 470px);
+  padding: 30px 28px 26px;
+  border: 1px solid color-mix(in srgb, var(--color-violet) 22%, transparent);
+  border-radius: 28px;
+  background: linear-gradient(160deg, color-mix(in srgb, var(--color-dusk) 78%, transparent), color-mix(in srgb, var(--color-void) 92%, transparent));
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.14),
+    0 40px 90px -20px rgba(0, 0, 0, 0.7),
+    0 0 80px -30px var(--color-violet);
+  text-align: center;
+  animation: tp-rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+@keyframes tp-rise {
+  from {
+    opacity: 0;
+    transform: translateY(24px) scale(0.96);
+    filter: blur(10px);
+  }
+}
+.tp-chip {
+  display: inline-block;
+  padding: 5px 14px;
+  border: 1px solid color-mix(in srgb, var(--color-violet) 35%, transparent);
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--color-violet) 10%, transparent);
+  color: var(--color-violet);
+  font-size: 0.78rem;
+  font-weight: 500;
+}
+.tp-title {
+  margin: 14px 0 0;
+  color: #fff;
+  font-size: clamp(1.5rem, 5.4vw, 1.9rem);
+  font-weight: 600;
+  letter-spacing: -0.03em;
+  line-height: 1.15;
+}
+.tp-title em {
+  color: var(--color-violet);
+  font-style: normal;
+}
+.tp-sub {
+  max-width: 34ch;
+  margin: 10px auto 0;
+  color: rgba(255, 255, 255, 0.68);
+  font-size: 0.92rem;
+  line-height: 1.5;
+}
+
+/* the picker */
+.tp-picker {
+  position: relative;
+  width: 330px;
+  max-width: 100%;
+  height: 300px;
+  margin: 8px auto 0;
+}
+.tp-row {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  transition: opacity 0.4s, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.tp-row[data-open="true"] {
