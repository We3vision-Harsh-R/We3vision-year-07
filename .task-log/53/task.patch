+// ------------------------------------------------------------------------------------------------------------ CRM
+type Deal = { id: number; name: string; col: number };
+const DEALS: Deal[] = [
+  { id: 0, name: "Acme Co.", col: 0 },
+  { id: 1, name: "Bright Ltd", col: 0 },
