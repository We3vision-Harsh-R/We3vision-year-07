+  border: 1px solid var(--hair);
+  border-radius: 20px;
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.09), hsl(calc(var(--th) + 346) calc(60% * var(--ts)) 9% / 0.5) 70%);
+}
+.mm-rec-t {
+  margin: 0 0 0.9rem;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+.mm-rec ul {
