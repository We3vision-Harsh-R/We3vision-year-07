+
+/* Industries (home): the depth-of-field layers and the haze of the far end of the road started at full strength at the very top edge of the pinned picture,
+   which showed as a hard line (the stars above it, a dark band below it). They now fade IN from the top edge, so the picture melts into the sky of the
+   section above. */
+.cm-dof i {
+  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 var(--r, 6%), #000 var(--s), transparent var(--e));
+  mask-image: linear-gradient(to bottom, transparent 0, #000 var(--r, 6%), #000 var(--s), transparent var(--e));
+}
+.cm-dof i:nth-child(1) {
+  --r: 6%;
+  --s: 14%;
+}
+.cm-dof i:nth-child(2) {
+  --r: 5%;
+  --s: 10%;
+  --e: 26%;
+}
+.cm-dof i:nth-child(3) {
+  --r: 4%;
+  --s: 7%;
+  --e: 17%;
+}
+.cm-dof::after {
+  height: 46%;
+  background: linear-gradient(
+    to bottom,
+    transparent 0,
+    hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9% / 0.35) 12%,
+    hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9% / 0.72) 28%,
+    hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9% / 0.4) 58%,
+    transparent
+  );
+}
+
+/* Industries (home): a thin hard line stayed along the top edge of the pinned picture (the edge of the box that holds the city). The top of the whole stage
+   now fades in over its first 14%, so there is no edge at all against the section above. (Only the top: the list and the card at the bottom stay clear.) */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-stage {
+    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%);
+    mask-image: linear-gradient(to bottom, transparent 0, #000 14%);
+  }
+}
+
+/* Industries (home): the colours of the city meet the colours of the sky. The ground of the city and the haze at its far end were almost black next to the
+   violet sky of the page above (a different colour, not only a darker one). They are now the same dark violet as the page background with the lights in it,
+   a little lighter, so the picture grows out of the sky without a change of tone. */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-ground {
+    background-color: hsl(calc(var(--th) + 350) calc(52% * var(--ts)) 10%);
+  }
+  .cm-dof::after {
+    background: linear-gradient(
+      to bottom,
+      transparent 0,
+      hsl(calc(var(--th) + 350) calc(52% * var(--ts)) 12% / 0.3) 12%,
+      hsl(calc(var(--th) + 350) calc(52% * var(--ts)) 11% / 0.55) 30%,
+      hsl(calc(var(--th) + 350) calc(52% * var(--ts)) 10% / 0.32) 58%,
+      transparent
+    );
+  }
+}
+
+/* CursorGrid (components/site/modern/cursor-grid.tsx): the grid of cells behind the first screen of the blog */
+.cursor-grid {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+}
+.cursor-grid__canvas {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+.cg-hero {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+
+/* The blog hero: the cells of the grid fade out and go out of focus towards the bottom of the first screen, so the screen melts into the next section
+   (the cells were cut off along the edge of the section). */
+.cg-hero {
+  -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 100%);
+  mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 100%);
+}
+
+
+/* Admin panel, Blog: the shapes to choose from, and the preview of the Blog page (laptop / desktop / large screen) */
+.adb-tiles {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 12px;
+  margin-top: 12px;
+}
+.adb-tile {
+  display: grid;
+  justify-items: center;
+  align-content: start;
+  gap: 4px;
+  padding: 12px 10px;
+  border: 1.5px solid rgb(228 228 231);
+  border-radius: 12px;
+  background: #fff;
+  cursor: pointer;
+  text-align: center;
+  transition:
+    border-color 0.2s,
+    box-shadow 0.2s,
+    background 0.2s;
+}
+.adb-tile:hover {
+  border-color: rgb(161 161 170);
+}
+.adb-tile[data-on="true"] {
+  border-color: var(--color-brand, #7c3aed);
+  background: rgb(250 245 255);
+  box-shadow: 0 0 0 3px rgb(124 58 237 / 0.15);
+}
+.adb-tile-shape {
+  display: block;
+  width: 56px;
+  margin-bottom: 6px;
+  border-radius: 8px;
+  background: linear-gradient(135deg, rgb(196 181 253), rgb(124 58 237));
+}
+.adb-tile b {
+  font-size: 0.875rem;
+  color: rgb(39 39 42);
+}
+.adb-tile small {
+  font-size: 0.75rem;
+  color: rgb(113 113 122);
+}
+.adb-views {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 14px;
+}
+.adb-views button {
+  display: grid;
+  gap: 1px;
+  padding: 8px 14px;
+  border: 1px solid rgb(228 228 231);
+  border-radius: 10px;
+  background: #fff;
+  color: rgb(63 63 70);
+  font-size: 0.875rem;
+  font-weight: 600;
+  text-align: left;
+  cursor: pointer;
+}
+.adb-views button span {
+  font-size: 0.75rem;
+  font-weight: 400;
+  color: rgb(113 113 122);
+}
+.adb-views button[data-on="true"] {
+  border-color: var(--color-brand, #7c3aed);
+  background: rgb(250 245 255);
+  color: rgb(76 29 149);
+}
+.adb-frame {
+  overflow: hidden;
+  padding: 10px;
+  border-radius: 14px;
+  background: hsl(285 45% 8%);
+}
+.adb-empty {
+  margin: 0;
+  padding: 2rem;
+  text-align: center;
+  color: rgb(161 161 170);
+  font-size: 0.875rem;
+}
+
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The Blog page: the cover pictures as a masonry (components/site/modern/blog-masonry.tsx). Every picture has its own shape; they are placed by script
+   (translate + size), the container is as high as the longest column.
+   - .bm-item  the cell (an empty margin round the card: the pointer there is "between the cards")
+   - .bm-frame the card with the border glow (.bglow)
+   - .bm-card  the clipped box with the picture and the title */
+.bm {
+  position: relative;
+  width: 100%;
+}
+.bm-item {
+  position: absolute;
+  top: 0;
+  left: 0;
+  display: block;
+  padding: 7px;
+  color: #fff;
+  text-decoration: none;
+  pointer-events: none;
+}
+.bm[data-settled="true"] .bm-item {
+  transition:
+    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
+    width 0.6s cubic-bezier(0.22, 1, 0.36, 1),
+    height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.bm-item[data-on="true"] {
+  z-index: 4;
+}
+.bm-frame {
+  --card-bg: hsl(calc(var(--th) + 347) calc(40% * var(--ts)) 10%);
+  position: relative;
+  display: block;
+  width: 100%;
+  height: 100%;
+  border-radius: 16px;
+  pointer-events: auto;
+  box-shadow: 0 18px 50px -24px rgba(0, 0, 0, 0.75);
+  transition:
+    scale 0.4s cubic-bezier(0.22, 1, 0.36, 1),
+    box-shadow 0.3s;
+  animation: bm-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
+  animation-delay: calc(var(--i, 0) * 60ms);
+}
+@keyframes bm-in {
+  from {
+    opacity: 0;
+    transform: translateY(70px);
+    filter: blur(10px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+    filter: blur(0);
+  }
+}
+.bm-card {
+  position: relative;
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+  border: 1px solid hsl(0 0% 100% / 0.1);
+  border-radius: inherit;
+  background: hsl(calc(var(--th) + 347) calc(40% * var(--ts)) 10%);
+  transition: border-color 0.3s;
+}
+.bm-item[data-on="true"] .bm-frame {
+  scale: 0.97;
+  box-shadow: 0 26px 60px -22px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.45);
+}
+.bm-item[data-on="true"] .bm-card {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.35);
+}
+.bm-frame[data-hl="true"] {
+  box-shadow:
+    0 0 0 3px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.45),
+    0 18px 50px -24px rgba(0, 0, 0, 0.75);
+}
+.bm-item:focus-visible {
+  outline: none;
+}
+.bm-img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transition:
+    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
+    filter 0.45s ease,
+    opacity 0.45s ease;
+}
+.bm-item[data-on="true"] .bm-img {
+  transform: scale(1.05);
+}
+/* a card is in focus: the other pictures go out of focus; only the picture inside is blurred, the frame of the card stays sharp (so it still reads
+   as a card). The pointer between the cards: nothing is in focus, everything is clear. */
+.bm[data-active="true"] .bm-item[data-on="false"] .bm-img {
+  filter: blur(9px) saturate(0.8);
+  opacity: 0.5;
+  transform: scale(1.1);
+}
+.bm-empty {
+  display: grid;
+  width: 100%;
+  height: 100%;
+  place-items: center;
+  color: hsl(calc(var(--th) + 354) calc(40% * var(--ts)) 75% / 0.6);
+  font-size: 0.9375rem;
+}
+/* the title only shows on the card in focus; at rest only the pictures are seen */
+.bm-cap {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  left: 0;
+  display: grid;
+  gap: 8px;
+  justify-items: start;
+  padding: 3.2rem 1.1rem 1.1rem;
+  background: linear-gradient(to top, hsl(calc(var(--th) + 346) calc(60% * var(--ts)) 6% / 0.92), transparent);
+  opacity: 0;
+  transform: translateY(8px);
+  transition:
+    opacity 0.3s,
+    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.bm-item[data-on="true"] .bm-cap {
+  opacity: 1;
+  transform: none;
+}
+.bm-chip {
+  padding: 3px 11px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.4);
+  border-radius: 999px;
+  background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 10% / 0.7);
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84%);
+  font-size: 0.875rem;
+  font-weight: 500;
+}
+.bm-title {
+  font-size: 1.125rem;
+  font-weight: 600;
+  line-height: 1.3;
+  letter-spacing: -0.01em;
+  text-align: left;
+}
+
+/* the panel that opens after 2 seconds on one card: the brief of the article */
+.bm-info {
+  position: absolute;
+  z-index: 10;
+  display: grid;
+  gap: 10px;
+  padding: 20px 22px 22px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.35);
+  border-radius: 20px;
+  background: hsl(calc(var(--th) + 347) calc(48% * var(--ts)) 8% / 0.94);
+  -webkit-backdrop-filter: blur(16px) saturate(1.2);
+  backdrop-filter: blur(16px) saturate(1.2);
+  box-shadow:
+    inset 0 1px 0 hsl(0 0% 100% / 0.1),
+    0 30px 70px -26px rgba(0, 0, 0, 0.9),
+    0 0 40px -12px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.4);
+  animation: bm-info-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+@keyframes bm-info-in {
+  from {
+    opacity: 0;
+    transform: translateY(10px) scale(0.96);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+.bm-info h3 {
+  margin: 0;
+  color: #fff;
+  font-size: 1.25rem;
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.02em;
+}
+.bm-info-chip {
+  justify-self: start;
+  padding: 3px 11px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.4);
+  border-radius: 999px;
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84%);
+  font-size: 0.875rem;
+  font-weight: 500;
+}
+.bm-info-meta {
+  margin: 0;
+  color: hsl(calc(var(--th) + 354) calc(40% * var(--ts)) 78% / 0.8);
+  font-size: 0.875rem;
+}
+.bm-info-text {
+  margin: 0;
+  color: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.9);
+  font-size: 1rem;
+  line-height: 1.55;
+}
+.bm-info-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.bm-info-tags li {
+  padding: 2px 10px;
+  border-radius: 999px;
+  background: hsl(0 0% 100% / 0.07);
+  color: hsl(calc(var(--th) + 354) calc(50% * var(--ts)) 86%);
+  font-size: 0.875rem;
+}
+.bm-info-go {
+  justify-self: start;
+  margin-top: 4px;
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82%);
+  font-size: 1rem;
+  font-weight: 600;
+  text-decoration: underline;
+  text-underline-offset: 5px;
+}
+@media (prefers-reduced-motion: reduce) {
+  .bm-frame,
+  .bm-info {
+    animation: none;
+  }
+}
+
+/* The menu pill and its round button are frosted glass; over a bright picture (the blog cards, a photo) the thin tint let the words melt into the picture.
+   On the inner pages the glass has a dark violet base under the blur, so the words are readable on whatever is behind; the links are brighter.
+   (The Home page keeps its pill exactly as it was.) */
+.fn-root[data-page="inner"] .fn-glass {
+  background:
+    linear-gradient(180deg, rgba(255, 255, 255, 0.08), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.1)),
+    hsl(calc(var(--th) + 347) calc(48% * var(--ts)) 8% / 0.7);
+  -webkit-backdrop-filter: blur(22px) saturate(1.35);
+  backdrop-filter: blur(22px) saturate(1.35);
+}
+.fn-root[data-page="inner"] .fn-link {
+  color: hsl(calc(var(--th) + 354) calc(40% * var(--ts)) 92%);
+  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
+}
+.fn-root[data-page="inner"] .fn-link:hover {
+  color: #fff;
+}
+
+/* the panel is exactly the size of its card: what does not fit is clipped, and on a low card the small parts are left out */
+.bm-info {
+  align-content: start;
+  overflow: hidden;
+  box-sizing: border-box;
+}
+.bm-info-text {
+  display: -webkit-box;
+  overflow: hidden;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 7;
+}
+.bm-info[data-short="true"] {
+  gap: 8px;
+  padding: 16px 20px 18px;
+}
+.bm-info[data-short="true"] h3 {
+  display: -webkit-box;
+  overflow: hidden;
+  font-size: 1.125rem;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+.bm-info[data-short="true"] .bm-info-chip,
+.bm-info[data-short="true"] .bm-info-tags {
+  display: none;
+}
+.bm-info[data-short="true"] .bm-info-text {
+  -webkit-line-clamp: 3;
+}
+
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The admin login page (components/admin/login-screen.tsx): a split screen. Left the form, right a rounded picture card with a line over a
+   frosted strip. Written in the colours of the site (--th / --ts), for laptop and desktop screens. */
+.al {
+  --al-line: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.18);
+  --al-soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 90% / 0.78);
+  position: fixed;
+  inset: 0;
+  z-index: 50;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  background: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9%); /* the glow and stars of the site come from <Background /> */
+  color: #fff;
+  font-family: var(--font-sans);
+  overflow: auto;
+}
+.al-side {
+  display: grid;
+  place-items: center;
+  padding: 32px;
+}
+.al-form {
+  width: 100%;
+  max-width: 360px;
+  text-align: center;
+}
+.al-icon {
+  display: inline-grid;
+  width: 52px;
+  height: 52px;
+  place-items: center;
+  border: 1px solid var(--al-line);
+  border-radius: 14px;
+  background: linear-gradient(180deg, hsl(calc(var(--th) + 346.97) calc(58% * var(--ts)) 13%), hsl(calc(var(--th) + 347.43) calc(61% * var(--ts)) 9%));
+  box-shadow:
+    inset 0 1px 0 hsl(0 0% 100% / 0.1),
+    0 10px 30px -12px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.55);
+}
+.al-icon img {
+  width: auto;
+  height: 26px;
+}
+.al h1 {
+  margin: 24px 0 0;
+  font-size: 1.75rem;
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.02em;
+}
+.al-sub {
+  margin: 10px 0 0;
+  color: var(--al-soft);
+  font-size: 1rem;
+  line-height: 1.5;
+}
+.al form {
+  margin-top: 32px;
+  text-align: left;
+}
+.al-field {
+  display: block;
+  margin-bottom: 20px;
+}
+.al-field > span:first-child {
+  display: block;
+  margin-bottom: 6px;
+  color: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 94% / 0.92);
+  font-size: 0.875rem;
+  font-weight: 500;
+}
+.al-pass {
+  position: relative;
+  display: block;
+}
+.al input[type="email"],
+.al input[type="password"],
+.al input[type="text"] {
+  display: block;
+  width: 100%;
+  height: 52px;
+  padding: 0 16px;
+}
+.al-pass input {
+  padding-right: 50px;
+}
+.al-eye {
+  position: absolute;
+  top: 0;
+  right: 0;
+  display: grid;
+  width: 50px;
+  height: 52px;
+  place-items: center;
+  border: 0;
+  background: none;
+  color: hsl(calc(var(--th) + 354) calc(40% * var(--ts)) 78% / 0.75);
+  cursor: pointer;
+  transition: color 0.2s;
+}
+.al-eye:hover,
+.al-eye:focus-visible {
+  color: #fff;
+  outline: none;
+}
+.al-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 24px;
+}
+.al-check {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  color: var(--al-soft);
+  font-size: 0.875rem;
+  cursor: pointer;
+}
+.al-check input {
+  appearance: none;
+  display: grid;
+  width: 18px;
+  height: 18px;
+  margin: 0;
+  place-content: center;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.4);
+  border-radius: 5px;
+  background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 9%);
+  cursor: pointer;
+  transition:
+    background 0.2s,
+    border-color 0.2s;
+}
+.al-check input::after {
+  content: "";
+  width: 9px;
+  height: 5px;
+  margin-top: -2px;
+  border-bottom: 2px solid hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 8%);
+  border-left: 2px solid hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 8%);
+  opacity: 0;
+  transform: rotate(-45deg) scale(0.6);
+  transition:
+    opacity 0.15s,
+    transform 0.2s;
+}
+.al-check input:checked {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 78%);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 78%);
+}
+.al-check input:checked::after {
+  opacity: 1;
+  transform: rotate(-45deg) scale(1);
+}
+.al-check input:focus-visible {
+  box-shadow: 0 0 0 4px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.25);
+  outline: none;
+}
+.al-link {
+  padding: 0;
+  border: 0;
+  background: none;
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82%);
+  font: inherit;
+  font-size: 0.875rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: color 0.2s;
+}
+.al-link:hover,
+.al-link:focus-visible {
+  color: #fff;
+  outline: none;
+}
+.al-note,
+.al-error {
+  margin: -8px 0 20px;
+  padding: 10px 14px;
+  border-radius: 10px;
+  font-size: 0.875rem;
+  line-height: 1.5;
+}
+.al-note {
+  border: 1px solid var(--al-line);
+  background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 10%);
+  color: var(--al-soft);
+}
+.al-error {
+  margin-top: 0;
+  border: 1px solid hsl(350 90% 70% / 0.4);
+  background: hsl(350 70% 20% / 0.5);
+  color: hsl(350 100% 90%);
+}
+.al-submit {
+  display: block;
+  width: 100%;
+  height: 46px;
+  border: 0;
+  border-radius: 10px;
+  color: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 6%);
+  font: inherit;
+  font-size: 1rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition:
+    transform 0.2s,
+    filter 0.2s,
+    opacity 0.2s;
+}
+.al-submit:hover {
+  filter: brightness(1.06);
+}
+.al-submit:active {
+  transform: translateY(1px);
+}
+.al-submit:disabled {
+  cursor: progress;
+  opacity: 0.7;
+}
+.al-submit:focus-visible {
+  box-shadow: 0 0 0 4px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.3);
+  outline: none;
+}
+.al-foot {
+  margin: 32px 0 0;
+  color: var(--al-soft);
+  font-size: 0.875rem;
+}
+
+/* the right side: the picture card */
+.al-art {
+  position: relative;
+  margin: 24px 24px 24px 0;
+  min-height: 480px;
+  overflow: hidden;
+  border: 1px solid var(--al-line);
+  border-radius: 24px;
+  background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 8%);
+}
+.al-photo {
+  position: absolute;
+  inset: 0;
+  width: 100%;
