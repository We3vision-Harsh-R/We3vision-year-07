+  padding: 0.6cqw 1.4cqw;
+  background: #15102a;
+  border-top: 1px solid rgba(255, 255, 255, 0.07);
+  color: #8f87ad;
+  font: 500 1cqw ui-monospace, SFMono-Regular, Menlo, monospace;
+}
+.ob-bar {
+  flex: 1;
+  height: 0.5cqw;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.08);
+  overflow: hidden;
+}
+.ob-bar i {
+  display: block;
+  height: 100%;
+  background: linear-gradient(90deg, var(--g-b), var(--g-a));
+  transition: width 0.1s linear;
+}
+.ob-term {
+  position: absolute;
+  right: 1.2cqw;
+  bottom: 4cqw;
+  left: 1.2cqw;
+  padding: 1cqw 1.4cqw;
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  border-radius: 1cqw;
+  background: rgba(8, 5, 20, 0.94);
+  color: #7ee787;
+  font: 500 1.2cqw / 1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
+}
+.ob-term p {
+  margin: 0;
+  animation: gs-pop 0.3s ease-out both;
+}
+
+/* the browser */
+.ob-viewport {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+  cursor: grab;
+}
+.ob-viewport:active {
+  cursor: grabbing;
+}
+.ob-frame {
+  position: relative;
+  margin: 0 auto;
+  overflow: hidden;
+  background: var(--bg, #fff);
+  transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.ob-frame[data-device="tablet"] {
+  margin-top: 1.4cqh;
+  height: 96% !important;
+  border: 0.5cqw solid #2c2447;
+  border-radius: 2cqw;
+}
+.ob-frame[data-device="phone"] {
+  margin-top: 1.4cqh;
+  height: 96% !important;
+  border: 0.55cqw solid #2c2447;
+  border-radius: 3cqw;
+}
+.ob-inner {
+  position: absolute;
+  top: 0;
+  left: 0;
+  transform-origin: 0 0;
+  will-change: transform;
+}
+.ob-sb {
+  position: absolute;
+  top: 1cqh;
+  right: 0.5cqw;
+  bottom: 1cqh;
+  z-index: 3;
+  width: 0.45cqw;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.06);
+  pointer-events: none;
+}
+.ob-sb-thumb {
+  position: absolute;
+  right: 0;
+  left: 0;
+  border-radius: 999px;
+  background: var(--g-a);
+  opacity: 0.8;
+}
+.ob-toast {
+  position: absolute;
+  bottom: 2cqh;
+  left: 50%;
+  z-index: 4;
+  margin: 0;
+  padding: 0.5cqw 1.6cqw;
+  border-radius: 999px;
+  background: rgba(15, 10, 30, 0.9);
+  color: #fff;
+  font-size: 1.2cqw;
+  font-weight: 600;
+  transform: translateX(-50%);
+  animation: gs-pop 0.3s ease-out both;
+}
+
+/* the controls on the desk */
+.ob-ctl {
+  position: absolute;
+  right: 14%;
+  bottom: 2.4%;
+  left: 17%;
+  z-index: 5;
+  display: flex;
+  flex-direction: column;
+  gap: 0.7cqw;
+  pointer-events: auto;
+}
+.ob-tools {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.7cqw 1cqw;
+  padding: 0.6cqw 1cqw;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.25);
+  border-radius: 999px;
+  background: rgba(10, 6, 18, 0.72);
+  backdrop-filter: blur(10px);
+  animation: gs-pop 0.4s ease-out both;
+}
+.ob-sw {
+  display: flex;
+  gap: 0.6cqw;
+}
+.ob-sw button {
+  width: 1.9cqw;
+  height: 1.9cqw;
+  border: 2px solid transparent;
+  border-radius: 50%;
+  cursor: pointer;
+  transition: transform 0.25s;
+}
+.ob-sw button[data-on="true"] {
+  border-color: #fff;
+  transform: scale(1.2);
+}
+.ob-seg {
+  display: flex;
+  padding: 0.2cqw;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.07);
+}
+.ob-seg button,
+.ob-mini {
+  padding: 0.35cqw 1.1cqw;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: #d8d1f0;
+  font-size: clamp(0.64rem, 1cqw, 0.85rem);
+  text-transform: capitalize;
+  cursor: pointer;
+  transition: background 0.25s, color 0.25s;
+}
+.ob-seg button[data-on="true"],
+.ob-mini[data-on="true"] {
+  background: var(--g-a);
+  color: var(--g-e);
+  font-weight: 700;
+}
+.ob-mini {
+  background: rgba(255, 255, 255, 0.07);
+  text-transform: none;
+}
+.ob-form label {
+  display: flex;
+  align-items: center;
+  gap: 0.6cqw;
+  margin: 0 0 0.35cqw 1.4cqw;
+  color: var(--g-w);
+  font-size: clamp(0.66rem, 1cqw, 0.85rem);
+  font-weight: 600;
+  letter-spacing: 0.04em;
+}
+.ob-form label b {
+  display: grid;
+  width: 1.5cqw;
+  height: 1.5cqw;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--g-a);
+  color: var(--g-e);
+  font-size: 0.9cqw;
+}
+.ob-pill {
+  position: relative;
+  display: flex;
+  height: clamp(46px, 4.6cqw, 78px);
+  align-items: center;
+  gap: 1cqw;
+  padding: 0 0.7cqw 0 2cqw;
+  overflow: hidden;
+  border: 1.5px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.45);
+  border-radius: 999px;
+  background: linear-gradient(180deg, rgba(20, 12, 36, 0.92), rgba(8, 5, 18, 0.92));
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.1),
+    0 12px 40px -12px rgba(0, 0, 0, 0.8),
+    0 0 3cqw hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.18);
+  transition: box-shadow 0.3s, border-color 0.3s;
+}
+.ob-pill[data-focus="true"] {
+  border-color: var(--g-a);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.1),
+    0 12px 40px -12px rgba(0, 0, 0, 0.8),
+    0 0 0 4px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.22),
+    0 0 4cqw hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.35);
+}
+.ob-pill[data-shake="true"] {
+  animation: ob-shake 0.45s;
+}
+@keyframes ob-shake {
+  20%,
+  60% {
+    transform: translateX(-8px);
+  }
+  40%,
+  80% {
+    transform: translateX(8px);
+  }
+}
+.ob-pill input {
+  min-width: 0;
+  flex: 1;
+  border: 0;
+  background: transparent;
+  color: #fff;
+  font-size: clamp(1rem, 1.9cqw, 1.9rem);
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  outline: none;
+}
+.ob-pill input::placeholder {
+  color: rgba(255, 255, 255, 0.34);
+  font-weight: 500;
+}
+.ob-pill input:disabled {
+  opacity: 0.7;
+}
+.ob-ring {
+  width: clamp(20px, 2.1cqw, 34px);
+  height: clamp(20px, 2.1cqw, 34px);
+  flex: none;
+  transform: rotate(-90deg);
+}
+.ob-ring circle {
+  fill: none;
+  stroke: rgba(255, 255, 255, 0.14);
+  stroke-width: 2.4;
+}
+.ob-ring circle + circle {
+  stroke: var(--g-a);
+  stroke-dasharray: 62.8;
+  stroke-linecap: round;
+  transition: stroke-dashoffset 0.2s;
+}
+.ob-pill button {
+  position: relative;
+  display: inline-flex;
+  height: 80%;
+  align-items: center;
+  gap: 0.8cqw;
+  padding: 0 clamp(14px, 2.2cqw, 40px);
+  overflow: hidden;
+  border: 0;
+  border-radius: 999px;
+  background: linear-gradient(135deg, var(--g-b), var(--g-a));
+  color: var(--g-e);
+  font-size: clamp(0.8rem, 1.35cqw, 1.3rem);
+  font-weight: 800;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: transform 0.25s, filter 0.25s;
+}
+.ob-pill button::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.55) 50%, transparent 70%);
+  transform: translateX(-120%);
+  animation: ob-shine 3.2s ease-in-out infinite;
+}
+@keyframes ob-shine {
+  50%,
+  100% {
+    transform: translateX(120%);
+  }
+}
+.ob-pill button:hover:not(:disabled) {
+  transform: translateY(-1px) scale(1.02);
+  filter: brightness(1.08);
+}
+.ob-pill button:disabled {
+  cursor: default;
+  filter: saturate(0.7);
+}
+.ob-pill button i {
+  font-style: normal;
+}
+.ob-pbar {
+  position: absolute;
+  bottom: 0;
+  left: 0;
+  height: 4px;
+  background: var(--g-a);
+  box-shadow: 0 0 12px var(--g-a);
+  transition: width 0.1s linear;
+}
+.ob-eg {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.6cqw;
+  margin-left: 1.4cqw;
+  color: var(--g-w);
+  font-size: clamp(0.64rem, 0.95cqw, 0.82rem);
+}
+.ob-eg span {
+  opacity: 0.6;
+}
+.ob-eg button {
+  padding: 0.25cqw 1cqw;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.3);
+  border-radius: 999px;
+  background: rgba(10, 6, 18, 0.6);
+  color: #fff;
+  font-size: inherit;
+  cursor: pointer;
+  transition: border-color 0.2s, background 0.2s;
+}
+.ob-eg button:hover:not(:disabled) {
+  border-color: var(--g-a);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.15);
+}
+.ob-eg button:disabled {
+  opacity: 0.4;
+}
+.ob-note {
+  display: none;
+}
+
+/* ---- the website that gets built (laid out for 1280 px) ---- */
+.ws-root {
+  --a: hsl(calc(var(--th) + var(--wo, 354)) calc(88% * var(--ts)) 58%);
+  --a2: hsl(calc(var(--th) + var(--wo, 354) + 44) calc(90% * var(--ts)) 64%);
+  --asoft: hsl(calc(var(--th) + var(--wo, 354)) calc(80% * var(--ts)) 95%);
+  width: 100%;
+}
+.ws {
+  --bg: #ffffff;
+  --ink: #17122b;
+  --mute: #7a7494;
+  --card: hsl(calc(var(--th) + var(--wo, 354)) calc(60% * var(--ts)) 97%);
+  --line: rgba(23, 18, 43, 0.08);
+  --line2: rgba(23, 18, 43, 0.12);
+  width: 100%;
+  background: var(--bg);
+  color: var(--ink);
+  font: 16px / 1.5 var(--font-sans), system-ui, sans-serif;
+  transition: background 0.5s, color 0.5s;
+}
+.ws[data-mode="dark"] {
+  --bg: #0f0b1c;
+  --ink: #f3efff;
+  --mute: #9a93b8;
+  --card: #181230;
+  --line: rgba(255, 255, 255, 0.08);
+  --line2: rgba(255, 255, 255, 0.14);
+  --asoft: rgba(255, 255, 255, 0.05);
+}
+.ws-sec {
+  position: relative;
+  cursor: pointer;
+  opacity: 0;
+  filter: blur(10px);
+  transform: translateY(46px) scale(0.985);
+  transition: opacity 0.9s, filter 0.9s, transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.ws-sec[data-shown="true"] {
+  opacity: 1;
+  filter: none;
+  transform: none;
+}
+.ws-sec:hover {
+  outline: 3px dashed var(--a);
+  outline-offset: -8px;
+}
+.ws-tag {
+  position: absolute;
+  top: 12px;
+  right: 14px;
+  z-index: 2;
+  padding: 4px 12px;
+  border-radius: 999px;
+  background: var(--a);
+  color: #fff;
+  font-size: 12px;
+  font-weight: 700;
+  opacity: 0;
+  transform: translateY(-4px);
+  transition: opacity 0.25s, transform 0.25s;
+  pointer-events: none;
+}
+.ws-sec:hover .ws-tag {
+  opacity: 1;
+  transform: none;
+}
+.ws-line {
+  display: block;
+  height: 12px;
+  margin: 10px 0;
+  border-radius: 6px;
+  background: var(--line2);
+}
+.ws-btn {
+  padding: 14px 28px;
+  border: 0;
+  border-radius: 999px;
+  background: linear-gradient(135deg, var(--a), var(--a2));
+  color: #fff;
+  font: 700 16px var(--font-sans), system-ui, sans-serif;
+  box-shadow: 0 10px 30px -10px var(--a);
+  cursor: pointer;
+}
+.ws-btn-sm {
+  padding: 10px 20px;
+  font-size: 14px;
+}
+.ws-btn-ghost {
+  background: transparent;
+  color: var(--ink);
+  border: 2px solid var(--line2);
+  box-shadow: none;
+}
+.ws em {
+  font-style: normal;
+  background: linear-gradient(90deg, var(--a), var(--a2));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.ws h1,
+.ws h2,
+.ws h3 {
+  margin: 0;
+  letter-spacing: -0.035em;
+}
+.ws-eyebrow {
+  display: inline-block;
+  padding: 6px 16px;
+  border-radius: 999px;
+  background: var(--asoft);
+  color: var(--a);
+  font-size: 14px;
+  font-weight: 700;
+}
+.ws header {
+  margin-bottom: 48px;
+  text-align: center;
+}
+.ws header h2 {
+  margin-top: 16px;
+  font-size: 46px;
+  line-height: 1.1;
+}
+/* nav */
+.ws-nav {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 22px 56px;
+  border-bottom: 1px solid var(--line);
+}
+.ws-logo {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  font-size: 22px;
+}
+.ws-logo i {
+  display: grid;
+  width: 40px;
+  height: 40px;
+  place-items: center;
+  border-radius: 50%;
+  background: linear-gradient(135deg, var(--a), var(--a2));
+  color: #fff;
+  font-style: normal;
+  font-weight: 800;
+}
+.ws-nav nav {
+  display: flex;
+  gap: 34px;
+  color: var(--mute);
+  font-weight: 600;
+}
+/* hero */
+.ws-hero {
+  display: grid;
+  grid-template-columns: 1.1fr 0.9fr;
+  align-items: center;
+  gap: 40px;
+  padding: 80px 56px 90px;
+  overflow: hidden;
+  background: radial-gradient(60% 80% at 80% 20%, var(--asoft), transparent 70%);
+}
+.ws-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 18px;
+  border: 1px solid var(--line2);
+  border-radius: 999px;
+  font-size: 14px;
+  font-weight: 600;
+}
+.ws-badge i {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: #28c840;
+  box-shadow: 0 0 0 4px rgba(40, 200, 64, 0.2);
+  animation: ws-pulse 1.6s ease-in-out infinite;
+}
+@keyframes ws-pulse {
+  50% {
+    transform: scale(1.35);
+  }
+}
+.ws-hero h1 {
+  margin: 26px 0 22px;
+  font-size: 78px;
+  font-weight: 800;
+  line-height: 1.02;
+}
+.ws-lines {
+  max-width: 520px;
+}
+.ws-row {
+  display: flex;
+  gap: 16px;
+  margin-top: 30px;
+}
+.ws-proof {
+  display: flex;
+  align-items: center;
+  margin-top: 36px;
+  color: var(--mute);
+  font-size: 15px;
+}
+.ws-proof i {
+  width: 38px;
+  height: 38px;
+  margin-right: -10px;
+  border: 3px solid var(--bg);
+  border-radius: 50%;
+  background: hsl(calc(var(--th) + var(--wo, 354) + var(--k) * 50) calc(80% * var(--ts)) 66%);
+}
+.ws-proof span {
+  margin-left: 24px;
+}
+.ws-proof b {
+  color: var(--ink);
+}
+.ws-hero-art {
+  position: relative;
+  height: 440px;
+}
+.ws-blob {
+  position: absolute;
+  inset: 20px 10px 0 30px;
+  border-radius: 42% 58% 55% 45% / 48% 42% 58% 52%;
+  background: linear-gradient(140deg, var(--a), var(--a2));
+  opacity: 0.9;
+  animation: ws-morph 9s ease-in-out infinite alternate;
+}
+@keyframes ws-morph {
+  50% {
+    border-radius: 58% 42% 40% 60% / 55% 60% 40% 45%;
+    transform: rotate(8deg) scale(1.03);
+  }
+}
+.ws-card {
+  position: absolute;
+  padding: 18px 22px;
+  border-radius: 20px;
+  background: var(--bg);
+  box-shadow: 0 24px 50px -20px rgba(23, 18, 43, 0.5);
+  animation: ws-float 4.6s ease-in-out infinite;
+}
+.ws-c1 {
+  top: 36px;
+  left: -6px;
+  width: 190px;
+}
+.ws-c1 i {
+  display: block;
+  width: 42px;
+  height: 42px;
+  border-radius: 12px;
+  background: var(--a);
+}
+.ws-c2 {
+  right: 0;
+  bottom: 54px;
+  width: 170px;
+  animation-delay: -2s;
+}
+.ws-c2 b {
+  color: var(--a);
+  font-size: 30px;
+}
+@keyframes ws-float {
+  50% {
+    transform: translateY(-14px);
+  }
+}
+.ws-phone {
+  position: absolute;
+  top: 40px;
+  left: 50%;
+  width: 190px;
+  height: 360px;
+  padding: 14px;
+  border: 6px solid #17122b;
+  border-radius: 34px;
+  background: var(--bg);
+  transform: translateX(-30%) rotate(6deg);
+  box-shadow: 0 30px 60px -20px rgba(23, 18, 43, 0.6);
+}
+.ws-phone i {
+  display: block;
+  width: 60px;
+  height: 8px;
+  margin: 0 auto 16px;
+  border-radius: 4px;
+  background: #17122b;
+}
+.ws-phone div {
+  height: 74px;
+  margin-bottom: 12px;
+  border-radius: 14px;
+  background: var(--card);
+  animation: ws-shimmer 2.4s ease-in-out infinite;
+}
+.ws-phone div:nth-child(2) {
+  background: var(--a);
+  opacity: 0.8;
+}
+@keyframes ws-shimmer {
+  50% {
+    opacity: 0.55;
+  }
+}
+/* logos */
+.ws-logos {
+  padding: 40px 0;
+  border-block: 1px solid var(--line);
+  text-align: center;
+}
+.ws-logos p {
+  margin: 0 0 22px;
+  color: var(--mute);
+  font-size: 14px;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+.ws-marquee {
+  overflow: hidden;
+}
+.ws-marquee > div {
+  display: flex;
+  width: max-content;
+  gap: 24px;
+  animation: ws-marq 26s linear infinite;
+}
+@keyframes ws-marq {
+  to {
+    transform: translateX(-50%);
+  }
+}
+.ws-marquee span {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 14px 26px;
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  background: var(--card);
+}
+.ws-marquee i {
+  width: 26px;
+  height: 26px;
+  border-radius: 8px;
+  background: var(--a);
+  opacity: 0.8;
+}
+.ws-marquee span[data-k="1"] i,
+.ws-marquee span[data-k="4"] i {
+  border-radius: 50%;
+}
+.ws-marquee span[data-k="2"] i,
+.ws-marquee span[data-k="5"] i {
+  transform: rotate(45deg) scale(0.8);
+}
+/* services */
+.ws-services,
+.ws-process,
+.ws-gallery,
+.ws-reviews {
+  padding: 96px 56px;
+}
+.ws-grid3 {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 28px;
+}
+.ws-grid2 {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 28px;
+}
+.ws-box {
+  padding: 34px;
+  border: 1px solid var(--line);
+  border-radius: 26px;
+  background: var(--card);
+  transition: transform 0.35s, box-shadow 0.35s;
+}
+.ws-box:hover {
+  transform: translateY(-8px);
+  box-shadow: 0 30px 60px -30px var(--a);
+}
+.ws-box h3 {
+  margin: 20px 0 8px;
+  font-size: 24px;
+}
+.ws-ico {
+  display: block;
+  width: 60px;
+  height: 60px;
+  border-radius: 18px;
+  background: linear-gradient(135deg, var(--a), var(--a2));
+  box-shadow: 0 14px 30px -12px var(--a);
+}
+.ws-ico[data-k="1"] {
