+}
+/* the hint at the door */
+.vfo-hint {
+  position: absolute;
+  top: calc(var(--p) * 28);
+  right: 0;
+  left: 0;
+  z-index: 4;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
