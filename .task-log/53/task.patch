+  );
+}
+
+/** standing, seen from the front */
+export function PandaFront({ className = "" }: { className?: string }) {
+  const p = "pwf";
+  return (
+    <svg viewBox="0 0 120 130" preserveAspectRatio="xMidYMax meet" className={`pw pw-front ${className}`} aria-hidden focusable="false">
