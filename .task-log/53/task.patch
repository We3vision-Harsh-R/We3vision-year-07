+/* ---------------------------------------------------------------------------------------------------------------------------------
+   "At a glance" of the home page as a small control room (glance-orbit.tsx): a ring that counts the years (one light for every year, a comet goes
+   round) with the other facts as glass cards around it. When it comes into view the ring draws, the lights come on one after the other, the
+   cards fly in from the ring with a line back to it, and every figure counts up. Max 1200 px wide, in the middle. */
+.go {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.84);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.2);
+  max-width: 1200px;
+  margin-inline: auto;
+  padding-inline: clamp(1rem, 3vw, 2rem);
+}
+.go-stage {
+  display: grid;
+  align-items: center;
+  gap: 1.6rem;
+  margin-top: clamp(2.4rem, 6vh, 4rem);
+}
+@media (min-width: 900px) {
+  .go-stage {
+    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+    gap: clamp(2.6rem, 4.5vw, 4.4rem);
+  }
+}
+.go-side {
+  display: grid;
+  gap: 1.3rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+@media (max-width: 899px) {
+  .go-stage {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .go-side {
+    display: contents;
+  }
+  .go-ring {
+    order: -1;
+    grid-column: 1 / -1;
+    margin-inline: auto;
+  }
+}
+@media (max-width: 520px) {
+  .go-stage {
+    grid-template-columns: 1fr;
+  }
+}
+@media (min-width: 900px) {
+  .go-side[data-side="l"] {
+    justify-items: end;
+  }
+  .go-side[data-side="r"] {
+    justify-items: start;
+  }
+}
+
+/* the ring */
+.go-ring {
+  position: relative;
+  width: clamp(290px, 36vw, 470px);
+  aspect-ratio: 1;
+}
+.go-ring svg {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.go-track {
+  fill: none;
+  stroke: var(--hair);
+  stroke-width: 2;
+}
+.go-dash {
+  fill: none;
+  stroke: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.28);
+  stroke-width: 1.5;
+  stroke-dasharray: 2 10;
+  stroke-linecap: round;
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: go-spin 90s linear infinite reverse;
+}
+.go-arc {
+  fill: none;
+  stroke: var(--a);
+  stroke-width: 4;
+  stroke-linecap: round;
+  stroke-dasharray: 100;
+  stroke-dashoffset: 0;
+  transform: rotate(-90deg);
+  transform-origin: 50% 50%;
+  filter: drop-shadow(0 0 8px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.8));
+}
+.go-comet {
+  position: absolute;
+  inset: 0;
+  animation: go-spin 14s linear infinite;
+}
+.go-comet::before {
+  content: "";
+  position: absolute;
+  top: calc(12.5% - 5px);
+  left: calc(50% - 5px);
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: #fff;
+  box-shadow: 0 0 14px 4px var(--a), 0 0 40px 10px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.45);
+}
+@keyframes go-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+.go-tick {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+.go-tick i {
+  position: absolute;
+  top: var(--y);
+  left: var(--x);
+  width: 16px;
+  height: 16px;
+  margin: -8px 0 0 -8px;
+  border: 2px solid var(--a);
+  border-radius: 50%;
+  background: var(--a);
+  box-shadow: 0 0 16px 2px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.8);
+}
+.go-tick em {
+  position: absolute;
+  top: var(--ly);
+  left: var(--lx);
+  translate: -50% -50%;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  font-style: normal;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: 0.04em;
+}
+.go-core {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+}
+.go-core .go-num {
+  background: linear-gradient(180deg, #fff 25%, var(--a));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  font-size: clamp(5rem, 10vw, 8.4rem);
+  font-weight: 600;
+  letter-spacing: -0.05em;
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+.go-core span {
+  margin-top: 0.5rem;
+  color: #fff;
+  font-size: 1.25rem;
+  font-weight: 500;
+}
+.go-core small {
+  margin-top: 0.3rem;
+  color: var(--soft);
+  font-size: 1rem;
+}
+
+/* the cards */
+.go-card {
+  --dir: 1;
+  position: relative;
+  width: min(100%, 330px);
+  overflow: hidden;
+  padding: 1.3rem 1.5rem 1.6rem;
+  border: 1px solid var(--hair);
+  border-radius: 22px;
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.1), hsl(calc(var(--th) + 346) calc(60% * var(--ts)) 9% / 0.82) 70%);
+  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s, box-shadow 0.4s;
+}
+.go-card[data-side="r"] {
+  --dir: -1;
+}
+@media (max-width: 899px) {
+  .go-card {
+    --dir: 0;
+    width: 100%;
+  }
+}
+.go-card:hover {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.5);
+  box-shadow: 0 24px 50px -26px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 60% / 0.6);
+  transform: translateY(-5px);
+}
+.go-ic {
+  display: block;
+  width: 28px;
+  height: 28px;
+  fill: none;
+  stroke: var(--a);
+  stroke-width: 1.6;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.go-card .go-num {
+  display: block;
+  margin-top: 0.9rem;
+  color: #fff;
+  font-size: clamp(2.2rem, 3.2vw, 2.9rem);
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  line-height: 1.05;
+  font-variant-numeric: tabular-nums;
+}
+.go-label {
+  display: block;
+  margin-top: 0.35rem;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.4;
+}
+/* the line from a card back to the ring (a real element: the pseudo-elements of the card are used by the border glow) */
+.go-line {
+  display: none;
+}
+@media (min-width: 900px) {
+  .go-line {
+    display: block;
+    position: absolute;
+    top: 50%;
+    width: clamp(2.6rem, 4.5vw, 4.4rem);
+    height: 1px;
+    background: linear-gradient(90deg, var(--hair), var(--a));
+    transform-origin: left;
+  }
+  .go-card[data-side="l"] .go-line {
+    left: 100%;
+  }
+  .go-card[data-side="r"] .go-line {
+    right: 100%;
+    background: linear-gradient(270deg, var(--hair), var(--a));
+    transform-origin: right;
+  }
+  .go-card {
+    overflow: visible;
+  }
+}
+
+/* the show (only when the script has put it in the "wait" state: without it everything is simply there) */
+.go[data-go="wait"] .go-arc {
+  stroke-dashoffset: 100;
+}
+.go[data-go="wait"] .go-tick i {
+  opacity: 0;
+  scale: 0.3;
+}
+.go[data-go="wait"] .go-tick em,
+.go[data-go="wait"] .go-core span,
+.go[data-go="wait"] .go-core small,
+.go[data-go="wait"] .go-comet,
+.go[data-go="wait"] .go-track,
+.go[data-go="wait"] .go-dash {
+  opacity: 0;
+}
+.go[data-go="wait"] .go-card {
+  opacity: 0;
+}
+.go[data-go="in"] .go-arc {
+  animation: go-draw 2.3s cubic-bezier(0.4, 0, 0.2, 1) 0.2s both;
+}
+@keyframes go-draw {
+  from {
+    stroke-dashoffset: 100;
+  }
+}
+.go[data-go="in"] .go-tick i {
+  animation: go-pop 0.6s cubic-bezier(0.22, 1.5, 0.36, 1) calc(0.45s + var(--i) * 0.27s) both;
+}
+@keyframes go-pop {
+  from {
+    opacity: 0;
+    scale: 0.3;
+  }
+}
+.go-comet,
+.go-dash {
+  transition: opacity 1.2s ease 0.6s;
+}
+.go[data-go="in"] .go-tick em {
+  animation: go-fade 0.6s ease-out calc(0.55s + var(--i) * 0.27s) both;
+}
+.go[data-go="in"] .go-core span,
+.go[data-go="in"] .go-core small {
+  animation: go-fade 0.8s ease-out 0.9s both;
+}
+.go[data-go="in"] .go-track {
+  animation: go-fade 0.8s ease-out both;
+}
+@keyframes go-fade {
+  from {
+    opacity: 0;
+  }
+}
+.go[data-go="in"] .go-card {
+  animation: go-fly 0.95s cubic-bezier(0.22, 1.15, 0.36, 1) calc(1.15s + var(--k) * 0.18s) both;
+}
+@keyframes go-fly {
+  from {
+    opacity: 0;
+    transform: translate(calc(var(--dir) * 90px), 26px) scale(0.7);
+  }
+}
+.go[data-go="in"] .go-line {
+  animation: go-line 0.7s cubic-bezier(0.22, 1, 0.36, 1) calc(1.55s + var(--k) * 0.18s) both;
+}
+@keyframes go-line {
+  from {
+    transform: scaleX(0);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .go-comet,
+  .go-dash {
+    animation: none;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The logo at the top (logo-mark.tsx): the white logo with the company name at the top of the page. Once the page is scrolled the name slides into
+   the mark and fades, the logo shrinks to a small glass tile and the mark settles in it (the horizontal logo turns into the icon). And the
+   recognitions (hero-badges.tsx): one on the left and one on the right of the first screen, at the height of the logo. */
+.lm {
+  position: fixed;
+  inset-inline: 0;
+  top: 1.5rem;
+  z-index: 30;
+  display: flex;
+  justify-content: center;
+  pointer-events: none;
+}
+.lm a {
+  position: relative;
+  display: block;
+  width: 11.05rem;
+  height: 2.75rem;
+  border-radius: 0.8rem;
+  pointer-events: auto;
+  transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.lm a:hover .lm-mark,
+.lm a:hover .lm-text {
+  filter: brightness(1.3);
+}
+/* no box: only a soft patch of blur behind the logo (the logo is a transparent picture, so the page behind it would show through the letters); the patch has no
+   edge: it fades out round the logo */
+.lm a {
+  outline: none;
+}
+.lm a:focus-visible .lm-mark,
+.lm a:focus-visible .lm-text {
+  filter: drop-shadow(0 0 8px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.9));
+}
+.lm a::before {
+  content: "";
+  position: absolute;
+  inset: -1.1rem -1.6rem;
+  border-radius: 50%;
+  -webkit-backdrop-filter: blur(9px);
+  backdrop-filter: blur(9px);
+  -webkit-mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
+  mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
+  pointer-events: none;
+}
+.lm-mark,
+.lm-text {
+  position: absolute;
+  top: 50%;
+  max-width: none;
+  height: 2.75rem;
+  width: auto;
+}
+.lm-mark {
+  left: 0;
+  transform: translateY(-50%);
+  transition: left 0.7s cubic-bezier(0.22, 1, 0.36, 1), height 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s;
+}
+.lm-text {
+  left: 4.1rem;
+  transform: translateY(-50%);
+  transition: opacity 0.35s, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s;
+}
+.lm[data-scrolled="true"] a {
+  width: 2.75rem;
+}
+.lm[data-scrolled="true"] .lm-mark {
+  left: 50%;
+  height: 2.3rem;
+  transform: translate(-50%, -50%);
+  filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.55));
+}
+.lm[data-scrolled="true"] .lm-text {
+  opacity: 0;
+  filter: blur(4px);
+  transform: translate(-1.8rem, -50%);
+}
+.hb {
+  position: absolute;
+  inset-inline: 0;
+  top: 1.5rem;
+  z-index: 20;
+  display: flex;
+  height: 2.75rem;
+  align-items: center;
+  justify-content: space-between;
+  padding-inline: clamp(1rem, 5vw, 5rem);
+  pointer-events: none;
+}
+.hb ul {
+  display: flex;
+  align-items: center;
+  gap: 1.5rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.hb img {
+  display: block;
+  width: auto;
+  height: clamp(1.7rem, 3.2vw, 3rem);
+  max-width: 9rem;
+  object-fit: contain;
+  opacity: 0.92;
+}
+@media (max-width: 520px) {
+  /* on a phone the logo is in the middle: the badges stay small on both sides of it */
+  .hb img {
+    height: 1.6rem;
+    max-width: 4.6rem;
+  }
+}
