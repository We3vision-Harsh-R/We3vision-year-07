+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The panda that walks along the services on the home page (panda-walker.tsx, used by hero-scene.tsx). It is drawn big enough to see its
+   face (96 px), so the gap between the boxes and the rail is a little taller: the panda stands on the rail below the boxes, never over
+   their names. It turns round smoothly; legs, body and head move only with transforms. */
+@media (min-width: 700px) {
+  .hub-stage {
+    --gap: clamp(108px, 14vh, 126px);
+  }
+}
+.hub-av::before {
+  bottom: -4px;
+  left: -34px;
+  width: 68px;
+  height: 12px;
+}
+.hub-av-body {
+  bottom: -4px;
+  left: -48px;
+  width: 96px;
+  height: 96px;
+  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
+}
+.hub-av-body .hub-sp {
+  transition: opacity 0.16s linear;
+}
+.pw {
+  overflow: visible;
+}
+.pw-breathe {
+  transform-box: fill-box;
+  transform-origin: 50% 100%;
+  animation: pw-breathe 3.2s ease-in-out infinite;
+}
+@keyframes pw-breathe {
+  50% {
+    transform: scaleY(1.022);
+  }
+}
+.pw-wave {
+  transform-box: fill-box;
+  transform-origin: 50% 12%;
+  animation: pw-wave 7s ease-in-out infinite;
+}
+@keyframes pw-wave {
+  0%,
+  72%,
+  100% {
+    transform: rotate(0);
+  }
+  76% {
+    transform: rotate(-150deg);
+  }
+  80% {
+    transform: rotate(-118deg);
+  }
+  84% {
+    transform: rotate(-150deg);
+  }
+  88% {
+    transform: rotate(-118deg);
+  }
+  93% {
+    transform: rotate(0);
+  }
+}
+.pw-leg {
+  transform-box: fill-box;
+  transform-origin: 50% 18%;
+  animation: pw-swing 0.34s ease-in-out infinite alternate paused;
+}
+.pw-leg.pw-b {
