+    }
+  }
+  .mp-seg {
+    fill: none;
+    stroke: none;
+  }
+  .mp-seg-on {
+    fill: none;
+    stroke: var(--a);
+    stroke-linecap: round;
+    stroke-width: 10;
+    filter: drop-shadow(0 0 10px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.7));
+  }
+  /* a round teleport pad: two rings and the number painted on the floor in front of it */
+  .mp-padf {
+    position: absolute;
+    width: 230px;
+    height: 230px;
+    border: 2px solid var(--a30);
+    border-radius: 50%;
+    background: radial-gradient(circle, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.13) 0, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.03) 68%, transparent 70%);
+    transform-style: preserve-3d;
+    transition:
+      border-color 0.6s,
+      background 0.6s,
+      box-shadow 0.6s;
+  }
+  .mp-padf::before {
+    content: "";
+    position: absolute;
+    inset: 30px;
+    border: 2px dashed hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.22);
+    border-radius: 50%;
+  }
+  .mp-padf[data-s="active"] {
+    border-color: var(--a);
+    background: radial-gradient(circle, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.32) 0, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.08) 68%, transparent 70%);
+    box-shadow: 0 0 80px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.45);
+  }
+  .mp-no {
+    position: absolute;
+    right: 0;
+    bottom: -84px;
+    left: 0;
+    color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.2);
+    font-size: 66px;
+    font-weight: 700;
+    letter-spacing: -0.05em;
+    text-align: center;
+    transition: color 0.6s;
+  }
+  .mp-padf[data-s="active"] .mp-no {
+    color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 86% / 0.9);
+  }
+  .mp-ring {
+    position: absolute;
+    inset: -14px;
+    border: 2px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82% / 0.7);
+    border-radius: 50%;
+    opacity: 0;
+  }
+  .mp-padf[data-s="active"] .mp-ring {
+    animation: mp-ring 2.2s ease-out infinite;
+  }
+  @keyframes mp-ring {
+    from {
+      opacity: 0.8;
+      transform: scale(0.96);
+    }
+    to {
+      opacity: 0;
+      transform: scale(1.4);
+    }
+  }
+  /* the hologram that stands up over the pad: the icon, the number and the name of the step */
+  .mp-holo {
+    position: absolute;
+    bottom: calc(100% - 26px);
+    left: 50%;
+    width: 290px;
+    padding: 18px 20px 20px;
+    border: 1px solid var(--a30);
+    border-radius: 14px;
+    background: linear-gradient(180deg, hsl(calc(var(--th) + 349) calc(50% * var(--ts)) 14% / 0.92), hsl(calc(var(--th) + 349) calc(50% * var(--ts)) 8% / 0.92));
+    opacity: 0;
+    text-align: center;
+    transform: translateX(-50%) rotateX(-58deg) scale(0.6);
+    transform-origin: 50% 100%;
+    transition:
+      opacity 0.5s,
+      transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
+      border-color 0.6s;
+  }
+  .mp-holo::after {
+    content: "";
+    position: absolute;
+    top: 100%;
+    left: 50%;
+    width: 2px;
+    height: 34px;
+    margin-left: -1px;
+    background: linear-gradient(180deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.8), transparent);
+  }
+  .mp-hico {
+    width: 52px;
+    height: 52px;
+    fill: none;
+    stroke: var(--a);
+    stroke-linecap: round;
+    stroke-linejoin: round;
+    stroke-width: 2.2;
+  }
