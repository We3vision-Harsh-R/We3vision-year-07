+/* ---------------------------------------------------------------------------------------------------------------------------------
+   How we build, on the 3D floor of the metaverse studio (components/site/metaverse/vr-process.tsx): round teleport pads on a winding
+   road, Rutvi walks it while the page scrolls, a hologram stands up at every pad. A plain list with a line down the side on a tablet
+   and a phone. */
+.mp {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --ad: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 12%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.88);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.16);
+  --a30: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.3);
+  --u: 1;
+  --p: calc(var(--u) * 1px);
+  position: relative;
+}
+.mp-sticky {
+  display: none;
+}
+.mp-listwrap {
+  max-width: 760px;
+  margin: 0 auto;
+  padding: 88px 16px 72px;
+}
+.mp-head {
+  text-align: center;
+}
+.mp-chip {
+  display: inline-block;
+  padding: 5px 16px;
+  border: 1px solid var(--hair);
+  border-radius: 999px;
+  color: var(--a);
+  font-size: 0.875rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+}
+.mp-head h2 {
+  margin: 14px 0 0;
+  color: #fff;
+  font-size: clamp(1.9rem, 6vw, 2.75rem);
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  line-height: 1.1;
+}
+.mp-head p {
+  max-width: 560px;
+  margin: 12px auto 0;
+  color: var(--soft);
+  font-size: 1rem;
+  line-height: 1.55;
+}
+/* the list with a line down the side */
+.mp-rail {
+  --prog: 0px;
+  position: relative;
+  margin-top: 34px;
+}
+.mp-rail::before,
+.mp-rail::after {
+  content: "";
+  position: absolute;
+  top: 30px;
+  left: 29px;
+  width: 2px;
+}
+.mp-rail::before {
+  bottom: 60px;
+  background: var(--hair);
+}
+.mp-rail::after {
+  height: var(--prog);
+  background: var(--a);
+}
+.mp-rail ol {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.mp-item {
+  position: relative;
+  padding: 0 0 34px 84px;
+}
+.mp-pad {
+  position: absolute;
+  top: 0;
+  left: 0;
+  display: grid;
+  width: 60px;
+  height: 60px;
+  place-items: center;
+  border: 1px solid var(--hair);
+  border-radius: 16px;
+  background: hsl(calc(var(--th) + 349) calc(40% * var(--ts)) 11%);
+  color: var(--soft);
+  transition:
+    border-color 0.3s,
+    color 0.3s,
+    background 0.3s;
+}
+.mp-item[data-on="true"] .mp-pad {
+  border-color: var(--a);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.14);
+  color: var(--a);
+}
+.mp-item[data-done="true"] .mp-pad {
+  color: var(--a);
+}
+.mp-ico {
+  width: 34px;
+  height: 34px;
+  fill: none;
+  stroke: currentColor;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 2.4;
+}
+.mp-ico .mp-fill,
+.mp-hico .mp-fill {
+  fill: currentColor;
+  stroke: none;
+}
+.mp-pad b {
+  position: absolute;
+  top: -10px;
+  right: -10px;
+  display: grid;
+  min-width: 28px;
+  height: 28px;
+  place-items: center;
+  border: 1px solid var(--hair);
+  border-radius: 14px;
+  background: hsl(calc(var(--th) + 347.58) calc(66% * var(--ts)) 7.4%);
+  color: #fff;
+  font-size: 0.875rem;
+  font-weight: 700;
+}
+.mp-item[data-done="true"] .mp-pad b,
+.mp-item[data-on="true"] .mp-pad b {
+  border-color: var(--a);
+  background: var(--a);
+  color: var(--ad);
+}
+.mp-item h3 {
+  margin: 0;
+  padding-top: 4px;
+  color: #fff;
+  font-size: 1.1875rem;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  line-height: 1.25;
+}
+.mp-item p {
+  margin: 8px 0 0;
+  color: var(--soft);
+  font-size: 1rem;
+  line-height: 1.55;
+}
+.mp-item ul,
+.mp-panel ul {
+  display: grid;
+  gap: 6px;
+  margin: 12px 0 0;
+  padding: 0;
+  list-style: none;
+}
+.mp-item li,
+.mp-panel li {
+  position: relative;
+  padding-left: 22px;
+  color: #fff;
+  font-size: 0.9375rem;
+  line-height: 1.4;
+}
+.mp-item li::before,
+.mp-panel li::before {
+  content: "";
+  position: absolute;
+  top: 0.32em;
+  left: 4px;
+  width: 6px;
+  height: 11px;
+  border: solid var(--a);
+  border-width: 0 2px 2px 0;
+  rotate: 45deg;
+}
+.mp-rutvi-list {
+  z-index: 2;
+}
+
+/* the 3D floor (a desktop that does not mind motion) */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .mp {
