+}
+.sk-chip:hover:not(:disabled) { transform: translateY(-1px); border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%); }
+.sk-chip[data-on="true"] {
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  color: hsl(calc(var(--th) + 347) calc(60% * var(--ts)) 8%);
