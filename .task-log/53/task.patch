+  box-shadow: 0 0 22px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.45);
+}
+/* the rest of the office goes out of focus: six layers, each one blurs more but reaches less far from the card */
+.vfo-blur {
+  position: absolute;
+  inset: 0;
+  z-index: 8;
+  visibility: hidden;
+  opacity: 0;
+  pointer-events: none;
+  transition:
+    opacity 0.4s ease-in,
+    visibility 0s 0.4s;
+}
+.vfo-of[data-open="true"] .vfo-blur {
+  visibility: visible;
+  opacity: 1;
+  pointer-events: auto;
+  transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.vfo-blur::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(circle at var(--bx, 50%) var(--by, 50%), rgba(6, 2, 12, 0.05) 0, rgba(6, 2, 12, 0.42) 75%);
+}
+.vfo-blur i {
+  --rr: calc(var(--br, 700px) * (1.32 - var(--k) * 0.17));
+  position: absolute;
+  inset: 0;
+  -webkit-backdrop-filter: blur(calc(var(--b) * 1px));
+  backdrop-filter: blur(calc(var(--b) * 1px));
+  -webkit-mask-image: radial-gradient(circle at var(--bx, 50%) var(--by, 50%), #000 calc(var(--rr) * 0.3), transparent var(--rr));
+  mask-image: radial-gradient(circle at var(--bx, 50%) var(--by, 50%), #000 calc(var(--rr) * 0.3), transparent var(--rr));
+}
+/* the card: what the team builds and which industries it is possible for */
+.vfo-pop {
+  position: absolute;
+  z-index: 12;
+  box-sizing: border-box;
+  width: min(max(340px, calc(var(--p) * 400)), calc(100% - 2 * (3.5% + 300px * var(--zs) + 22px)));
