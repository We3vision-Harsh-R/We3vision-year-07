+.ga-pit-3 { fill: hsl(calc(var(--th) + 14) calc(28% * var(--ts)) 8%); }
+.ga-coal { fill: hsl(calc(var(--th) + 350) calc(20% * var(--ts)) 6%); stroke: var(--a); stroke-opacity: 0.4; }
+.ga-ring { fill: none; stroke: var(--a); stroke-width: 1.6; transform-box: fill-box; transform-origin: center; animation: ga-blast 2.4s ease-out infinite; }
+.ga-ring-b { animation-delay: 1.2s; }
+@keyframes ga-blast { 0% { opacity: 0.9; transform: scale(1); } 100% { opacity: 0; transform: scale(5); } }
+.ga-rail { fill: none; stroke: hsl(calc(var(--th) + 350) calc(14% * var(--ts)) 40%); stroke-width: 6; }
+.ga-tie { fill: none; stroke: hsl(calc(var(--th) + 14) calc(30% * var(--ts)) 24%); stroke-dasharray: 2 7; stroke-width: 10; }
+.ga-wagon { animation: ga-wag 6s ease-in-out infinite alternate; }
+@keyframes ga-wag { to { transform: translateX(34px); } }
+.ga-drill { animation: ga-blink 1.6s ease-in-out infinite; }
+@media (prefers-reduced-motion: reduce) {
