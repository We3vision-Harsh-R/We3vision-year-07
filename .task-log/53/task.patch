+  box-shadow: 0 6px 30px hsl(calc(var(--th) + 40) 90% 70% / 0.55);
+}
+/* in front of everything: leaves very close to the camera, out of focus */
+.rc-fore {
+  bottom: -20px;
+  width: 210px;
+  height: 330px;
+  background: radial-gradient(ellipse at 50% 60%, hsl(calc(var(--th) + 222) calc(50% * var(--ts)) 30% / 0.9), hsl(calc(var(--th) + 222) calc(50% * var(--ts)) 12% / 0.7) 70%, transparent);
+  filter: blur(14px);
+  border-radius: 50%;
+}
+.rc-fore-l {
+  left: -4%;
+  transform: translate(calc(var(--px, 0) * -26px), calc(var(--py, 0) * -8px));
+}
+.rc-fore-r {
+  right: -4%;
+  transform: translate(calc(var(--px, 0) * -26px), calc(var(--py, 0) * -8px));
+}
+
+/* the face of the receptionist next to her lines */
+.rc-face {
+  flex: none;
+  display: block;
+  width: 46px;
+  height: 46px;
+  overflow: hidden;
+  border: 2px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.6);
+  border-radius: 50%;
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 354) calc(50% * var(--ts)) 30%), hsl(calc(var(--th) + 347) calc(50% * var(--ts)) 12%));
+  box-shadow: 0 0 18px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.35);
+}
+.rc-face .ra {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+/* ---- the character itself: the layers of reception-avatar.tsx ---- */
+.ra {
+  --ra-b1: hsl(calc(var(--th) + 352) calc(44% * var(--ts)) 34%);
+  --ra-b2: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 15%);
+  --ra-l1: hsl(calc(var(--th) + 354) calc(52% * var(--ts)) 48%);
+  --ra-l2: hsl(calc(var(--th) + 352) calc(50% * var(--ts)) 28%);
+  --ra-shine: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 82%);
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.ra-hair-back,
+.ra-hair {
+  fill: url(#ra-hair);
+}
+.ra-hair-line {
+  fill: none;
+  stroke: rgba(0, 0, 0, 0.35);
+  stroke-width: 2;
+  stroke-linecap: round;
+}
+.ra-hair-shine {
+  fill: url(#ra-hair-sh);
+  opacity: 0.7;
+}
+.ra-hair-hi {
+  fill: none;
+  stroke: var(--ra-shine);
+  stroke-width: 2.4;
+  stroke-linecap: round;
+  opacity: 0.35;
+}
+.ra-neck {
+  fill: url(#ra-neck);
+}
+.ra-chin-shadow {
+  fill: rgba(80, 36, 22, 0.28);
+  filter: blur(6px);
+}
+.ra-blazer {
+  fill: url(#ra-blazer);
+}
+.ra-blouse {
+  fill: #f1ebf6;
+}
+.ra-vneck {
+  fill: url(#ra-skin);
+}
+.ra-lapel {
+  fill: url(#ra-lapel);
+}
+.ra-lapel-r {
+  opacity: 0.92;
+}
+.ra-seam {
+  fill: none;
+  stroke: rgba(255, 255, 255, 0.22);
+  stroke-width: 2;
+  stroke-linecap: round;
+}
+.ra-badge {
+  fill: #fbf7fd;
+}
+.ra-badge-line {
+  fill: none;
+  stroke: hsl(calc(var(--th) + 347) calc(40% * var(--ts)) 30%);
+  stroke-width: 3;
+  stroke-linecap: round;
+}
+.ra-badge-dot {
+  fill: hsl(calc(var(--th) + 354) calc(90% * var(--ts)) 60%);
+}
+.ra-skin-d {
+  fill: #c98e68;
+}
+.ra-earring {
+  fill: hsl(var(--th) 0% 96%);
+  stroke: rgba(0, 0, 0, 0.2);
+}
+.ra-face {
+  fill: url(#ra-skin);
+}
+.ra-face-sh {
+  fill: rgba(120, 56, 36, 0.16);
+}
+.ra-brow {
+  fill: none;
+  stroke: #2a1820;
+  stroke-width: 5.4;
+  stroke-linecap: round;
+  transition: transform 0.4s;
+}
+.ra-sclera {
+  fill: #fbf7f4;
+}
+.ra-lid {
+  fill: #e0a982;
+  transform-box: fill-box;
+  transform-origin: 50% 0;
+  transform: scaleY(0);
+  animation: ra-blink 5.4s ease-in-out infinite;
+}
+.ra-eye[data-side="r"] .ra-lid {
+  animation-delay: 0s;
+}
+@keyframes ra-blink {
+  0%,
+  91%,
+  100% {
+    transform: scaleY(0);
+  }
+  94% {
+    transform: scaleY(1);
+  }
+  97% {
+    transform: scaleY(0);
+  }
+}
+.ra-lash {
+  fill: none;
+  stroke: #1b0f12;
+  stroke-width: 3.2;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.ra-lash-b {
+  fill: none;
+  stroke: rgba(60, 30, 20, 0.35);
+  stroke-width: 2;
+  stroke-linecap: round;
+}
+.ra-iris-g {
+  transform: translate(calc(var(--px, 0) * 6px), calc(var(--py, 0) * 4px));
+  transition: transform 0.25s ease-out;
+}
+.ra-nose {
+  fill: rgba(120, 56, 36, 0.14);
+}
+.ra-nose-hi {
+  fill: none;
+  stroke: rgba(255, 255, 255, 0.35);
+  stroke-width: 3;
+  stroke-linecap: round;
+}
+.ra-nostril {
+  fill: rgba(70, 30, 20, 0.45);
+}
+.ra-smile-fill {
+  fill: url(#ra-lip);
+  transition: opacity 0.12s;
+}
+.ra-lip-hi {
+  fill: none;
+  stroke: rgba(255, 255, 255, 0.4);
+  stroke-width: 2.4;
+  stroke-linecap: round;
+}
+.ra-open {
+  opacity: 0;
+  transform-box: fill-box;
+  transform-origin: 50% 0;
+  transform: scaleY(0.2);
+}
+.ra-open-bg {
+  fill: #4b1624;
+}
+.ra-teeth {
+  fill: #fff;
+}
+.ra-tongue {
+  fill: #c9566b;
+}
+.ra[data-talk="true"] .ra-smile-fill {
+  opacity: 0;
+}
+.ra[data-talk="true"] .ra-lip-hi {
+  opacity: 0;
+}
+.ra[data-talk="true"] .ra-open {
+  opacity: 1;
+  animation: ra-talk 0.34s ease-in-out infinite alternate;
+}
+@keyframes ra-talk {
+  0% {
+    transform: scale(0.9, 0.25);
+  }
+  40% {
+    transform: scale(1, 0.9);
+  }
+  70% {
+    transform: scale(0.94, 0.5);
+  }
+  100% {
+    transform: scale(1.02, 1);
+  }
+}
+.ra-band {
+  fill: none;
+  stroke: #17101f;
+  stroke-width: 9;
+  stroke-linecap: round;
+}
+.ra-cup {
+  fill: #1c1328;
+  stroke: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 60% / 0.5);
+  stroke-width: 1.6;
+}
+.ra-cup-hi {
+  fill: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.28);
+}
+.ra-boom {
+  fill: none;
+  stroke: #17101f;
+  stroke-width: 4.4;
+  stroke-linecap: round;
+}
+.ra-mic {
+  fill: #17101f;
+  stroke: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 60% / 0.6);
+  stroke-width: 1.4;
+}
+.ra-led {
+  fill: hsl(calc(var(--th) + 140) 90% 60%);
+  filter: drop-shadow(0 0 4px hsl(calc(var(--th) + 140) 90% 60%));
+}
+/* life: she breathes, the head follows the pointer (a little turn and a little move), she nods when a choice is made */
+.ra-body {
+  transform-origin: 240px 460px;
+  animation: ra-breathe 4.6s ease-in-out infinite;
+}
+@keyframes ra-breathe {
+  0%,
+  100% {
+    transform: translateY(0) scale(1);
+  }
+  50% {
+    transform: translateY(-3px) scale(1.004);
+  }
+}
+.ra-body[data-nod="true"] {
+  animation:
+    ra-breathe 4.6s ease-in-out infinite,
+    ra-nod 0.8s ease-in-out 1;
+}
+@keyframes ra-nod {
+  0%,
+  100% {
+    translate: 0 0;
+  }
+  35% {
+    translate: 0 9px;
+  }
+  65% {
+    translate: 0 -2px;
+  }
+}
+.ra-head {
+  transform-origin: 240px 300px;
+  transform: translate(calc(var(--px, 0) * 8px), calc(var(--py, 0) * 5px)) rotate(calc(var(--px, 0) * 2.6deg));
+  transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
+}
+/* the raised hand: it comes up from behind the counter, waves and goes down again */
+.ra-arm {
+  transform: translateY(260px);
+  transform-origin: 408px 372px;
+}
+.ra-arm[data-wave="true"] {
+  animation: ra-wave 3.2s cubic-bezier(0.3, 0.7, 0.3, 1) both;
+}
+@keyframes ra-wave {
+  0% {
+    transform: translateY(260px) rotate(0deg);
+  }
+  16% {
+    transform: translateY(0) rotate(0deg);
+  }
+  26% {
+    transform: translateY(0) rotate(14deg);
+  }
+  36% {
+    transform: translateY(0) rotate(-14deg);
+  }
+  46% {
+    transform: translateY(0) rotate(14deg);
+  }
+  56% {
+    transform: translateY(0) rotate(-14deg);
+  }
+  66% {
+    transform: translateY(0) rotate(10deg);
+  }
+  76% {
+    transform: translateY(0) rotate(0deg);
+  }
+  100% {
+    transform: translateY(260px) rotate(0deg);
+  }
+}
+.ra-sleeve {
+  fill: url(#ra-blazer);
+}
+.ra-cuff {
+  fill: #f1ebf6;
+}
+.ra-skin,
+.ra-finger {
+  fill: url(#ra-skin);
+  stroke: rgba(120, 56, 36, 0.35);
+  stroke-width: 1.2;
+}
+.ra-palm-sh {
+  fill: none;
+  stroke: rgba(120, 56, 36, 0.3);
+  stroke-width: 2.4;
+  stroke-linecap: round;
+}
+@media (prefers-reduced-motion: reduce) {
+  .ra-lid,
+  .ra-body,
+  .ra-open {
+    animation: none !important;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .rc-line,
+  .rc-opt,
+  .rc-go,
+  .rc-dots i {
+    animation: none;
+  }
+}
