+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The cartoon guide (components/site/avatar.tsx): a rigged vector figure. Colours follow the theme (--th, --ts) and the person (--tone).
+   The walk is one smooth cycle (0.9 s: two steps) that always runs; --walk (0..1, eased by a transition) says how much of it you
+   see, so a figure that stops comes to rest by itself, without a jump. */
+@property --walk {
+  syntax: "<number>";
+  inherits: true;
+  initial-value: 0;
+}
+.ch {
+  --h: calc(var(--th) + var(--tone, 352) - 352);
+  --c-shirt: hsl(calc(var(--h) - 22) calc(88% * var(--ts)) 72%);
+  --c-shirt-d: hsl(calc(var(--h) - 22) calc(66% * var(--ts)) 57%);
+  --c-shirt-l: hsl(calc(var(--h) - 22) calc(96% * var(--ts)) 85%);
+  --c-pants: hsl(calc(var(--h) - 28) calc(46% * var(--ts)) 15%);
+  --c-pants-d: hsl(calc(var(--h) - 28) calc(40% * var(--ts)) 10%);
+  --c-lan: hsl(calc(var(--h) - 20) calc(62% * var(--ts)) 34%);
+  --walk: 0;
+  display: block;
+  overflow: visible;
+  transition: --walk 0.45s ease;
+}
+.ch.ch-go {
+  --walk: 1;
+}
+.ch-skin { fill: #f4c3a2; }
+.ch-skin-d { fill: #dfa183; }
+.ch-hair { fill: #2a1826; }
+.ch-hair-hi { fill: none; stroke: hsl(calc(var(--th) + 4) calc(55% * var(--ts)) 46%); stroke-opacity: 0.7; stroke-width: 1.3; stroke-linecap: round; }
+.ch-hair-hi2 { fill: hsl(calc(var(--th) + 8) calc(46% * var(--ts)) 24%); }
+.ch-shirt, .ch-sleeve { fill: var(--c-shirt); }
+.ch-shirt-d, .ch-sleeve.ch-far { fill: var(--c-shirt-d); }
+.ch-cuff, .ch-collar { fill: var(--c-shirt-l); }
+.ch-pants { fill: var(--c-pants); }
+.ch-pants.ch-far { fill: var(--c-pants-d); }
+.ch-belt { fill: #15101d; }
+.ch-buckle { fill: #cfc9dc; }
+.ch-lan { fill: none; stroke: var(--c-lan); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
+.ch-badge { fill: #f4eeff; }
+.ch-badge-a { fill: var(--c-lan); }
+.ch-shoe { fill: #17121f; }
+.ch-shoe.ch-far { fill: #0e0a14; }
+.ch-shoe-hi { fill: none; stroke: #52456a; stroke-width: 1.3; stroke-linecap: round; }
+.ch-skin.ch-far, .ch-skin-d.ch-far { fill: #d19778; }
+.ch-shadow { fill: #000; fill-opacity: 0.32; }
+.ch-brow { fill: none; stroke: #2a1826; stroke-width: 2; stroke-linecap: round; }
+.ch-eye { fill: #1b0e1c; }
+.ch-eye-hi { fill: #fff; }
+.ch-cheek { fill: #f08d9a; fill-opacity: 0.5; }
+.ch-nose { fill: none; stroke: #c98a6e; stroke-width: 1; stroke-linecap: round; }
+.ch-mouth { fill: #8a2f45; }
+.ch-tongue { fill: #f2828f; }
+.ch-mouth-line { fill: none; stroke: #a64b57; stroke-width: 1.6; stroke-linecap: round; }
+
+/* ---- joints: where every part turns ---- */
+.ch-front .ch-body { transform-origin: 50px 147px; }
+.ch-front .ch-head { transform-origin: 50px 58px; }
+.ch-front .ch-arm-l { transform-origin: 31px 68px; }
+.ch-front .ch-arm-r { transform-origin: 69px 68px; }
+.ch-front .ch-arm-l .ch-fore { transform-origin: 30.7px 86px; }
+.ch-front .ch-arm-r .ch-fore { transform-origin: 69.3px 86px; }
+.ch-side .ch-body { transform-origin: 50px 147px; }
+.ch-side .ch-torso { transform-origin: 50px 104px; }
+.ch-top .ch-ar-l { transform-origin: 20px 70px; }
+.ch-top .ch-ar-r { transform-origin: 80px 70px; }
+.ch-top .ch-head { transform-origin: 50px 52px; }
+.ch-top .ch-body { transform-origin: 50px 80px; }
+
+/* ---- the front view: breathes, waves, cheers ---- */
+.ch-front .ch-body { animation: ch-breathe 2.8s ease-in-out infinite alternate; }
+.ch-front .ch-head { animation: ch-head-idle 3.4s ease-in-out infinite alternate; }
+@keyframes ch-breathe { to { transform: scaleY(1.016); } }
+@keyframes ch-head-idle { from { transform: rotate(-1.4deg); } to { transform: rotate(1.4deg) translateY(0.4px); } }
+.gl[data-in="true"] .gl-kid[data-m="wave"] .ch-arm-r { animation: ch-wave 0.75s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="wave"] .ch-arm-r .ch-fore { animation: ch-wave-fore 0.38s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="wave"] .ch-head { animation: ch-head-wave 1.5s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="up"] .ch-arm-l { animation: ch-cheer-l 0.62s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="up"] .ch-arm-r { animation: ch-cheer-r 0.62s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="up"] .ch-arm-l .ch-fore { animation: ch-cheer-fore-l 0.31s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="up"] .ch-arm-r .ch-fore { animation: ch-cheer-fore-r 0.31s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="up"] .ch-head { animation: ch-head-cheer 0.62s ease-in-out infinite alternate var(--d, 0s); }
+.gl[data-in="true"] .gl-kid[data-m="up"] .ch-leg { animation: ch-leg-hop 0.62s ease-in-out infinite alternate var(--d, 0s); }
+@keyframes ch-wave { from { transform: rotate(-132deg); } to { transform: rotate(-152deg); } }
+@keyframes ch-wave-fore { from { transform: rotate(-18deg); } to { transform: rotate(22deg); } }
+@keyframes ch-head-wave { from { transform: rotate(-2deg); } to { transform: rotate(4deg); } }
+@keyframes ch-cheer-l { from { transform: rotate(138deg); } to { transform: rotate(160deg); } }
+@keyframes ch-cheer-r { from { transform: rotate(-138deg); } to { transform: rotate(-160deg); } }
+@keyframes ch-cheer-fore-l { from { transform: rotate(10deg); } to { transform: rotate(-16deg); } }
+@keyframes ch-cheer-fore-r { from { transform: rotate(-10deg); } to { transform: rotate(16deg); } }
+@keyframes ch-head-cheer { from { transform: rotate(-3deg) translateY(0); } to { transform: rotate(3deg) translateY(-1px); } }
+@keyframes ch-leg-hop { from { transform: translateY(0); } to { transform: translateY(0.6px); } }
+
+/* ---- the side view: the walk ---- */
+.ch-side .ch-leg-f { animation: ch-thigh 0.9s ease-in-out infinite; }
+.ch-side .ch-leg-b { animation: ch-thigh 0.9s ease-in-out infinite -0.45s; }
+.ch-side .ch-leg-f .ch-shin { animation: ch-shin 0.9s ease-in-out infinite; }
+.ch-side .ch-leg-b .ch-shin { animation: ch-shin 0.9s ease-in-out infinite -0.45s; }
+.ch-side .ch-leg-f .ch-foot { animation: ch-foot 0.9s ease-in-out infinite; }
+.ch-side .ch-leg-b .ch-foot { animation: ch-foot 0.9s ease-in-out infinite -0.45s; }
+.ch-side .ch-arm-f { animation: ch-arm 0.9s ease-in-out infinite -0.45s; }
+.ch-side .ch-arm-b { animation: ch-arm 0.9s ease-in-out infinite; }
+.ch-side .ch-arm-f .ch-fore { animation: ch-fore 0.9s ease-in-out infinite -0.45s; }
+.ch-side .ch-arm-b .ch-fore { animation: ch-fore 0.9s ease-in-out infinite; }
+.ch-side .ch-body { animation: ch-bob 0.9s ease-in-out infinite; }
+.ch-side .ch-torso { animation: ch-lean 0.9s ease-in-out infinite; }
+.ch-side .ch-head { animation: ch-nod 0.9s ease-in-out infinite; }
+@keyframes ch-thigh {
+  0%, 50%, 100% { transform: rotate(0deg); }
+  25% { transform: rotate(calc(var(--walk) * -27deg)); }
+  75% { transform: rotate(calc(var(--walk) * 27deg)); }
+}
+@keyframes ch-shin {
+  0%, 100% { transform: rotate(calc(var(--walk) * 44deg)); }
+  25% { transform: rotate(calc(var(--walk) * 4deg)); }
+  50% { transform: rotate(calc(var(--walk) * 4deg)); }
+  75% { transform: rotate(calc(var(--walk) * 14deg)); }
+}
+@keyframes ch-foot {
+  0%, 100% { transform: rotate(calc(var(--walk) * 10deg)); }
+  25% { transform: rotate(calc(var(--walk) * -8deg)); }
+  50% { transform: rotate(calc(var(--walk) * 2deg)); }
+  75% { transform: rotate(calc(var(--walk) * 20deg)); }
+}
+@keyframes ch-arm {
+  0%, 50%, 100% { transform: rotate(0deg); }
+  25% { transform: rotate(calc(var(--walk) * -30deg)); }
+  75% { transform: rotate(calc(var(--walk) * 24deg)); }
+}
+@keyframes ch-fore {
+  0%, 50%, 100% { transform: rotate(calc(var(--walk) * -10deg)); }
+  25% { transform: rotate(calc(var(--walk) * -40deg)); }
+  75% { transform: rotate(calc(var(--walk) * -4deg)); }
+}
+@keyframes ch-bob {
+  0%, 50%, 100% { transform: translateY(0); }
+  25%, 75% { transform: translateY(calc(var(--walk) * -2.4px)); }
+}
+@keyframes ch-lean {
+  0%, 50%, 100% { transform: rotate(calc(var(--walk) * 3deg)); }
+  25% { transform: rotate(calc(var(--walk) * 4deg)); }
+  75% { transform: rotate(calc(var(--walk) * 2deg)); }
+}
+@keyframes ch-nod {
+  0%, 50%, 100% { transform: rotate(0deg); }
+  25% { transform: rotate(calc(var(--walk) * 1.6deg)) translateY(calc(var(--walk) * 0.6px)); }
+  75% { transform: rotate(calc(var(--walk) * -1.2deg)) translateY(calc(var(--walk) * 0.6px)); }
+}
+
+/* ---- the top view: feet and hands step, the body sways; seated they work ---- */
+.ch-top .ch-ft-l { animation: ch-ft 0.9s ease-in-out infinite; }
+.ch-top .ch-ft-r { animation: ch-ft 0.9s ease-in-out infinite -0.45s; }
+.ch-top .ch-ar-l { animation: ch-ar 0.9s ease-in-out infinite -0.45s; }
+.ch-top .ch-ar-r { animation: ch-ar 0.9s ease-in-out infinite; }
+.ch-top .ch-body { animation: ch-sway 0.9s ease-in-out infinite; }
+.ch-top .ch-head { animation: ch-top-head 0.9s ease-in-out infinite; }
+@keyframes ch-ft {
+  0%, 50%, 100% { transform: translateY(0) scale(1); }
+  25% { transform: translateY(calc(var(--walk) * -9px)) scale(calc(1 + var(--walk) * 0.1)); }
+  75% { transform: translateY(calc(var(--walk) * 9px)) scale(1); }
+}
+@keyframes ch-ar {
+  0%, 50%, 100% { transform: translateY(0); }
+  25% { transform: translateY(calc(var(--walk) * -7px)); }
+  75% { transform: translateY(calc(var(--walk) * 7px)); }
+}
+@keyframes ch-sway {
+  0%, 50%, 100% { transform: rotate(0deg) scale(1); }
+  25% { transform: rotate(calc(var(--walk) * 3deg)) scale(calc(1 + var(--walk) * 0.025)); }
+  75% { transform: rotate(calc(var(--walk) * -3deg)) scale(calc(1 + var(--walk) * 0.025)); }
+}
+@keyframes ch-top-head {
+  0%, 50%, 100% { transform: rotate(0deg); }
+  25% { transform: rotate(calc(var(--walk) * -2.5deg)); }
+  75% { transform: rotate(calc(var(--walk) * 2.5deg)); }
+}
+/* who walks (--walk goes to 1 and comes back to 0 with a transition) */
+.tl-p[data-pose="walk"] .ch-top,
+.of-walker[data-pose="walk"] .ch-top,
+.av[data-state="walk"] .ch-top {
+  --walk: 1;
+}
+/* seated (garden benches, the chairs of the founders): no feet, the hands are in front */
+.tl-p[data-pose="sit"] .ch-ft,
+.tl-seat .ch-ft {
+  display: none;
+}
+.tl-p[data-pose="sit"] .ch-ar,
+.tl-seat .ch-ar {
+  animation: none;
+  transform: translateY(9px);
+}
+.tl-p[data-pose="sit"] .ch-body {
+  animation: none;
+}
+/* a wave: the outer hand goes up and wags */
+.tl-p[data-wave="true"] .ch-ar-r {
+  animation: ch-wave-top 0.5s ease-in-out infinite alternate;
+  transform: none;
+}
+@keyframes ch-wave-top {
+  from { transform: rotate(-58deg) translateY(2px); }
+  to { transform: rotate(-84deg) translateY(2px); }
+}
+/* the people of the office: they sit still (no walk cycle), only what their role needs moves */
+.of-pp .ch-ft,
+.of-pp .ch-ar,
+.of-pp .ch-body {
+  animation: none;
+}
+.of-pp[data-role="type"] .ch-ar-l,
+.of-pp[data-role="type"] .ch-ar-r {
+  transform: translateY(12px);
+}
+.of-pp[data-role="type"] .ch-ar-l { animation: of-key-l 0.26s ease-in-out infinite alternate var(--d); }
+.of-pp[data-role="type"] .ch-ar-r { animation: of-key-r 0.32s ease-in-out infinite alternate var(--d); }
+.of-pp[data-role="meet"] .ch-ar,
+.of-pp[data-role="talk"] .ch-ar {
+  transform: translateY(8px);
+}
+.of-pp[data-role="talk"] .ch-ar-r { animation: of-gest-top 0.6s ease-in-out infinite alternate; }
+.of-pp[data-role="pres"] .ch-ar-r { animation: of-draw-top 0.9s ease-in-out infinite alternate; }
+.of-pp[data-role="pres"] .ch-ft-l { animation: ch-ft 1.8s ease-in-out infinite; --walk: 0.15; }
+.of-pp[data-role="pres"] .ch-ft-r { animation: ch-ft 1.8s ease-in-out infinite -0.9s; --walk: 0.15; }
+@keyframes of-key-l { from { transform: translateY(10px); } to { transform: translateY(15px); } }
+@keyframes of-key-r { from { transform: translateY(15px); } to { transform: translateY(10px); } }
+@keyframes of-gest-top { from { transform: translateY(6px) rotate(8deg); } to { transform: translateY(0) rotate(-40deg); } }
+@keyframes of-draw-top { from { transform: translateY(0) rotate(-30deg); } to { transform: translateY(6px) rotate(-70deg); } }
+@media (prefers-reduced-motion: reduce) {
+  .ch *,
+  .ch {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The interactive guide (components/site/guide-scene.tsx, guide-scenes.tsx, guide-kit.tsx): a card with a scene where the cartoon guide
+   works with the technology of the page. Eyes and head follow the pointer (--lx, --ly: -1..1, set by the script), the guide hops when
+   it is clicked, its mouth moves while it talks (data-talk) and every scene has something to play with. */
+.ch-sleeve-s { fill: none; stroke: var(--c-shirt); stroke-linecap: round; stroke-linejoin: round; }
+.ch-skin-s { fill: none; stroke: #f4c3a2; stroke-linecap: round; }
+.ch-cuff-s { fill: none; stroke: var(--c-shirt-l); stroke-linecap: round; }
+.ch-front[data-hide*="l"] .ch-arm-l,
+.ch-front[data-hide*="r"] .ch-arm-r { display: none; }
+.ch-visor { fill: #17101f; stroke: hsl(calc(var(--th) + 354) calc(80% * var(--ts)) 70% / 0.5); stroke-width: 1; }
+.ch-visor-lens { fill: hsl(calc(var(--th) + 350) calc(70% * var(--ts)) 24%); }
+.ch-visor-shine { fill: none; stroke: rgba(255, 255, 255, 0.45); stroke-width: 1.6; stroke-linecap: round; }
+.ch-visor-led { fill: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%); }
+.ch-strap { fill: none; stroke: #241a30; stroke-width: 3.6; stroke-linecap: round; }
+
+.gs {
+  --g-a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --g-b: hsl(calc(var(--th) + 344) calc(74% * var(--ts)) 58%);
+  --g-d: hsl(calc(var(--th) + 347) calc(58% * var(--ts)) 17%);
+  --g-e: hsl(calc(var(--th) + 347) calc(58% * var(--ts)) 10%);
+  --g-w: hsl(calc(var(--th) + 76) calc(70% * var(--ts)) 86%);
+  --lx: 0;
+  --ly: 0;
+  position: relative;
+  padding: 14px 14px 12px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 80% / 0.14);
+  border-radius: 28px;
+  background: linear-gradient(165deg, hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 13%), hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 7.5%));
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.08),
+    0 30px 80px -30px rgba(0, 0, 0, 0.75);
+}
+.gs-stage {
+  position: relative;
+  aspect-ratio: 480 / 300;
+  perspective: 900px;
+}
+.gs-svg {
+  display: block;
