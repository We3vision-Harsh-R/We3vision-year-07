+  }
+}
+
+
+/* Industries (home, the bird's-eye city): the far edge of the city plane was a hard line where the dark city met the sky of the page. The whole upper part
+   of the picture, up to a little under the horizon, now melts into the sky, so the city rises out of the same gradient as the section above. */
+@media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
+  .cm-bird .cm-scene {
+    -webkit-mask-image: linear-gradient(to bottom, transparent 0, transparent 20%, rgba(0, 0, 0, 0.35) 34%, #000 52%, #000 88%, transparent 100%);
+    mask-image: linear-gradient(to bottom, transparent 0, transparent 20%, rgba(0, 0, 0, 0.35) 34%, #000 52%, #000 88%, transparent 100%);
+  }
+}
+
+/* The office plan of the About timeline and of the Metaverse floor is a solid box: its top and bottom edge fade into the sky of the page, so that it
+   has no hard line against the section above and below. */
+.of {
+  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 5%, #000 95%, transparent 100%);
+  mask-image: linear-gradient(to bottom, transparent 0, #000 5%, #000 95%, transparent 100%);
+}
+
+@media (min-width: 901px) {
+  .ts-head::before {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    pointer-events: none;
+    -webkit-backdrop-filter: blur(14px);
+    backdrop-filter: blur(14px);
+    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 40%, #000 62%, transparent 100%);
+    mask-image: linear-gradient(to bottom, transparent 0, #000 40%, #000 62%, transparent 100%);
+  }
+}
+
+/* Tech space, tighter: a smaller heading block (below the logo, not lower than that), so the planets get the room and the whole section stays inside the
+   screen with the menu pill under it. */
+@media (min-width: 901px) {
+  .ts-head {
+    padding-top: 4.6rem;
+    padding-bottom: 0.4rem;
