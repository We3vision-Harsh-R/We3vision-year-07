+    const step = Math.sin(walkPhase);
+    legs[0].rotation.x = step * 0.7 * walkNow;
+    legs[1].rotation.x = -step * 0.7 * walkNow;
+    const bounce = Math.abs(Math.sin(walkPhase)) * 0.07 * walkNow;
+
+    // hop (a click)
+    let hopY = 0;
+    if (hopT < 1) {
