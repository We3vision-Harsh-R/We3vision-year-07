+  justify-content: center;
+  gap: 12px;
+  width: 220px;
+  height: 54px;
+  margin: 0 auto;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.55);
+  background: linear-gradient(180deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.2), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.06));
+  color: #fff;
+  font-size: 0.92rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
