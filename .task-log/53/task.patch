+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The sketch canvas (components/site/sketch-canvas.tsx): "draw a rough idea, our artist makes it shine". An ink brush paints behind the
+   cursor; the visitor can try a sample, send the sketch to the artist or save it. */
+.sk {
+  max-width: 1040px;
+  margin-inline: auto;
+  padding-inline: 1rem;
+}
+.sk-frame {
+  position: relative;
+  padding: 14px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.22);
+  border-radius: 30px;
+  background: linear-gradient(160deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.12), hsl(calc(var(--th) + 346) calc(60% * var(--ts)) 8% / 0.92) 60%);
+  box-shadow:
+    inset 0 1px 0 hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84% / 0.3),
+    0 40px 100px -40px rgba(0, 0, 0, 0.85),
+    0 0 90px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.12);
+}
+.sk-board {
+  position: relative;
+  aspect-ratio: 16 / 9;
+  overflow: hidden;
+  border: 1px dashed hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.3);
+  border-radius: 20px;
+  background-color: hsl(calc(var(--th) + 347) calc(60% * var(--ts)) 6%);
+  background-image:
+    radial-gradient(circle at 50% 42%, hsl(calc(var(--th) + 354) calc(90% * var(--ts)) 60% / 0.12), transparent 62%),
+    radial-gradient(circle, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.2) 1px, transparent 1.4px);
+  background-size: auto, 28px 28px;
+}
+.sk-canvas {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  width: 100%;
+  height: 100%;
+  touch-action: none;
+  cursor: crosshair;
+}
+.sk-tag {
+  position: absolute;
+  top: 14px;
+  left: 16px;
+  z-index: 1;
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84% / 0.7);
+  font-size: 0.875rem;
+  letter-spacing: 0.08em;
