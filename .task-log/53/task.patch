+  stroke: var(--a);
+  stroke-opacity: 0.6;
+  stroke-width: 1.8;
+}
+.vda-cube-t {
+  fill: var(--a);
+}
+.vda-cube-l {
+  fill: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.55);
