+/* ---- the world of the metaverse office: the office itself, the courtyard under it and Rutvi, who walks from the one to the other.
+   The whole world moves up when the view follows her out of the door (see update() in vr-floor.tsx). ---- */
+.vfo-world {
+  --u: 1;
+  --zs: 0.9;
+  --p: calc(var(--u) * 1px);
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --ad: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 12%);
+  --edge: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.3);
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  will-change: transform;
+}
+/* the office takes its size from the world */
+.vfo-of {
+  --u: inherit;
+  --zs: inherit;
+}
+.vfo-rutvi {
+  z-index: 7;
+}
+/* a door in the bottom wall, across from the one at the top */
+.vfo-wb1 {
+  right: auto;
+  width: calc(50% - var(--p) * 34);
+}
+.vfo-wb2 {
+  left: auto;
+  width: calc(50% - var(--p) * 34);
+}
+.vfo-door-b {
+  top: auto;
+  bottom: 0;
+  background: linear-gradient(0deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.3), transparent);
+}
+
+/* the courtyard outside, under the office */
+.vfo-out {
+  position: absolute;
+  top: 100%;
+  left: 0;
+  box-sizing: border-box;
+  width: 100%;
+  min-height: 100%;
+  padding: calc(var(--p) * 44) 4% calc(var(--p) * 56);
+  background:
+    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 110px 110px,
+    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 110px 110px,
+    radial-gradient(ellipse 60% 50% at 50% 38%, hsl(calc(var(--th) + 350) calc(42% * var(--ts)) 11%), transparent 70%),
+    hsl(calc(var(--th) + 347.58) calc(66% * var(--ts)) 5.2%);
+}
+/* the shadow of the wall on the ground */
+.vfo-out::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  right: 0;
+  left: 0;
+  height: calc(var(--p) * 70);
+  background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), transparent);
