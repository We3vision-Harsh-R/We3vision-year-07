+
+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The gradient of the hero screens (soft violet and pink-violet lights) as the background of the whole site (components/site/scroll-aurora.tsx): three big
+   lights in the fixed background that drift while the page is scrolled (--p = 0..1 down the page). One layer, no edges, only transforms change. */
+.au {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+  --p: 0;
+}
+.au-l {
+  position: absolute;
+  border-radius: 50%;
