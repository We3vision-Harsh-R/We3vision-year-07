+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The 3D office of the Metaverse page (components/site/metaverse/vr-office.tsx): a tall track with a sticky full-screen stage. */
+.vr {
+  position: relative;
+  height: calc(100svh * 7.4);
+  background: #060310;
+}
+.vr[data-state="still"],
+.vr[data-state="fallback"] {
+  height: 100svh;
+}
+.vr-stage {
+  position: sticky;
+  top: 0;
+  height: 100svh;
+  overflow: hidden;
+  background: radial-gradient(ellipse at 50% 60%, hsl(calc(var(--th) + 350) calc(60% * var(--ts)) 14%), #060310 70%);
+}
+.vr-canvas {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  opacity: 0;
+  transition: opacity 0.9s ease;
+}
+.vr[data-state="ready"] .vr-canvas,
+.vr[data-state="still"] .vr-canvas {
+  opacity: 1;
+}
+.vr-vignette {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: radial-gradient(ellipse at 50% 46%, transparent 52%, rgba(3, 1, 8, 0.6) 100%);
+}
+.vr-captions {
+  position: absolute;
+  inset: auto 0 17% 0;
+  height: 6rem;
+  pointer-events: none;
+}
+.vr-cap {
+  position: absolute;
+  inset: 0 0 auto 0;
+  max-width: 780px;
+  margin: 0 auto;
+  padding: 0 1.25rem;
+  color: #fff;
+  font-size: clamp(1.5rem, 3.2vw, 2.6rem);
+  font-weight: 600;
+  letter-spacing: -0.03em;
+  line-height: 1.15;
+  text-align: center;
+  text-shadow: 0 2px 24px rgba(5, 2, 12, 0.9), 0 0 6px rgba(5, 2, 12, 0.8);
+  opacity: 0;
+  will-change: opacity, transform;
+}
+.vr-hint {
+  position: absolute;
+  right: 0;
+  bottom: 118px;
+  left: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 86%);
