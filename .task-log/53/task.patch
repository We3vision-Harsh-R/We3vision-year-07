+/* Flow diagram (tools -> AI core -> actions): blueprint look with mono type, thin frame with corner plus signs. When it scrolls into view
+   (data-live="true", set by sections/flow.tsx) the boxes rise one by one, the wires draw themselves and light pulses start to flow
+   along them: data goes DOWN the top wires to the core, and the actions leave it through the bottom wires. */
+.flow {
+  --line: rgba(255, 255, 255, 0.16);
+  --glow: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%);
+  position: relative;
+  margin-top: 64px;
+  padding: 34px 30px 30px;
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.015));
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+}
+.flow-plus {
+  position: absolute;
+  width: 13px;
+  height: 13px;
+}
+.flow-plus::before,
+.flow-plus::after {
+  content: "";
+  position: absolute;
+  background: rgba(255, 255, 255, 0.85);
+}
+.flow-plus::before {
+  top: 0;
+  bottom: 0;
+  left: 50%;
+  width: 1px;
+  transform: translateX(-50%);
+}
+.flow-plus::after {
+  top: 50%;
+  right: 0;
+  left: 0;
+  height: 1px;
+  transform: translateY(-50%);
+}
+.flow-plus.tl,
+.flow-plus.c-tl {
+  top: -7px;
+  left: -7px;
+}
+.flow-plus.tr,
+.flow-plus.c-tr {
+  top: -7px;
+  right: -7px;
+}
+.flow-plus.bl,
+.flow-plus.c-bl {
+  bottom: -7px;
+  left: -7px;
+}
+.flow-plus.br,
+.flow-plus.c-br {
+  right: -7px;
+  bottom: -7px;
+}
+.flow-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 18px;
+  color: hsl(calc(var(--th) + 353.78) calc(22.69% * var(--ts)) calc(53.33% + 7% * max(0, cos((var(--th) - 240) * 2.4deg))));
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+.flow-head span:last-child {
