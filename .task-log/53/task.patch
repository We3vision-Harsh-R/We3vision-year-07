+}
+.sk-btn.btn-primary { color: hsl(calc(var(--th) + 347) calc(60% * var(--ts)) 6%); }
+.sk-btn:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.1); }
+.sk-btn:disabled { opacity: 0.45; cursor: default; }
+.sk-btn-ghost {
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.3);
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.06);
+  color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80%);
+}
+.sk-btn-ghost:hover:not(:disabled) { background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.16); }
+
+.sk-steps {
