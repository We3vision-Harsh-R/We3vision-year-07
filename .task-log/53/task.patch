+    transition: none;
+  }
+}
+
+/* the four lines shown while walking through the office (metaverse/vr-office.tsx): the neon of the sign on the wall, in a dark violet glass pill
+   with a glowing line under it, so that they belong to the scene */
+.vr-cap span {
+  position: relative;
+  display: inline-block;
+  max-width: 100%;
+  padding: 0.5em 1.15em 0.6em;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.4);
+  border-radius: 26px;
+  background: linear-gradient(180deg, hsl(calc(var(--th) + 349) calc(50% * var(--ts)) 13% / 0.62), hsl(calc(var(--th) + 346) calc(60% * var(--ts)) 7% / 0.7));
+  box-shadow:
+    0 0 34px -8px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.75),
+    inset 0 0 22px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.14);
+  color: #fff;
+  font-size: clamp(1.25rem, 2.6vw, 2.1rem);
+  letter-spacing: -0.02em;
+  text-shadow:
+    0 0 10px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.85),
+    0 0 28px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 62% / 0.7);
+}
+.vr-cap span::after {
+  content: "";
+  position: absolute;
+  right: 18%;
+  bottom: -1px;
+  left: 18%;
+  height: 2px;
+  border-radius: 2px;
+  background: linear-gradient(90deg, transparent, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 84%), transparent);
+  box-shadow: 0 0 12px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70%);
