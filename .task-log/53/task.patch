+}
+.mm[data-open="true"] .mm-r {
+  animation: mm-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) calc(0.16s + var(--i) * 0.05s) both;
+}
+/* (the words are visible by default: the rise-in only runs when the menu opens, so they do not vanish while it closes) */
+@keyframes mm-rise {
+  from {
+    opacity: 0;
+    transform: translateY(28px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+/* the AI chat at the very top: its window opens downwards over the pop-up */
+/* the chat lies above the rest of the pop-up (the lists and the text have their own layers because they rise in, so without this they would be painted over its window) */
+.mm-chat {
+  position: relative;
+  z-index: 20;
+}
+.mm-chat .pd {
+  --ph: min(42vh, 330px);
+  width: 100%;
+  max-width: none;
+}
+/* the soft blur of the hero chat, here under the chat window: what is behind the window (the text and the lists of the pop-up) goes out of focus, the
+   strongest right round the window and weaker the farther away; it grows downwards because the window opens downwards */
+.mm-chat .pd {
+  --ax: 46px;
+  --ay: 26px;
+  --fx: 60px;
+  --fyt: 30px;
+  --fyb: 130px;
+}
+.mm-chat .pd-blur {
+  width: calc(100% + 2 * (var(--ax) + var(--fx)));
+  top: calc(-1 * (var(--ay) + var(--fyt)));
+  bottom: calc(-1 * (var(--ph) + 16px + var(--ay) + var(--fyb)));
+  transform-origin: 50% calc(var(--ay) + var(--fyt) + 27px);
+}
+.mm-chat .pd-panel {
+  width: 100%; /* as wide as the bar (it is centred by the rule of the hero chat) */
+  background: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 9%);
+  top: calc(100% + 12px);
+  bottom: auto;
+  z-index: 6;
