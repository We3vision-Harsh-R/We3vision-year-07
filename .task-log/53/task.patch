+}
+/* the left part of the menu sits a little lower than the lists */
+.mm-intro {
+  padding-top: 1.2rem;
+}
+/* "Follow us" under the button: a label and round glass buttons with the icons (they fill with colour and lift on hover) */
+.mm-follow {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  margin-top: 1.7rem;
+  padding-top: 1.3rem;
+  border-top: 1px solid var(--hair);
+}
+.mm-follow-t {
+  margin: 0;
+  color: var(--soft);
+  font-size: 0.9375rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+.mm-follow ul {
+  display: flex;
+  gap: 0.6rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.mm-follow a {
+  display: grid;
+  width: 2.8rem;
+  height: 2.8rem;
+  place-items: center;
+  border: 1px solid var(--hair);
+  border-radius: 50%;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.07);
+  color: var(--soft);
+  transition: transform 0.4s cubic-bezier(0.22, 1.4, 0.36, 1), background 0.3s, border-color 0.3s, color 0.3s, box-shadow 0.4s;
+}
+.mm-follow a:hover,
+.mm-follow a:focus-visible {
+  border-color: transparent;
+  background: linear-gradient(135deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80%), hsl(calc(var(--th) + 330) calc(80% * var(--ts)) 62%));
+  box-shadow: 0 10px 26px -8px hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 70% / 0.8);
+  color: hsl(calc(var(--th) + 346) calc(80% * var(--ts)) 12%);
+  transform: translateY(-4px) scale(1.06);
+}
+/* the recognitions under the technology list: one glass card with the two logos and a line between them. It is as wide as the column (its left and right
+   edges are the ends of the title line above) and it stretches down to the bottom of the services list next to it, so the two columns end on one line. */
+.mm-cols-top .mm-col:nth-child(2) {
+  display: flex;
+  flex-direction: column;
+}
+.mm-rec {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  justify-content: center;
+  margin-top: 1.8rem;
