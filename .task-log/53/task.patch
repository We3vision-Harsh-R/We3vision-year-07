+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The team page (components/site/modern/team-office.tsx): the office of the About timeline (the .of-* rules above: floor, walls, corners,
+   tables, people) with the real people of the company in it. One screen, no camera. A card opens next to the person that is pointed at.
+   The same component is the preview of the admin panel (Team). */
+.to2-wrap {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.88);
