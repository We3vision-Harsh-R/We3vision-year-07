+  animation: gs-blink 5s ease-in-out infinite;
+}
+
+/* the stage of the guide in the scenes: a glowing round podium and a few sparkles around the head */
+.gs-podium-fill { fill: hsl(calc(var(--th) + 347) calc(58% * var(--ts)) 14%); }
+.gs-podium-ring {
+  fill: none;
+  stroke: var(--g-a);
+  stroke-width: 2;
+  filter: drop-shadow(0 0 6px var(--g-a));
+}
+.gs-podium-side { fill: hsl(calc(var(--th) + 347) calc(58% * var(--ts)) 9%); stroke: var(--g-a); stroke-opacity: 0.35; }
+.gs-podium-glow { fill: var(--g-a); fill-opacity: 0.18; }
+.gs-spark {
+  fill: none;
+  stroke: var(--g-a);
+  stroke-width: 2.4;
+  stroke-linecap: round;
+  filter: drop-shadow(0 0 4px var(--g-a));
+  animation: gs-spark 2.6s ease-in-out infinite;
+}
+@keyframes gs-spark {
+  0%, 100% { opacity: 0.25; }
+  50% { opacity: 1; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .gs-spark { animation: none; }
