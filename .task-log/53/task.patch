+    linear-gradient(180deg, hsl(calc(var(--th) + 347) calc(56% * var(--ts)) 8%), hsl(calc(var(--th) + 352) calc(54% * var(--ts)) 16%) 70%, hsl(calc(var(--th) + 354) calc(50% * var(--ts)) 12%));
