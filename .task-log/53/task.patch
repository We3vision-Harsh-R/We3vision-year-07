+}
+
+/* PANDA bar and window: the same border glow as the cards (components/site/ai-chat.tsx): a fine 1 px border, and when the pointer is near the edge a
+   coloured gradient border with a glow follows it. The inside of the window is clipped by its own box, so the glow outside the border can show. */
+.pd-bar,
+.pd-panel {
+  --card-bg: hsl(calc(var(--th) + 347) calc(45% * var(--ts)) 10%);
+}
+.pd-bar {
+  border-color: rgba(255, 255, 255, 0.14);
+}
+.pd[data-open="true"] .pd-bar {
