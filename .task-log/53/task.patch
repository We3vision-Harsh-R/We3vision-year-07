+/* ---------------------------------------------------------------------------------------------------------------------------------
+   "At a glance" of the home page, minimal (components/site/glance-min.tsx): figures on thin lines. */
+.gm {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.86);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.16);
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+.gm-row {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 56px 32px;
+  margin: 72px 0 0;
+  padding: 0;
+  list-style: none;
+}
+@media (min-width: 900px) {
+  .gm-row {
+    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
+    gap: 0 40px;
+  }
+}
+.gm-item {
+  position: relative;
+  display: grid;
+  gap: 10px;
+  padding-top: 22px;
+}
+/* the thin line: it is there, and an accent line draws over it from the left */
+.gm-item::before,
+.gm-item::after {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 1px;
+}
+.gm-item::before {
+  background: var(--hair);
+}
+.gm-item::after {
+  background: linear-gradient(90deg, var(--a), transparent);
+  transform-origin: 0 50%;
+  transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
+  transition-delay: calc(var(--i) * 140ms);
+}
+.gm-idx {
+  color: var(--a);
+  font-size: 0.875rem;
+  font-weight: 600;
+  letter-spacing: 0.16em;
+}
+.gm-num {
+  display: block;
+  background: linear-gradient(180deg, #fff 20%, color-mix(in srgb, #fff 40%, var(--a)));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  font-size: clamp(2.8rem, 6.4vw, 5rem);
+  font-variant-numeric: tabular-nums;
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  line-height: 1.05;
+  white-space: nowrap;
+}
+.gm-label {
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.45;
+}
+/* before the row is in view: the lines are not drawn yet and the words are down; then they come in one after the other */
+.gm-row[data-gm="wait"] .gm-item::after {
+  transform: scaleX(0);
+}
+.gm-row[data-gm="wait"] .gm-idx,
+.gm-row[data-gm="wait"] .gm-num,
+.gm-row[data-gm="wait"] .gm-label {
+  opacity: 0;
+  transform: translateY(16px);
+}
+.gm-row[data-gm="in"] .gm-idx,
+.gm-row[data-gm="in"] .gm-num,
+.gm-row[data-gm="in"] .gm-label {
+  opacity: 1;
+  transform: none;
+  transition:
+    opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
+    transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
+  transition-delay: calc(var(--i) * 140ms + 120ms);
+}
+.gm-row[data-gm="in"] .gm-label {
