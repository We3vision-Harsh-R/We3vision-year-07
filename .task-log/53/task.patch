+    gap: 88px;
+  }
+  .tm-head {
+    position: sticky;
+    top: 120px;
+    align-self: start;
+  }
+}
+.tm-h2 {
+  font-size: clamp(2.4rem, 4.4vw, 3.6rem);
+  line-height: 1.08;
+}
+.tm-intro {
