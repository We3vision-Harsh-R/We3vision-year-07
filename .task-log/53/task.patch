+/* ---------------------------------------------------------------------------------------------------------------------------------
+   The redesigned common sections of the service pages ("modern" skin): process (modern/process-rail.tsx), why us (why-bento.tsx),
+   FAQ (faq-split.tsx), related services (related-links.tsx). */
+.md {
+  --a: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76%);
+  --ad: hsl(calc(var(--th) + 346) calc(64% * var(--ts)) 12%);
+  --soft: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 92% / 0.86);
+  --hair: hsl(calc(var(--th) + 354) calc(60% * var(--ts)) 85% / 0.14);
+  --card: hsl(calc(var(--th) + 349) calc(46% * var(--ts)) 11% / 0.7);
+}
+.md-chip {
+  display: inline-flex;
+  padding: 5px 16px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.3);
+  border-radius: 999px;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.08);
+  color: var(--a);
+  font-size: 0.875rem;
+  font-weight: 600;
+}
+.md-h2 {
+  margin: 18px 0 0;
+  padding-bottom: 4px;
+  font-size: clamp(2rem, 4.2vw, 3.4rem);
+  font-weight: 600;
+  letter-spacing: -0.04em;
+  line-height: 1.08;
+  white-space: pre-line;
+}
+.md-intro {
+  max-width: 30rem;
+  margin: 18px 0 0;
+  color: var(--soft);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+}
+
+/* ---- process: a counting column and steps on a drawn line ---- */
+.md-pr {
+  display: grid;
+  gap: 36px;
+}
+@media (min-width: 1024px) {
+  .md-pr {
+    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
+    gap: 72px;
+  }
+  .md-pr-side {
+    position: sticky;
+    top: 110px;
+    align-self: start;
+  }
+}
+.md-pr-count {
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  margin-top: 44px;
+  line-height: 1;
+}
+.md-pr-count b {
+  background: linear-gradient(180deg, #fff 10%, var(--a));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  font-size: clamp(4.5rem, 9vw, 7.5rem);
+  font-weight: 700;
+  letter-spacing: -0.06em;
