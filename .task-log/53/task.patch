diff --git a/b/src/app/globals.css b/b/src/app/globals.css
new file mode 100644
index 0000000..a623972
--- /dev/null
+++ b/b/src/app/globals.css
@@ -0,0 +1,23833 @@
+@import "tailwindcss";
+
+@theme inline {
+  --font-sans: var(--font-poppins), ui-sans-serif, system-ui, sans-serif;
+  --font-display: var(--font-poppins), ui-sans-serif, system-ui, sans-serif;
+}
+
+@theme {
+  /* Admin panel accents */
+  --color-ink: #0a0a15;
+  --color-brand: #7c5cff;
+  --color-brand-2: #22d3ee;
+  --color-brand-3: #f472b6;
+
+  /* Public website: dark violet theme */
+  --color-void: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9%);
+  --color-violet: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%);
+  --color-dusk: hsl(calc(var(--th) + 351.38) calc(40.21% * var(--ts)) 19.02%);
+  /* (the muted text colour gets a little lighter on blue themes, where the same lightness looks darker: keeps contrast above 4.5) */
+  --color-orchid: hsl(calc(var(--th) + 353.78) calc(22.69% * var(--ts)) calc(53.33% + 7% * max(0, cos((var(--th) - 240) * 2.4deg))));
+
+  --animate-rise: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
+  @keyframes rise {
+    from {
+      opacity: 0;
+      transform: translateY(26px);
+      filter: blur(12px);
+    }
+    to {
+      opacity: 1;
+      transform: none;
+      filter: blur(0);
+    }
+  }
+
+  --animate-fade-in: fade-in 0.45s ease both;
+  @keyframes fade-in {
+    from {
+      opacity: 0;
+      transform: translateY(8px);
+    }
+    to {
+      opacity: 1;
+      transform: none;
+    }
+  }
+
+  --animate-bob: bob 2.2s ease-in-out infinite;
+  @keyframes bob {
+    0%,
+    100% {
+      transform: translateY(-2px);
+      opacity: 0.55;
+    }
+    50% {
+      transform: translateY(6px);
+      opacity: 1;
+    }
+  }
+
+  --animate-drift: drift 28s ease-in-out infinite alternate;
+  @keyframes drift {
+    from {
+      transform: translate3d(-1%, -0.6%, 0) scale(1.01);
+    }
+    to {
+      transform: translate3d(1%, 0.6%, 0) scale(1.05);
+    }
+  }
+
+  --animate-glow: glow 7s ease-in-out infinite alternate;
+  @keyframes glow {
+    from {
+      opacity: 0.55;
+    }
+    to {
+      opacity: 1;
+    }
+  }
+
+  --animate-twinkle: twinkle 6s ease-in-out infinite alternate;
+  @keyframes twinkle {
+    from {
+      opacity: 0.55;
+    }
+    to {
+      opacity: 1;
+    }
+  }
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  background: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 4.9%);
+  color: #fff;
+  font-family: var(--font-sans);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+
+section[id] {
+  scroll-margin-top: 2rem;
+}
+
+/* Admin panel helpers */
+.text-gradient {
+  background-image: linear-gradient(90deg, var(--color-brand), var(--color-brand-2) 60%, var(--color-brand-3));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.bg-brand-gradient {
+  background-image: linear-gradient(135deg, var(--color-brand), var(--color-brand-2));
+}
+
+/* ---- Public site theme ---- */
+
+/* Headings: a little softer at the top, bright violet at the bottom (the top line must stay easy to read: it is never darker than 62% lightness) */
+.text-vfade {
+  background-image: linear-gradient(0deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47%) 0%, hsl(calc(var(--th) + 352) calc(58% * var(--ts)) 62%) 100%);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+/* Hero title: the opposite way round */
+.text-hero {
+  background-image: linear-gradient(180deg, hsl(calc(var(--th) + 354) calc(58% * var(--ts)) 62%) 0%, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 78%) 100%);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+.card-glass {
+  background-image: linear-gradient(180deg, hsl(calc(var(--th) + 346.97) calc(58.49% * var(--ts)) 10.39%) 0%, hsl(calc(var(--th) + 347.43) calc(61.76% * var(--ts)) 13.33%) 100%);
+  box-shadow: inset 0 1px 0 hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.12);
+}
+
+.btn-primary {
+  background-image: linear-gradient(180deg, hsl(calc(var(--th) + 353.6) calc(100% * var(--ts)) 85.29%) 0%, hsl(calc(var(--th) + 348.46) calc(72.62% * var(--ts)) 67.06%) 100%);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.45),
+    0 6px 24px hsl(calc(var(--th) + 348.46) calc(72.62% * var(--ts)) 67.06% / 0.25);
+}
+
+/* Blueprint grid inside art tiles */
+.grid-tile {
+  background-image:
+    linear-gradient(hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.1) 1px, transparent 1px), linear-gradient(90deg, hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.1) 1px, transparent 1px);
+  background-size: 28px 28px;
+  background-position: center;
+}
+
+/* Scroll reveal: elements are only hidden by JS (see components/site/reveal.tsx), so the page is fully visible without JS. */
+[data-reveal] {
+  transition:
+    opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
+    transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
+  transition-delay: var(--reveal-delay, 0ms);
+}
+[data-reveal="hidden"] {
+  opacity: 0;
+  transform: translate3d(0, 28px, 0);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-reveal] {
+    transition: none;
+  }
+  [data-reveal="hidden"] {
+    opacity: 1;
+    transform: none;
+  }
+  .animate-rise,
+  .animate-fade-in,
+  .animate-bob,
+  .animate-drift,
+  .animate-glow,
+  .animate-twinkle {
+    animation: none;
+  }
+}
+
+/* Custom cursor (components/site/custom-cursor.tsx): the class is only added on devices with a mouse. */
+html.has-custom-cursor,
+html.has-custom-cursor * {
+  cursor: none !important;
+}
+
+/* Hero services hub (scroll + hover driven). --p = scroll progress 0..1 of the pinned hero, --i = box number, --k = sub-service number.
+   Timeline of p: the ball + 7 + texts blast apart (until ~0.25, particle-sphere)  ->  the seven boxes drop in one after another
+   at the top 0.38-0.82  ->  after that everything is hover: the open service blurs all other boxes, a line runs down from its box
+   to a rail and the sub-services (with a short description) appear below the rail. The hero is 300vh long. */
+/* THE THEME: every colour of the public site is written as hsl(hue-offset, saturation, lightness) around two numbers set on <html>:
+   --th = the hue of the theme (284 = the original violet) and --ts = a saturation factor (1 = the original). The visitor's colour
+   picker (components/site/theme-picker.tsx) changes only these two, so the whole site changes colour together: lightness is never
+   touched, which keeps text readable on every theme. Registered as numbers so the change is a smooth animation. */
+@property --th {
+  syntax: "<number>";
+  inherits: true;
+  initial-value: 284;
+}
+@property --ts {
+  syntax: "<number>";
+  inherits: true;
+  initial-value: 1;
+}
+/* the colour animates only after the page has loaded (class added by ThemeProvider), so a returning visitor never sees a fade from violet */
+html.theme-anim {
+  transition:
+    --th 0.9s ease,
+    --ts 0.9s ease;
+}
+@property --ac {
+  syntax: "<color>";
+  inherits: true;
+  initial-value: #d387ff;
+}
+
+.hub {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  z-index: 10;
+  width: min(1180px, calc(100% - 32px));
+  margin: 0 auto;
+  padding-top: clamp(84px, 11vh, 104px); /* the logo tile sits above the row, with some air */
+}
+.hub-row {
+  display: flex;
+  gap: 8px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.hub-item {
+  flex: 1 1 0;
+  min-width: 0;
+  --a: clamp(0, calc((var(--p, 0) - 0.4 - var(--i, 0) * 0.05) / 0.12), 1); /* one box after the other, slowly dropping in from the top while the dots at the sides fade away */
+  opacity: var(--a);
+  transform: translate3d(0, calc((1 - var(--a)) * -28px), 0) scale(calc(0.94 + 0.06 * var(--a)));
+  filter: blur(calc((1 - var(--a)) * 8px));
+}
+.hub-box {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  height: 54px;
+  padding: 0 10px;
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  border-radius: 14px;
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.08));
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 10px 30px hsl(calc(var(--th) + 342.67) calc(81.82% * var(--ts)) 17.25% / 0.4);
+  backdrop-filter: blur(18px) saturate(1.5);
+  color: hsl(calc(var(--th) + 352.99) calc(100% * var(--ts)) 85.69%);
+  font-family: inherit;
+  font-weight: 600;
+  font-size: clamp(0.68rem, 0.95vw, 0.8rem);
+  line-height: 1.12;
+  letter-spacing: -0.01em;
+  text-align: left;
+  cursor: pointer;
+  transition: transform 0.3s, filter 0.35s, opacity 0.35s, border-color 0.3s, box-shadow 0.3s, background 0.3s, color 0.3s;
+}
+.hub-ico {
+  display: grid;
+  flex: none;
+  place-items: center;
+  width: 28px;
+  height: 28px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76.47% / 0.22);
+  border-radius: 9px;
+  background: linear-gradient(180deg, hsl(calc(var(--th) + 347.91) calc(58.02% * var(--ts)) 15.88%), hsl(calc(var(--th) + 346.97) calc(58.49% * var(--ts)) 10.39%));
+  color: var(--ac);
+}
+.hub-name {
+  min-width: 0;
+  white-space: pre-line;
+}
+.hub-item[data-on="true"] .hub-box {
+  border-color: color-mix(in srgb, var(--ac) 75%, transparent);
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), color-mix(in srgb, var(--ac) 24%, transparent));
+  box-shadow:
+    0 0 0 1px color-mix(in srgb, var(--ac) 40%, transparent),
+    0 12px 44px color-mix(in srgb, var(--ac) 38%, transparent);
+  color: #fff;
+  transform: translateY(-2px);
+}
+/* while a service is open the other boxes stay sharp and readable (they are not blurred any more): only the open one is brighter and lifted, and the
+   guide below walks to it. */
+.hub[data-active="true"] .hub-item[data-on="false"] .hub-box {
+  opacity: 0.84;
+}
+
+.hub-stage {
+  --gap: clamp(44px, 8vh, 78px);
+  position: relative;
+  display: grid;
+  margin-top: var(--gap);
+  transition: --ac 0.45s;
+}
+.hub-stage > .hub-panel {
+  grid-area: 1 / 1;
+}
+/* the rail under the boxes: the ground the guide walks on; it glows around the guide (--ax is its position, set by the script) */
+.hub-rail {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.17) 6%, rgba(255, 255, 255, 0.17) 94%, transparent);
+  /* once all the boxes are in, the rail and every line of the first service come down together out of a blur */
+  opacity: 0;
+  transform: translateY(-30px);
+  filter: blur(6px);
+  transition:
+    opacity 0.8s ease,
