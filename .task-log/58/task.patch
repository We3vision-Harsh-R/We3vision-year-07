+.cj-none {
+  margin: 12px 0 0;
+  color: var(--soft);
+  font-size: 1rem;
+}
+
+/* the location: the field with the city in it */
+.cj-loc-block {
+  max-width: 820px;
+}
+.cj-picked {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  min-height: 58px;
+  padding: 0 18px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.5);
+  border-radius: 14px;
+  background: var(--fill);
+  animation: cj-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+.cj-pin {
+  position: relative;
+  flex: none;
+  width: 16px;
+  height: 16px;
+  border-radius: 50% 50% 50% 0;
+  background: var(--a);
+  transform: rotate(-45deg);
+}
+.cj-pin::after {
+  content: "";
+  position: absolute;
+  inset: 5px;
+  border-radius: 50%;
+  background: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 6%);
+}
+.cj-picked b {
+  flex: 1;
+  min-width: 0;
+  color: #fff;
+  font-size: 1.25rem;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+.cj-picked button {
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--a);
+  font: inherit;
+  font-size: 0.9375rem;
+  text-decoration: underline;
+  text-underline-offset: 4px;
+  cursor: pointer;
+}
+
+/* the questions of the booking: two columns, nothing else */
+.cj-form {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 20px 30px;
+  max-width: 820px;
+  margin-top: 22px;
+  animation: cj-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+.cj-cell {
+  display: grid;
+  gap: 10px;
+  align-content: start;
+  min-width: 0;
+}
+.cj-lab {
+  color: #fff;
+  font-size: 1.0625rem;
+  font-weight: 600;
+  line-height: 1.3;
+}
+.cj-lab small {
+  display: block;
+  margin-top: 3px;
+  color: var(--soft);
+  font-size: 0.875rem;
+  font-weight: 400;
+  opacity: 0.82;
+}
+.cj-form .cj-in {
+  min-height: 54px;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.26);
+  font-size: 1.0625rem;
+}
+.cj-form .cj-in:focus {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.7);
+}
+.cj-act {
+  display: grid;
+  grid-column: 1 / -1;
+  gap: 12px;
+}
+.cj-form .cj-book {
+  min-height: 58px;
+  font-size: 1.1875rem;
+  letter-spacing: 0.01em;
+}
+
+/* the lists, the calendar and the call slots that open under a field */
+.cj-dd {
+  position: relative;
+}
+.cj-dd-btn {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding-right: 46px;
+  text-align: left;
+  cursor: pointer;
+}
+.cj-dd-btn span {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.cj-dd-btn[data-empty="true"] span {
+  color: hsl(calc(var(--th) + 352) calc(14% * var(--ts)) 92% / 0.5);
+}
+.cj-dd-btn::after {
+  content: "";
+  position: absolute;
+  top: calc(50% - 7px);
+  right: 19px;
+  width: 8px;
+  height: 8px;
+  border-right: 2px solid var(--a);
+  border-bottom: 2px solid var(--a);
+  transform: rotate(45deg);
+  transition:
+    transform 0.25s,
+    top 0.25s;
+}
+.cj-dd[data-open="true"] .cj-dd-btn::after {
+  top: calc(50% - 2px);
+  transform: rotate(-135deg);
+}
+.cj-dd[data-open="true"] .cj-in {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.7);
+}
+.cj-dd-list {
+  position: absolute;
+  top: calc(100% + 8px);
+  left: 0;
+  z-index: 40;
+  min-width: 100%;
+  max-height: 340px;
+  margin: 0;
+  padding: 8px;
+  overflow: auto;
+  scrollbar-width: thin;
+  scrollbar-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.45) transparent;
+  list-style: none;
+  border: 1px solid hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.3);
+  border-radius: 16px;
+  background: hsl(calc(var(--th) + 347) calc(44% * var(--ts)) 8% / 0.98);
+  box-shadow:
+    inset 0 1px 0 hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 80% / 0.12),
+    0 26px 60px -22px rgba(0, 0, 0, 0.85);
+  animation: cj-pop 0.22s ease both;
+}
+.cj-dd-list [role="option"] {
+  display: block;
+  width: 100%;
+  padding: 11px 14px;
+  border: 0;
+  border-radius: 10px;
+  background: none;
+  color: #fff;
+  font: inherit;
+  font-size: 1rem;
+  text-align: left;
+  cursor: pointer;
+}
+.cj-dd-list [role="option"]:hover,
+.cj-dd-list [role="option"][data-hi="true"] {
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.16);
+}
+.cj-dd-list [role="option"][data-on="true"] {
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.26);
+  font-weight: 600;
+}
+.cj-dd-group {
+  display: block;
+  padding: 10px 14px 4px;
+  color: var(--a);
+  font-size: 0.875rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
