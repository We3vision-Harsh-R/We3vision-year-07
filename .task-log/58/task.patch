+}
+.cj-call i::before {
+  content: "";
+  position: absolute;
+  left: 50%;
+  top: 5px;
+  width: 2px;
+  height: 9px;
+  background: var(--a);
+  transform: translateX(-50%);
+}
+.cj-call i::after {
+  content: "";
+  position: absolute;
+  left: 50%;
+  top: 13px;
+  width: 7px;
+  height: 2px;
+  background: var(--a);
+}
+
+/* the box for the resume */
