+}
+.cj-cal {
+  width: 328px;
+  padding: 14px;
+}
+.cj-cal-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 10px;
+  color: #fff;
+  font-size: 1.0625rem;
+}
+.cj-cal-head button {
+  width: 36px;
+  height: 36px;
+  border: 0;
+  border-radius: 50%;
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.12);
+  color: var(--a);
+  font-size: 1.25rem;
+  line-height: 1;
+  cursor: pointer;
+}
+.cj-cal-head button:disabled {
+  opacity: 0.3;
+  cursor: default;
+}
+.cj-cal-grid {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: 4px;
+}
+.cj-cal-w {
+  padding: 4px 0 8px;
+  color: var(--soft);
+  font-size: 0.875rem;
+  text-align: center;
+  opacity: 0.8;
+}
+.cj-cal-grid button {
+  height: 40px;
+  border: 1px solid transparent;
+  border-radius: 12px;
+  background: none;
+  color: #fff;
+  font: inherit;
+  font-size: 1rem;
+  cursor: pointer;
+  transition: background 0.15s;
+}
+.cj-cal-grid button:hover:not(:disabled) {
+  background: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.18);
+}
+.cj-cal-grid button:disabled {
+  opacity: 0.28;
+  cursor: default;
+}
+.cj-cal-grid button[data-today="true"] {
+  border-color: hsl(calc(var(--th) + 354) calc(100% * var(--ts)) 76% / 0.5);
+}
+.cj-cal-grid button[data-on="true"] {
+  background: var(--a);
+  color: hsl(calc(var(--th) + 347.58) calc(76% * var(--ts)) 6%);
