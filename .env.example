# Copy to .env for local work. On Hostinger, add the same names in hPanel -> Node.js app -> Environment variables.
# NEVER commit the real .env file.

# --- Database (used now: Prisma + pg) ---
# Runtime: transaction pooler, port 6543 (IPv4). Used by the website.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler, port 5432. Used only for migrations (npm run db:deploy) and the admin seed.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Website ---
SESSION_SECRET=   # random 32+ chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Supabase API (for the future: Supabase Auth / login / storage). Not used by the code yet. ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase publishable key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase publishable key>
# SERVER ONLY. Never put this in a NEXT_PUBLIC_ variable and never send it to the browser.
SUPABASE_SECRET_KEY=<supabase secret key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- First admin login (only read by `npm run db:seed`, which you run on your own PC) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Search engines (autopilot: tells Bing and Google when a page goes live; every value is optional) ---
# IndexNow key: any 8-64 letters/numbers you choose. The key file is served at /indexnow-key.txt
INDEXNOW_KEY=
# Google Search Console API: path to the service-account JSON file (or the JSON itself). Add the service account e-mail as an OWNER of the property.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The property as written in Search Console, e.g. sc-domain:we3vision.com or https://www.we3vision.com/
GSC_SITE_URL=

# --- Alerts on WhatsApp (Admin > Alerts shows every alert; every value is optional) ---
# Your WhatsApp number with the country code, digits only (e.g. 91XXXXXXXXXX)
ALERT_WHATSAPP_TO=
# Way 1 (free, your own number): the key CallMeBot sends you, see https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_APIKEY=
# Way 2 (Meta WhatsApp Cloud API): a permanent token and the phone number id of your WhatsApp Business app
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
# Way 3: any webhook (Make, Zapier, n8n ...) that receives POST { "text": "..." }
ALERT_WEBHOOK_URL=
# "off" stops the WhatsApp for every new contact message / job application / admin sign-in
ALERT_LEADS=
ALERT_APPLICATIONS=
ALERT_LOGINS=
