# Copy to .env for local work. On Hostinger, add the same names in hPanel -> Node.js app -> Environment variables.
# NEVER commit the real .env file.

# Supabase -> Project Settings -> Database -> Connection string
# Runtime (pooler, port 6543). Used by the website.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432). Used only for migrations and the admin seed script.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Random string, 32+ characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Public address of the website (used for SEO: sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Only for `npm run db:seed` (creates the first admin login). Password: 12+ characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
